<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>ShareWithSalesDirectorForApproval</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share with Sales Director for Approval</label>
        <sharedTo>
            <role>Sales_Director</role>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_With_Modon_Egypt_Operation_Users</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share Block Requests with &apos;Modon - Egypt&apos; Source Entity with Modon Egypt Operation users.</description>
        <label>Share With Modon Egypt Operation Users</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Modon_Egypt_Head_of_Sales_Operations</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>Source_Entity__c</field>
            <operation>equals</operation>
            <value>Modon - Egypt</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
