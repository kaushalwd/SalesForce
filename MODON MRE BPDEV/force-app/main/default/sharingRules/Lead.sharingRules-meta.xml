<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Broker_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Broker Access</label>
        <sharedTo>
            <group>Broker_Access</group>
        </sharedTo>
        <criteriaItems>
            <field>LeadSource</field>
            <operation>equals</operation>
            <value>Broker Portal,Webinar,Broker Agency</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Call_Center_Egypt_Read_Only</fullName>
        <accessLevel>Read</accessLevel>
        <label>Call Center Egypt Read Only</label>
        <sharedTo>
            <role>Call_Center_Egypt</role>
        </sharedTo>
        <criteriaItems>
            <field>CustomerType__c</field>
            <operation>notEqual</operation>
            <value>VVIP Client,VIP Client</value>
        </criteriaItems>
        <criteriaItems>
            <field>Source_Entity__c</field>
            <operation>equals</operation>
            <value>Modon - Egypt</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Give_Access_to_Broker_Manager</fullName>
        <accessLevel>Read</accessLevel>
        <description>give all broker leads access to broker manager</description>
        <label>Give Access to Broker Manager</label>
        <sharedTo>
            <role>Broker_Manager</role>
        </sharedTo>
        <criteriaItems>
            <field>BrokerAgentName__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Lead_Owner_Change_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Lead Owner Change Access</label>
        <sharedTo>
            <group>Lead_Owner_Change_Access</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>LeadSource</field>
            <operation>equals</operation>
            <value>Social Media</value>
        </criteriaItems>
        <criteriaItems>
            <field>LeadSource</field>
            <operation>equals</operation>
            <value>Website</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Leads_shared_with_Contact_Center_Team</fullName>
        <accessLevel>Read</accessLevel>
        <label>Leads shared with Contact Center Team</label>
        <sharedTo>
            <roleAndSubordinates>Call_Center</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Source_Entity__c</field>
            <operation>notEqual</operation>
            <value>Modon - Egypt</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_with_Operation_Team_Egypt</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share with Operation Team Egypt</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Modon_Egypt_Head_of_Sales_Operations</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>CustomerType__c</field>
            <operation>notEqual</operation>
            <value>VVIP Client,VIP Client</value>
        </criteriaItems>
        <criteriaItems>
            <field>Source_Entity__c</field>
            <operation>equals</operation>
            <value>Modon - Egypt</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
