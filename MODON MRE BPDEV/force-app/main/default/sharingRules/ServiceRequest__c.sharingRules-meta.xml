<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>BM_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <label>BM Sharing</label>
        <sharedTo>
            <role>Broker_Manager</role>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Broker Registration</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Sales_Operation_Team_Access</fullName>
        <accessLevel>Read</accessLevel>
        <label>Sales Operation Team Access</label>
        <sharedTo>
            <group>Sales_Operations</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Property Transfer OffPlan,Joint Owner Addition And Deletion,Joint Owner Title Deed,Property Transfer Title Deed</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Service_Request_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Service Request Sharing</label>
        <sharedTo>
            <group>Service_Request_Access_Group</group>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
        <criteriaItems>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>In-progress</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
