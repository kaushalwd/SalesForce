<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <submitter>All_Brokers</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>All_External_Users_with_Partner_User</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Is_Active__c</field>
        <field>MobilePhone</field>
        <field>En_MobilePhone__c</field>
        <field>Email</field>
        <field>Masked_Email__c</field>
        <field>Email__c</field>
        <field>En_Email__c</field>
        <field>Nationality__c</field>
        <field>En_Nationality__c</field>
        <field>PassportNumber__c</field>
        <field>En_PassportNumber__c</field>
        <field>Phone</field>
        <field>Masked_Phone__c</field>
        <field>Phone__c</field>
        <field>Phone_FF__c</field>
        <field>En_Phone__c</field>
        <field>IsBroker__c</field>
        <field>Masked_Emirates_Id__c</field>
        <field>EmiratesIDExpiryDate__c</field>
        <field>Emirates_ID_Issue_Date__c</field>
        <field>EIDNumber__c</field>
        <field>En_EIDNumber__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>omar.alatrash@modon.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <label>Broker Sales Admin Approval</label>
        <name>Broker_Sales_Admin_Approval</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Contact.Agent_Status__c</field>
            <operation>notEqual</operation>
            <value>Active,In Active</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Agent_Status_to_Active</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Agent_Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Agent Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
