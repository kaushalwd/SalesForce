<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Offer_Name__c</field>
        <field>Offer_On__c</field>
        <field>Offer_Type__c</field>
        <field>Offer_Value__c</field>
        <field>ADM_Discounted_Amount__c</field>
        <field>Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approve_the_ADM_Waiver</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>chaitanya.n@activemindsit.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approve ADM Waiver By Finance</label>
        <name>Approve_ADM_Waiver_By_Finance</name>
        <rejectionActions>
            <action>
                <name>Reject_ADM_Waiver</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Offers_Collections__c.Offer_On__c</field>
            <operation>equals</operation>
            <value>ADM Fees</value>
        </criteriaItems>
        <criteriaItems>
            <field>Offers_Collections__c.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Not Submitted</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submit_the_ADM_Waiver</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>ADM Waiver Approval Process</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
