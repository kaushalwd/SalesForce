<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Refund_Status__c</field>
        <field>Approval_Status__c</field>
        <field>CurrencyIsoCode</field>
        <field>Refund_Amount__c</field>
        <field>Refund_Reason__c</field>
        <field>Account__c</field>
        <field>Sales_Order__c</field>
        <field>Expression_of_Interest__c</field>
        <field>Payment__c</field>
        <field>Transaction_Number__c</field>
        <field>Transaction_Id__c</field>
        <field>Transaction_Date__c</field>
        <field>CreatedBy</field>
        <field>LastModifiedBy</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_Status_On_Approval</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>mofathy@modon.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>mohamed.hamdy@modon.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approve or Reject the request.</description>
        <label>Approve Or Reject Request</label>
        <name>Approve_Or_Reject_Request</name>
        <rejectionActions>
            <action>
                <name>Update_Approval_Status_On_Rejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This approval process will be used by MIRE for Refund object&apos;s record.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Refund__c.Source_Entity__c</field>
            <operation>equals</operation>
            <value>Modon - Egypt</value>
        </criteriaItems>
        <criteriaItems>
            <field>Refund__c.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Submitted for Approval</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Egypt Refund Approval Process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Rollback_Approval_Status_On_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
