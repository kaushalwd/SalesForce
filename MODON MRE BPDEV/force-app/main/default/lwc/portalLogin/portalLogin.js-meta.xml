<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Portal Login (Mock)</masterLabel>
    <description>Mock split-panel login screen for the Modon DCT portal, matching the original design.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="portalUrl" type="String" label="Sign-In destination URL" default="/" description="Where the Sign In button goes (your portal page)." />
            <property name="registerOwnerUrl" type="String" label="Owner registration URL" default="#" />
            <property name="registerSpUrl" type="String" label="Service Provider registration URL" default="#" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>