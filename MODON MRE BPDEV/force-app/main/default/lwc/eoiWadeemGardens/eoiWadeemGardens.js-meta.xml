<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <description>Wadeem Gardens landing page - copy of the modon.com Hudayriyat Golf Estates template pointed at the Wadeem EOI site. No data, no Apex; every image and text is a page property. Author: Aurelix</description>
    <masterLabel>Wadeem Gardens Landing</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="modonLogoImage" type="String" label="MODON logo URL (header)"/>
            <property name="heroImage" type="String" label="Hero image URL"/>
            <property name="heroImageMobile" type="String" label="Hero image URL (portrait / phones)" description="Portrait render served when the viewport is taller than wide; leave blank to use the hero image everywhere"/>
            <property name="heroAlt" type="String" label="Hero image alt text"/>
            <property name="logoImage" type="String" label="Project logo URL (on the hero)"/>
            <property name="logoAlt" type="String" label="Project logo alt text"/>
            <property name="title" type="String" label="Heading" description="Shown under the project logo; leave blank to hide it"/>
            <property name="tagline" type="String" label="Tagline" default="Where Everything Aligns"/>
            <property name="registerUrl" type="String" label="Register now URL" default="/eoi/wadeem-register"/>
            <property name="registerLabel" type="String" label="Register button label" default="Register Your EOI"/>
            <property name="introText" type="String" label="Intro paragraph (beige band)"/>
            <property name="villasHeading" type="String" label="Side-image block heading" default="Everything, within reach"/>
            <property name="villasText" type="String" label="Side-image block paragraph"/>
            <property name="sideImage" type="String" label="Villas section image URL"/>
            <property name="sideImageAlt" type="String" label="Villas section image alt text"/>
            <property name="factsheetJson" type="String" label="Factsheet cards (JSON)" description='[{"title":"4-bedroom Villas","size":"…","plan":"…","handover":"…","price":"…"}, …]; leave blank for the 4/5/6-bedroom placeholders'/>
            <property name="amenitiesJson" type="String" label="Amenities (JSON)" description='[{"icon":"swimming-pool","label":"Swimming Pools"}, …]; icon = file name in Wadeem_Landing/amenities; leave blank for MODON&apos;s list of 11 Sep 2026'/>
            <property name="faqJson" type="String" label="FAQs (JSON)" description='[{"q":"Question","a":"Answer"}, …]; leave blank for MODON&apos;s six FAQs of 11 Sep 2026'/>
            <property name="mapImage" type="String" label="Map image URL (below amenities)"/>
            <property name="mapAlt" type="String" label="Map image alt text"/>
            <property name="galleryImages" type="String" label="Gallery image URLs (comma-separated)"/>
            <property name="assetBase" type="String" label="Asset folder URL (icons)" default="/sfsites/c/resource/Wadeem_Landing"/>
            <property name="copyrightText" type="String" label="Footer copyright" default="© Modon 2026 — All rights reserved"/>
            <property name="termsUrl" type="String" label="Terms &amp; Conditions URL" default="https://www.modon.com/terms-and-conditions"/>
            <property name="privacyUrl" type="String" label="Privacy Policy URL" default="https://www.modon.com/privacy-policy"/>
            <property name="recaptchaBadge" type="String" label="reCAPTCHA badge (on/off)" default="on" description="Shows Google's reCAPTCHA badge bottom-right; needs the site key label and guest access to the EOIRecaptchaFrame page"/>
            <property name="factsheetHeading" type="String" label="Factsheet heading" default="Factsheet"/>
            <property name="sizeLabel" type="String" label="Factsheet row 1 label" default="Size"/>
            <property name="planLabel" type="String" label="Factsheet row 2 label" default="Payment plan"/>
            <property name="handoverLabel" type="String" label="Factsheet row 3 label" default="Handover"/>
            <property name="priceLabel" type="String" label="Factsheet row 4 label" default="Price"/>
            <!-- MEOI-FACTS (12 Sep 2026): added, then reverted the same evening; Builder refuses to drop a property
                 from a component that is placed on a published page, so these five stay declared and unused -->
            <property name="plotLabel" type="String" label="(unused) Factsheet plot label" default="Plot area"/>
            <property name="floorsLabel" type="String" label="(unused) Factsheet floors label" default="Floors"/>
            <property name="parkingLabel" type="String" label="(unused) Factsheet parking label" default="Parking"/>
            <property name="layoutsLabel" type="String" label="(unused) Factsheet layouts label" default="Layouts"/>
            <property name="quantityLabel" type="String" label="(unused) Factsheet quantity label" default="Quantity"/>
            <property name="amenitiesHeading" type="String" label="Amenities heading" default="Amenities"/>
            <property name="galleryHeading" type="String" label="Gallery heading" default="Gallery"/>
            <property name="faqHeading" type="String" label="FAQ heading" default="Frequently Asked Questions"/>
            <property name="termsLabel" type="String" label="Footer link 1 text" default="Terms &amp; Conditions"/>
            <property name="privacyLabel" type="String" label="Footer link 2 text" default="Privacy Policy"/>
            <property name="modonLogoUrl" type="String" label="MODON logo link URL" default="https://www.modon.com/"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>