<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Modon Sales Console Home</masterLabel>
    <description>Entry point for the Modon Sales Console.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="backgroundImage" type="String" label="Background image URL"
                description="Optional. Leave blank to use the built-in gradient backdrop."/>
            <property name="accentColor" type="String" default="#a8a8a8" label="Accent colour"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>