<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Submit for Manual KYC</masterLabel>
    <description>Screen action to upload document and provide reason before submitting for Manual KYC approval.</description>
    <targets>
        <!-- Allows the component to be used as a Quick Action -->
        <target>lightning__RecordAction</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordAction">
            <!-- Specifies it's a UI screen action, not headless -->
            <actionType>ScreenAction</actionType>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>