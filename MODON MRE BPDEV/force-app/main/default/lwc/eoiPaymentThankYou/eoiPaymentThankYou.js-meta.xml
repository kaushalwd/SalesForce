<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <description>Thank-you screen shown after a customer pays a Modon Checkout payment link. Standalone: no journey, no session, no data read. Brand set per site in Experience Builder. Author: Aurelix</description>
    <masterLabel>EOI Payment Thank You</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="modonLogoImage" type="String" label="MODON logo URL" description="White MODON logo top-left; blank = none"/>
            <property name="posterImage" type="String" label="Background image URL"/>
            <property name="posterAlt" type="String" label="Background image alt text"/>
            <property name="logoImage" type="String" label="Logo image URL"/>
            <property name="logoAlt" type="String" label="Logo alt text"/>
            <property name="eyebrow" type="String" label="Eyebrow line" default="Expression of Interest"/>
            <property name="heading" type="String" label="Heading" default="Thank you"/>
            <property name="message" type="String" label="Message" default="Your payment was successful and your interest is registered."/>
            <property name="copyrightText" type="String" label="Copyright" default="© 2026 Modon. All rights reserved."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>