<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Broker Portal Home</masterLabel>
    <description>Portal home page. Shows the broker's allocated units, total sales and current Aspire tier.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="dashboardUrl" type="String" label="Dashboard URL" default="/dashboard?tab=dashboard"/>
            <property name="aspireUrl" type="String" label="Aspire programme URL" default="/dashboard?tab=aspire"/>
            <property name="propertiesUrl" type="String" label="Properties URL" default="/properties?tab=units"/>
            <property name="salesUrl" type="String" label="Sales URL" default="/Leads"/>
            <property name="commissionsUrl" type="String" label="Commissions URL" default="/commissions"/>
            <property name="marketingUpdatesUrl" type="String" label="Marketing and Updates URL" default="/Updates"/>
            <property name="agencyUrl" type="String" label="My Agency URL" default="/myagency"/>
            <property name="helpUrl" type="String" label="Help URL" default="/help"/>

            <!--
                The properties below are no longer used by the component - it now pulls
                everything live from Apex. They're kept here only because this component
                is already placed on a published Experience Builder page, and removing a
                property that a placed instance has stored a value against orphans that
                page. Remove these once the page placement has been re-saved without them.
            -->
            <property name="userName" type="String" label="(Unused) Preview user name" default="Broker Partner"/>
            <property name="agencyName" type="String" label="(Unused) Preview agency name" default="MODON approved agency"/>
            <property name="roleLabel" type="String" label="(Unused) Preview role label" default="Agency workspace"/>
            <property name="environmentLabel" type="String" label="(Unused) Environment label"/>
            <property name="productLabel" type="String" label="(Unused) Product label" default="Sales"/>
            <property name="consoleLabel" type="String" label="(Unused) Console label" default="MODON Sales Console"/>
            <property name="audienceLabel" type="String" label="(Unused) Greeting audience label" default="Sales"/>
            <property name="locationLabel" type="String" label="(Unused) Location label" default="Abu Dhabi, UAE"/>
            <property name="availableUnitsValue" type="String" label="(Unused) Available units value" default="4"/>
            <property name="availableUnitsDetail" type="String" label="(Unused) Available units detail" default="ready to sell"/>
            <property name="openLeadsValue" type="String" label="(Unused) Open leads value" default="30"/>
            <property name="openLeadsDetail" type="String" label="(Unused) Open leads detail" default="open leads"/>
            <property name="totalSalesValue" type="String" label="(Unused) Total sales value" default="AED 2.2M"/>
            <property name="totalSalesDetail" type="String" label="(Unused) Total sales detail" default="this month"/>
            <property name="eoiValue" type="String" label="(Unused) EOI value" default="3"/>
            <property name="eoiDetail" type="String" label="(Unused) EOI detail" default="active"/>
            <property name="signOutUrl" type="String" label="(Unused) Sign out URL" default="/secur/logout.jsp?retURL=/Brokers"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>