<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Inputs from flow -->
            <property
                name="recordId"
                type="String"
                role="inputOnly"
                label="Handover Details Record Id"
            />
            <property
                name="mode"
                type="String"
                role="inputOnly"
                label="Mode"
                description="Home_Orientation or De_Snagging"
                default="Home_Orientation"
            />
            <property
                name="ownerAccountId"
                type="String"
                role="inputOnly"
                label="Owner Account Id"
                description="CustomerAccount from Business_Process__r.Sales_Order__r.CustomerAccount__c"
            />
            <property
                name="docRelatedId"
                type="String"
                role="inputOnly"
                label="Document Related Record Id"
                description="Record Id passed to the file-upload component"
            />
            <!-- Output to flow -->
            <property
                name="attendedBy"
                type="String"
                role="outputOnly"
                label="Attended By (output)"
                description="The picklist value selected by the user"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>