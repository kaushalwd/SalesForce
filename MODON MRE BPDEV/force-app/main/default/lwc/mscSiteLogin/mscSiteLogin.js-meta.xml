<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Modon Sales Console Sign In</masterLabel>
    <description>Branded sign-in screen. Presentation only - authentication stays with the platform.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="brandLabel" type="String" default="Sales" label="Brand label"/>
            <property name="accentColor" type="String" default="#a8a8a8" label="Accent colour"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>