<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Broker Portal Login Revamp</masterLabel>
    <description>Revamped Broker Portal login flow preserving existing username/password, OTP, forgot-password, privacy consent, and registration behavior.</description>
    <targets>
        <target>lightningCommunity__Default</target>
        <target>lightningCommunity__Page</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="brandLabel" type="String" label="Brand label" default="Broker Portal" />
            <property name="startUrl" type="String" label="Post-login start URL" default="/" />
            <property name="registrationPath" type="String" label="Agency registration URL/path" default="/Brokers/SelfRegister" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>