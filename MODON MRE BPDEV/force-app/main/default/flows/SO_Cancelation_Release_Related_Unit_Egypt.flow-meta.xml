<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Allocation_Status</name>
        <label>Update Allocation Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Iterate_Over_Payment_Allocations.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Unapplied</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>allocationList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_Over_Payment_Allocations</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_Over_Payment_Allocations</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_only_EOI_allocations</name>
        <label>Check only EOI allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Iterate_Over_Payment_Allocations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Unapplied_Allocations</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_Over_Payment_Allocations.Receipt__r.ExpressionOfInterest__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Allocation_Status</targetReference>
            </connector>
            <label>Unapplied Allocations</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Unit_Not_Draft</name>
        <label>Is Unit Not Draft?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Make_Draft</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Unit__r.ApprovalStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_SO_Unit</targetReference>
            </connector>
            <label>Make Draft</label>
        </rules>
    </decisions>
    <description>Making Sales Order Downpayment Allocations UnApplied</description>
    <environments>Default</environments>
    <interviewLabel>SO Cancelation: Release Related Unit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SO Cancelation: Release Related Unit (Egypt)</label>
    <loops>
        <name>Iterate_Over_Payment_Allocations</name>
        <label>Iterate Over Payment Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Downpayment_Allocations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_only_EOI_allocations</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Allocations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Downpayment_Allocations</name>
        <label>Get Downpayment Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_Over_Payment_Allocations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Invoice__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_SOI_Invoice.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Allocation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Downpayment_SOI</name>
        <label>Get Downpayment SOI</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_SOI_Invoice</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SalesOrder__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>MilestoneNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SalesOrderInstallments__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SOI_Invoice</name>
        <label>Get SOI Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Downpayment_Allocations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SalesOrderInstallment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Downpayment_SOI.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Invoice__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Allocations</name>
        <label>Update Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>allocationList</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_SO_Unit</name>
        <label>Update SO Unit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Downpayment_SOI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Unit__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ApprovalStatus__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Sub_Status__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Unit_Sold_Date__c</field>
        </inputAssignments>
        <object>Unit__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Unit_Not_Draft</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Source_Entity__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Modon - Egypt</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>SalesOrder__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>allocationList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Allocation__c</objectType>
    </variables>
</Flow>
