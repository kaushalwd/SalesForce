        <nameSegment>BookingReceiptAllocationQueueable</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>On booking Sales Order creation, links the already-collected booking-fee receipts to the SO and its invoices by enqueuing BookingReceiptAllocationQueueable. Runs on the asynchronous after-save path so it executes in its own transaction after commit and cannot affect the booking transaction (single or multi-unit). The invocable itself only enqueues when the Opportunity has a paid booking-fee line, so multi-unit bookings (no fee lines) are a no-op. Modon - Egypt is excluded here and in the invocable. Standard UAE only.</description>
    <environments>Default</environments>
    <interviewLabel>Sales Order - Link Booking Receipts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sales Order - Link Booking Receipts</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
