    <decisions>
        <name>check_profile_and_lead_source</name>
        <label>check profile and lead source</label>
        <locationX>1048</locationX>
        <locationY>556</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Send_Survey</name>
            <conditionLogic>(1 AND ( 2 OR 3 OR 4 OR 5 OR 6))</conditionLogic>
            <conditions>
                <leftValueReference>Get_Running_User_Role.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Call Center</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Walk-In</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Social Media</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Website</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>800-Modon</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>3DS Interactive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Nourishing_Survey</targetReference>
            </connector>
            <label>Yes — Send Survey</label>
        </rules>
