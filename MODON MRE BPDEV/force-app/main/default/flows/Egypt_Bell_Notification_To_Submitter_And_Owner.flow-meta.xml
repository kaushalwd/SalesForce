    <description>Initial version - Sends bell notification to the submitter and owner after approver&apos;s action on refund.</description>
    <environments>Default</environments>
    <formulas>
        <description>Notification body for bell notification</description>
        <name>notificationBody</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISPICKVAL({!$Record.Approval_Status__c},  &apos;Approved by Operations&apos;), ISPICKVAL({!$Record.Approval_Status__c},  &apos;Rejected by Operations&apos;)), &apos;Approval Status: &apos; + TEXT({!$Record.Approval_Status__c}), &apos;Refund Status: &apos; + TEXT({!$Record.Refund_Status__c}))</expression>
    </formulas>
    <formulas>
        <name>notificationTItle</name>
        <dataType>String</dataType>
        <expression>&apos;Refund &apos; + {!$Record.Name} + &apos; is &apos; + IF(ISPICKVAL({!$Record.Approval_Status__c},  &apos;Approved by Operations&apos;), &apos;Approved&apos;, IF(ISPICKVAL({!$Record.Approval_Status__c},  &apos;Rejected by Operations&apos;), &apos;Rejected&apos;, &apos;Cancelled&apos;))</expression>
    </formulas>
