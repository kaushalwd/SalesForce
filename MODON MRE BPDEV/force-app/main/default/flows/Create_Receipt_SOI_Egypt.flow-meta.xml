    <formulas>
        <name>last_4_digit_String</name>
        <dataType>String</dataType>
        <expression>IF({!Mode_of_payment}=&apos;POS&apos;, {!Card_last_4_digit_String}, IF({!Mode_of_payment}=&apos;Bank Transfer&apos;, {!IBAN_Last_4_digit_string}, null))</expression>
    </formulas>
    <formulas>
