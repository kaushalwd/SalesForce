    <decisions>
        <name>Send_Email_based_on_Status</name>
        <label>Send Email based on Status</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Template_for_Open_status</targetReference>
            </connector>
            <label>Status Open</label>
        </rules>
        <rules>
            <name>Status_SLA_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SLA Expired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Template_For_SLA_Expired</targetReference>
            </connector>
            <label>Status SLA Expired</label>
        </rules>
        <rules>
            <name>Status_Customer_Invalid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Invalid Number</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CustomerResponse__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Invalid Number</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Template_for_Invalid_Status</targetReference>
            </connector>
            <label>Status Customer Invalid</label>
        </rules>
        <rules>
            <name>Status_Customer_Not_Reached</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Not Reachable</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CustomerResponse__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Answer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CustomerResponse__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Switched off</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_Template_for_Customer_Not_Reachable_Status</targetReference>
            </connector>
            <label>Status Customer Not Reached</label>
        </rules>
    </decisions>
