<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Assign_Call_center_Leads</name>
        <label>Assign Call center Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>EgyptCallCenterRoundRobin</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>newLeads</name>
            <value>
                <elementReference>$Record</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>EgyptCallCenterRoundRobin</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <description>This action will assign leads based on Round Robin Assignment</description>
        <name>Assign_Leads</name>
        <label>Assign Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Modon_LeadTriggerHandler</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>newLeads</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Modon_LeadTriggerHandler</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_When_To_Assign_Lead_To_Egypt_Round_Robin</name>
        <label>Check When To Assign Lead To Egypt Round Robin</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assign_Lead_To_Round_Robin_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Source_Entity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Modon - Egypt</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.Profile.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Modon Egypt - Call Center</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Social Media</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Webform - Egypt Website</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Leads</targetReference>
            </connector>
            <label>Assign Lead To Round Robin User</label>
        </rules>
        <rules>
            <name>Do_Not_Assign_To_Round_Robin</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Source_Entity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Modon - Egypt</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Social Media</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Webform - Egypt Website</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Call_center_Leads</targetReference>
            </connector>
            <label>Do Not Assign To Round Robin</label>
        </rules>
    </decisions>
    <description>20-08-2025 Enters Egypt Round Robin Matrix if Lead Number isn&apos;t blank and Source Entity is Modon - Egypt</description>
    <environments>Default</environments>
    <interviewLabel>Modon Egypt Lead Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Modon Egypt Lead Assignment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_When_To_Assign_Lead_To_Egypt_Round_Robin</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
