            <label>If Yes</label>
        </rules>
    </decisions>
    <description>This flow is used to trigger the in-app notification for Sales Directors whenever a Lead&apos;s owner is changed from one Sales Associate to another.</description>
    <environments>Default</environments>
    <formulas>
        <name>NotifBody</name>
        <dataType>String</dataType>
        <expression>&apos;Lead &apos; + {!$Record.FirstName} + {!$Record.LastName} + &apos; owner was changed from &apos; + {!$Record__Prior.Owner:User.FirstName} + {!$Record__Prior.Owner:User.LastName} + &apos; to &apos; + {!$Record.Owner:User.FirstName} + {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>NotifTitle</name>
        <dataType>String</dataType>
        <expression>&apos;Lead &apos; + {!$Record.FirstName} + {!$Record.LastName}  + &apos; owner was changed&apos;</expression>
    </formulas>
