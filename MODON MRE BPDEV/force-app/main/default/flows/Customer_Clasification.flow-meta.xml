            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_classification_two</name>
        <label>Update classification two</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
