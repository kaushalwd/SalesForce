            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_1_of_Classfication_one</name>
        <label>Copy 1 of Classfication one</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Checktwo</targetReference>
        </connector>
        <inputAssignments>
            <field>Classification_Level_1__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_1_of_Update_classification_two</name>
        <label>Copy 1 of Update classification two</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
