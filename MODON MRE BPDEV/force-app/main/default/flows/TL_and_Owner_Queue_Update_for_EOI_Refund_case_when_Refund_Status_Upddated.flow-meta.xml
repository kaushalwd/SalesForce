        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Refund_Status__c})=&apos;Pending With CM Team&apos;, &apos;Property_Transfer_Services&apos;,
IF(TEXT({!$Record.Refund_Status__c})=&apos;Pending With Sales Team&apos;, &apos;Real_Estate_Services&apos;,
IF(TEXT({!$Record.Refund_Status__c})=&apos;Pending With Finance Team&apos;, &apos;Finance Queue&apos;,
&apos;Not Applicable&apos;)))</expression>
    </formulas>
