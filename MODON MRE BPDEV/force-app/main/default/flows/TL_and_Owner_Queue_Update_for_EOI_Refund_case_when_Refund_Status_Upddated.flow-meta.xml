IF(TEXT({!$Record.Refund_Status__c})=&apos;Pending With Sales Team&apos;, &apos;Real_Estate_Services_TL&apos;,
IF(TEXT({!$Record.Refund_Status__c})=&apos;Pending With Finance Team&apos;, &apos;Finance Queue TL&apos;,
&apos;Not Applicable&apos;)))</expression>
