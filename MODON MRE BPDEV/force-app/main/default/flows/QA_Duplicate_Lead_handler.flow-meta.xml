            </value>
        </filters>
        <inputAssignments>
            <field>Parent_Lead__c</field>
            <value>
                <elementReference>Get_potential_duplicate_Leads.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
