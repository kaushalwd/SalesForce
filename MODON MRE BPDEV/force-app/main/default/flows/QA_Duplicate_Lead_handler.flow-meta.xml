<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Incoming_lead</name>
        <label>Incoming lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>EmailAddress</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PhoneNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.QA_Standardised_Phone_Number__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ProjectInterest</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.ProjectInterest__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_potential_duplicate_Leads</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Duplicate_Found</name>
        <label>Duplicate Found ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_potential_duplicate_Leads.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Duplicate_Lead</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>removed the owner ud change will be handling that in another AG. Added sorting on Duplicate lead, experimenting on standardizing the mobile number, and added fucntionality to check for last 9 digit to match it.</description>
    <environments>Default</environments>
    <formulas>
        <name>frm_MatchMobileKey</name>
        <dataType>String</dataType>
        <expression>IF(
    LEN({!Get_Lead.QA_Standardised_Phone_Number__c}) &gt;= 9,
    RIGHT({!Get_Lead.QA_Standardised_Phone_Number__c}, 9),
    {!Get_Lead.QA_Standardised_Phone_Number__c}
)</expression>
    </formulas>
    <formulas>
        <name>frm_NormalizedduplicateMobile</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                       {!Get_potential_duplicate_Leads.MobilePhone},
                        &quot;+&quot;, &quot;&quot;
                    ),
                    &quot; &quot;, &quot;&quot;
                ),
                &quot;-&quot;, &quot;&quot;
            ),
            &quot;(&quot;, &quot;&quot;
        ),
        &quot;)&quot;, &quot;&quot;
    ),
    &quot;&apos;&quot;, &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>frm_NormalizedIncomingMobile</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        {!Get_Lead.MobilePhone},
                        &quot;+&quot;, &quot;&quot;
                    ),
                    &quot; &quot;, &quot;&quot;
                ),
                &quot;-&quot;, &quot;&quot;
            ),
            &quot;(&quot;, &quot;&quot;
        ),
        &quot;)&quot;, &quot;&quot;
    ),
    &quot;&apos;&quot;, &quot;&quot;
)</expression>
    </formulas>
    <interviewLabel>QA - Duplicate Lead handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QA - Duplicate Lead handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Incoming_lead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_potential_duplicate_Leads</name>
        <label>Get potential duplicate Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Found</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3 AND 4 AND 5 AND 10 AND 13) OR (1 AND 2 AND 3 AND 4  AND 13 AND (6 OR 7 OR 8 OR 9 OR 11 OR 12))</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>QA_Standardised_Phone_Number__c</field>
            <operator>EndsWith</operator>
            <value>
                <elementReference>frm_MatchMobileKey</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProjectInterest__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead.ProjectInterest__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Lead.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>800-Modon</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Social Media</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>3DS Interactive</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Walk-In</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Webinar</stringValue>
            </value>
        </filters>
        <filters>
            <field>SubSource__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WhatsApp</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Website</stringValue>
            </value>
        </filters>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales Launch</stringValue>
            </value>
        </filters>
        <filters>
            <field>Source_Entity__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Modon - Egypt</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_the_Duplicate_Lead</name>
