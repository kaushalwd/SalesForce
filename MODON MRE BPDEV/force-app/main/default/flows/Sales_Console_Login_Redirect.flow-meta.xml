<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Console_Destination</name>
        <label>Set Console Destination</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>LoginFlow_FinishLocation</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>/apex/SalesConsoleSsoGateway</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Send_To_Sales_Console</name>
        <label>Send to Sales Console?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No - finish the normal way</defaultConnectorLabel>
        <rules>
            <name>Yes_Send_To_Console</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Has_Console_Redirect_Permission</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_Direct_Org_Login</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LoginFlow_Application</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Browser</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Console_Destination</targetReference>
            </connector>
            <label>Yes - send to Sales Console</label>
        </rules>
    </decisions>
    <description>Login flow. Sends a rep holding the Redirect To Sales Console permission to the SalesConsoleSsoGateway page after a browser sign-in; the gateway completes SSO into the Modon Sales Console site. Every other login falls through unchanged.</description>
    <environments>Default</environments>
    <formulas>
        <name>Has_Console_Redirect_Permission</name>
        <dataType>Boolean</dataType>
        <expression>{!$Permission.Redirect_To_Sales_Console}</expression>
    </formulas>
    <formulas>
        <name>Is_Direct_Org_Login</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!LoginFlow_Community})</expression>
    </formulas>
    <interviewLabel>Sales Console Login Redirect {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sales Console Login Redirect</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_To_Sales_Console</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>LoginFlow_Application</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LoginFlow_Community</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>LoginFlow_FinishLocation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
