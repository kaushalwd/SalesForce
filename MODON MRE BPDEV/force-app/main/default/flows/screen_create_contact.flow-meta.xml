    <formulas>
        <name>Customernumber</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    MID({!get_experience.genesysps__Customer_Data__c}, 
        FIND(&apos;&quot;phoneNumber&quot;:&quot;&apos;, {!get_experience.genesysps__Customer_Data__c}) + 14, 
        FIND(&apos;&quot;}&apos;, {!get_experience.genesysps__Customer_Data__c}, FIND(&apos;&quot;phoneNumber&quot;:&quot;&apos;, {!get_experience.genesysps__Customer_Data__c})) 
        - (FIND(&apos;&quot;phoneNumber&quot;:&quot;&apos;, {!get_experience.genesysps__Customer_Data__c}) + 14)
    ), 
    &apos;&quot;&apos;, 
    &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Extract_Email</name>
        <dataType>String</dataType>
        <expression>MID(
    {!get_experience.genesysps__Customer_Data__c},  
    FIND(&apos;&quot;email&quot;:&quot;&apos;,  {!get_experience.genesysps__Customer_Data__c}) + 9,  
    FIND(&apos;&quot;}&apos;,  {!get_experience.genesysps__Customer_Data__c}, FIND(&apos;&quot;email&quot;:&quot;&apos;,  {!get_experience.genesysps__Customer_Data__c})) -  
    (FIND(&apos;&quot;email&quot;:&quot;&apos;,  {!get_experience.genesysps__Customer_Data__c}) + 9)
)</expression>
    </formulas>
