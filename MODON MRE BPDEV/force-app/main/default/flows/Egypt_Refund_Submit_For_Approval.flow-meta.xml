    <decisions>
        <description>Check if All Documents are uploaded.</description>
        <name>Check_All_Documents_Are_Uploaded</name>
        <label>Check All Documents Are Uploaded</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>All_Documents_Are_Uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isRefundDocumentUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isInternalMemoUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_for_Approval</targetReference>
            </connector>
            <label>All Documents Are Uploaded</label>
        </rules>
        <rules>
            <name>Documents_Are_Not_Uploaded</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>isRefundDocumentUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isInternalMemoUploaded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Documents_Not_Uploaded_Error_Screen</targetReference>
            </connector>
            <label>Documents Are Not Uploaded</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check Related Documents Length.</description>
        <name>Check_Related_Documents_Length</name>
        <label>Check Related Documents Length</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_Than_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Documents</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Document_Names_Into_Not_Uploaded_List</targetReference>
            </connector>
            <label>Greater Than 0</label>
        </rules>
        <rules>
            <name>Equal_To_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Documents</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Missing_Related_Documents_Screen</targetReference>
            </connector>
            <label>Equal To 0</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check document&apos;s uploaded status.</description>
        <name>Check_Related_Documents_Status</name>
        <label>Check Related Documents Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_All_Related_Documents</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Refund_Document_Uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_All_Related_Documents.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Refund Document</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_All_Related_Documents.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Uploaded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_isRefundDocumentUploaded_As_True</targetReference>
            </connector>
            <label>Refund Document Uploaded</label>
        </rules>
        <rules>
            <name>Internal_Memo_Uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_All_Related_Documents.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internal Memo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_All_Related_Documents.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Uploaded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_isInternalMemoUploaded_As_True</targetReference>
            </connector>
            <label>Internal Memo Uploaded</label>
        </rules>
    </decisions>
    <description>Initial version - Screen flow to initiate Submit for Approval process of Refund.</description>
