    <assignments>
        <description>Add Document Names into notUploadedDocumentsList.</description>
        <name>Add_Document_Names_Into_Not_Uploaded_List</name>
        <label>Add Document Names Into Not Uploaded List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>notUploadedDocumentsList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Refund Document</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>notUploadedDocumentsList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Internal Memo</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_All_Related_Documents</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigned Refund record with updated approval status to a variable.</description>
        <name>Assign_Updated_Refund_Record_To_Variable</name>
        <label>Assign Updated Refund Record To Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>updatedRefundRecord.Id</assignToReference>
