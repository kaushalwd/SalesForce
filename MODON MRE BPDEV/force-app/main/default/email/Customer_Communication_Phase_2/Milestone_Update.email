<messaging:emailTemplate subject="Milestone Update" recipientType="User" relatedToType="ServiceRequest__c">
<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif;">
    <div style="background-color: #000000; height: 50px; display: flex; align-items: center; padding-left: 20px;">
      <img src="{!$Label.Customer_Communication_Modon_Logo}"
           alt="MODON Logo"
           style="height: 18px; width: auto;" />
    </div>
        <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Milestone Update</div>
 
</div>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">

           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear Recipient,
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
            
            There is an Update On Milestone for :{!relatedTo.Milestone__r.name } <br/><br/>

           

                <b>Project Name:</b> {!relatedTo.Milestone__r.Phase__r.Project__r.Name}<br/><br/>

                <b>Phase Name:</b> {!relatedTo.Milestone__r.Phase__r.name} <br/><br/>
                

               <tr>
  <td colspan="2">

    <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.Milestone__r.ConfirmedMilestoneDate__c))}">
    
               The Actual Milestone Date <b>Milestone Date:</b> {!relatedTo.Milestone__r.Milestone_Due_Date__c}    <br/><br/>
               
       This is your Confirmed Milestone Date <b>Confirmed Date:</b> {!relatedTo.Milestone__r.ConfirmedMilestoneDate__c}
        <br/><br/>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!ISBLANK(relatedTo.Milestone__r.ConfirmedMilestoneDate__c)}">
        This is your Rescheduled Milestone date <b>Rescheduled Date:</b> {!relatedTo.Milestone__r.MilestoneDue__c}
        <br/><br/>
    </apex:outputPanel>

  </td>
</tr>

 
            </td>
           </tr>
           <tr>
             <td colspan="2" style="">
               <br/>Warm regards,<br/><br/><b>Modon Customer Management</b>
             </td>
           </tr>        
         </table>
             
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>