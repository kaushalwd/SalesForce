<messaging:emailTemplate subject="LeadNumber: {!relatedTo.LeadNumber__c}" recipientType="User" relatedToType="Lead">
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
        <table style="text-align:justify;width: 100%;">
            <tr>
            <td colspan="2">
                <apex:outputPanel >
                  <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/724783e9-c2b7-4695-aa14-b1e328552e10/1000x250.jpg" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
            </td>
           </tr>
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Dear {!relatedTo.Owner.Title} {!relatedTo.Owner.name}, 
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   A new task has been created and is currently pending your action. Please review and address it at the earliest convenience. Kindly ensure timely resolution and update the status accordingly. Let us know if you need any support.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td>
                   <br/>Best Regards,<br/>Modon Customer Management
               </td>
           </tr>
       </table>
     </body> 
   </html>  
</messaging:htmlEmailBody>       
</messaging:emailTemplate>