<messaging:emailTemplate subject="Submission Confirmation - SR Number: {!relatedTo.Name}" recipientType="Contact" relatedToType="ServiceRequest__c">
    <messaging:htmlEmailBody >
        <html>
        <body style="font-family: Arial, sans-serif; font-size: 14px;">
            <p>Dear Customer,</p>

            <p>Your Service Request has been successfully submitted.</p>

            <p><strong>SR Number:</strong> {!relatedTo.Name}</p>
            <p><strong>Status:</strong> {!relatedTo.Status__c}</p>

            <p>We will process your request and keep you updated on the progress.</p>

            <p>Regards,<br/>Modon Support Team.</p>
        </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>