<messaging:emailTemplate subject="Refund processed - {!relatedTo.Reference__c}" relatedToType="Checkout_Payment__c">
<messaging:plainTextEmailBody >
Dear {!relatedTo.Customer_Name__c},

A refund of {!relatedTo.Currency_Code__c} <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!relatedTo.Amount__c}"/></apex:outputText> for ref {!relatedTo.Reference__c} has been processed and will reflect in your account per your bank timelines.

Best regards,
Modon
</messaging:plainTextEmailBody>
<messaging:htmlEmailBody >
<html lang="en">
<head><meta charset="UTF-8"></meta><style type="text/css">body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;}img{-ms-interpolation-mode:bicubic;}body{margin:0;padding:0;width:100% !important;height:100% !important;}@media only screen and (max-width:600px){.container{width:100% !important;}.footer-left td img{width:16px !important;height:16px !important;}.footer-left td{font-size:10px !important;line-height:14px !important;}.footer-right img{width:80px !important;height:14px !important;}}</style></head>
<body style="margin:0; padding:0; background:#f4f4f4;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;"><tr><td align="center">
    <table class="container" role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">
      <tr><td style="padding:0; margin:0; line-height:0; font-size:0;"><img src="https://image.realestate.modon.com/lib/fe2e117373640475741678/m/1/86ead678-c890-40ae-a430-d44c2a7f2aca.jpg" alt="Modon" width="600" style="display:block; width:100%; max-width:600px; height:auto; border:0;" /></td></tr>
      <tr><td style="padding:28px 32px;"><div style="font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">
        <p style="margin:0 0 16px;">Dear {!relatedTo.Customer_Name__c},</p>
        <p style="margin:0 0 16px;">A refund of <strong>{!relatedTo.Currency_Code__c} <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!relatedTo.Amount__c}"/></apex:outputText></strong> for ref {!relatedTo.Reference__c} has been processed and will reflect in your account per your bank timelines.</p>
        <p style="margin:0 0 4px;">Best regards,</p><p style="margin:0;"><strong>Modon</strong></p>
      </div></td></tr>
      <tr><td style="padding:0; margin:0; line-height:0; font-size:0;"><table bgcolor="#2B2940" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#2B2940; width:100%; margin:0; padding:0;" width="100%"><tr><td align="center"><table border="0" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px; width:100%; margin:0 auto;" width="100%"><tr><td style="padding:20px 16px;"><table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%"><tr><td class="footer-left" align="left" style="width:70%;" valign="middle" width="70%"><table border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="font-family:Arial, sans-serif; font-size:11px; line-height:14px; color:#ffffff; padding-bottom:8px; text-transform:uppercase;">Follow us on social media</td></tr><tr><td><table align="left" border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding-right:8px;"><a href="https://www.linkedin.com/company/modon/" target="_blank"><img alt="LinkedIn" border="0" height="20" src="https://image.realestate.modon.com/lib/fe2e117373640475741678/m/1/68f4a192-4070-47d0-987e-5d195b6ed826.png" style="display:block;" width="20"/></a></td><td style="padding-right:8px;"><a href="https://www.instagram.com/modonproperties" target="_blank"><img alt="Instagram" border="0" height="20" src="https://image.realestate.modon.com/lib/fe2e117373640475741678/m/1/9aa75f22-01a3-492d-a1f1-7c7e3818854f.png" style="display:block;" width="20"/></a></td><td style="padding-right:8px;"><a href="https://x.com/ModonProperties" target="_blank"><img alt="X" border="0" height="20" src="https://image.realestate.modon.com/lib/fe2e117373640475741678/m/1/f3f7cb4d-dcbf-47e1-9a3c-0b0d643e84dc.png" style="display:block;" width="20"/></a></td><td style="padding-right:8px;"><a href="https://www.facebook.com/modonproperties" target="_blank"><img alt="Facebook" border="0" height="20" src="https://image.realestate.modon.c