<messaging:emailTemplate subject="Discover the New Modon Broker Portal"
    recipientType="User">

    <messaging:htmlEmailBody >
        <html lang="en">
        <head></head>
        <body style="margin:0; padding:0; background:#f4f4f4;">

            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:24px 0; border-collapse:collapse; background:#f4f4f4;">
                <tr>
                    <td align="center">

                        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
                            style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;
                                   box-shadow:0px 4px 12px rgba(0,0,0,0.12);">

                            <tr>
                                <td style="padding:0; margin:0; line-height:0; font-size:0;">
                                    <img
                                        src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/aaf4b8a6-e7d1-42a3-81b1-833b81db64a6/3750x1033.jpeg"
                                        alt="Modon Header"
                                        width="600"
                                        style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none;" />
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 16px 32px;">
                                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                                        <p style="margin: 0 0 16px 0;">Dear {!Recipient.Name},</p>
                                        <p style="margin: 0 0 16px 0;">We’re pleased to announce the launch of the new <strong>Modon Broker Portal</strong>, built to offer seamless experience and support your continued growth.</p>
                                        <p style="margin: 0; font-weight: bold;">What’s New</p>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 16px;">
                                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                        <tr>
                                            <td width="50%" align="center" valign="top" style="padding: 8px;">
                                                <table border="0" cellspacing="0" cellpadding="0" width="100%">
                                                    <tr>
                                                        <td align="center" style="padding-bottom: 8px;">
                                                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/e9ebf231-6b0b-4264-910b-bf80c76e53f9/181x181.png" 
                                                                alt="Dashboard" width="44" style="display:block; margin:0 auto;" />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                                                            Enhanced Dashboard
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                                                            Access real-time sales metrics &amp; performance insights, all in one place.
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>

                                            <td width="50%" align="center" valign="top" style="padding: 8px;">
                                                <table border="0" cellspacing="0" cellpadding="0" width="100%">
                                                    <tr>
                                                        <td align="center" style="padding-bottom: 8px;">
                                                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/26a2e23c-6f9e-47f8-9a25-3effea90c4d6/180x181.png" 
                                                                alt="Property Management" width="44" style="display:block; margin:0 auto;" />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                                                            Property Management
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                                                            Effortlessly view, access, &amp; manage all your allocated properties and marketing materials.
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 16px;">
                                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                        <tr>
                                            <td width="50%" align="center" valign="top" style="padding: 8px;">
                                                <table border="0" cellspacing="0" cellpadding="0" width="100%">
                                                    <tr>
                                                        <td align="center" style="padding-bottom: 8px;">
                                                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/c5e3e62b-268e-4e3d-9082-188238a20763/181x181.png" 
                                                                alt="Commissions" width="44" style="display:block; margin:0 auto;" />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                                                            Lead &amp; Commission Tracking
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                                                            Monitor your sales opportunities, track orders, &amp; stay updated on your commission status.
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>

                                            <td width="50%" align="center" valign="top" style="padding: 8px;">
                                                <table border="0" cellspacing="0" cellpadding="0" width="100%">
                                                    <tr>
                                                        <td align="center" style="padding-bottom: 8px;">
                                                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/e3eaf73c-71a6-47eb-bbed-6362c15ac801/181x181.png" 
                                                                alt="Agency Updates" width="44" style="display:block; margin:0 auto;" />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                                                            Agency &amp; Event Updates
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                                                            Manage your agency profile &amp; stay informed about the latest project launches &amp; events.
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 6px 32px;">
                                    <div style="font-family: Arial, sans-serif; font-size: 16px; color: #000000;">
                                        <p style="margin: 0 0 16px 0;">You can now access the new portal here:</p>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td align="center" style="padding: 6px;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                                        <tr>
                                            <td bgcolor="#000000" align="center" style="border-radius:4px; background-color: #000000; padding: 12px 16px;">
                                                <a href="https://modonproperties.my.site.com/Brokers/"
                                                   style="display:inline-block; font-family:Arial,sans-serif; font-size:14px; font-weight:bold;
                                                          color:#ffffff; text-decoration:none; line-height:1.5;">
                                                    Broker Portal →
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 14px 32px;">
                                    <div style="font-family: Arial, sans-serif; font-size: 16px; color: #000000;">
                                        <p><strong>Kindly use your existing login credentials.</strong></p>
                                        <p>We invite you to explore the platform and experience the improved features firsthand. For any assistance, please contact us at 
                                            <a href="tel:+97180066366" style="color:black"><strong>800 MODON (80066366)</strong></a> 
                                            or email 
                                            <a href="mailto:broker@modon.com" style="color:black"><strong>broker@modon.com</strong></a>.
                                        </p>
                                        <p>Best regards,<br/><strong>Modon Real Estate</strong></p>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:0; margin:0; line-height:0; font-size:0;">
                                    <img
                                        src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                                        alt="Modon Footer"
                                        width="600"
                                        style="display:block; width:100%; max-width:600px; height:auto; border:0;" />
                                </td>
                            </tr>

                        </table>
                    </td>
                </tr>
            </table>

        </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>