<messaging:emailTemplate subject="Updated Payment Plan for Your Property in {!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}" recipientType="Contact" relatedToType="SalesOrder__c"   >
<messaging:htmlEmailBody >
    <html>
   
   
       <body style="margin:0; padding:0; font-size:10pt">
       <table align="center" width="100%" cellpadding="0" cellspacing="0" border="0" style="text-align:justify;">
                <tr>
                    <td align="center" style="padding:20px 0;">
                        
                        <!-- Inner content table -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="">
                            
                            <!-- Empty Header -->
                            <tr>
                                <td >
                                    <!-- Add header content / logo here -->
                                  <p style="padding:20px; ">
                                    <img src="https://modonproperties.my.salesforce.com/servlet/servlet.ImageServer?id=015VH00000GvPTV&oid=00DHp0000025zhx&lastMod=1756908420000" height="30" alt="Modon Logo" />
                                  </p>
                                </td>
                            </tr>

                            <!-- Main Email Content -->
                            <tr>
                                <td style="padding:20px; color:#333; line-height:1.6;">
                                    <p>Dear {{ownerName}},</p>
                                    <p>Greetings from Modon Real Estate.</p>

                                    <p>
                                        Thank you for your investment in Nawafey East, one of the leading projects by Modon.
                                        We would like to inform you that, in line with the current progress of the project development, 
                                        a <b>revised payment schedule</b> has been prepared. This updated schedule has been designed to 
                                        better reflect the construction milestones and ensure transparency and alignment throughout 
                                        the remaining phases of the project.
                                    </p>

                                    <p>Please find <b> Revised payment</b> schedule:</p>
                                    <table border="1" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse; text-align:center; font-size:14px;">
                                        <tr style="background:#DDD9C3; color:#000;">
                                            <th>Instalment No.</th>
                                            <th>Instalment Milestone</th>
                                            <th>Payment %</th>
                                            <th>Revised Date</th>
                                        </tr>
                                        <tr>
                                            <td>4</td>
                                            <td>50% of Foundation works of the Project</td>
                                            <td>5</td>
                                            <td><b>25-Apr-26</b></td>
                                        </tr>
                                        <tr>
                                            <td>5</td>
                                            <td>50% of Structural works of the Project</td>
                                            <td>5</td>
                                            <td><b>25-Sep-26</b></td>
                                        </tr>
                                        <tr>
                                            <td>6</td>
                                            <td>100% of Structural works of the Project</td>
                                            <td>5</td>
                                            <td><b>25-Mar-27</b></td>
                                        </tr>
                                        <tr>
                                            <td>7</td>
                                            <td>Façade Substantial Completion for the Project</td>
                                            <td>5</td>
                                            <td><b>25-Sep-27</b></td>
                                        </tr>
                                        <tr>
                                            <td>8</td>
                                            <td>At Project Completion</td>
                                            <td>60</td>
                                            <td><b>30-Mar-28</b></td>
                                        </tr>
                                    </table>

                                    <p>
                                        Please ensure that sufficient funds are available in your account for the post-dated cheques processing 
                                        to complete the settlement of 20% milestone on or before <b>30-Sep-2025</b>.
                                    </p>

                                    <p>
                                        We are dedicated to keeping you informed of our progress and will provide regular reports and 
                                        updates on any significant milestones as we move forward.
                                    </p>

                                    <p>
                                        For new cheque submission and immediate assistance, please do not hesitate to contact us on 
                                        800-MODON (66366) or visit our Customer Management on the 20th floor of Al Maryah Tower. 
                                        <a href="https://are01.safelinks.protection.outlook.com/?url=http%3A%2F%2Furl8130.modon.com%2Fls%2Fclick%3Fupn%3Du001.fko9oAhH5tQYqmWBgsLUZmhO2-2FDZZ1P-2FY7VDNgSUhsjmDOXxTz0yA3k8oVWVF21R5JHmx49-2BIhQEgUDjIyVAyvXlzkxEIRzgnvwmWy2nUVfEbLCjMeGx18aBd-2F6B4TwcpJDRTHkpLUoLtbS4bnLe3kfx5dpzQVyXoxHipQ8cVsMbeGhdmQOoShrSyWQAHqoLs-2BHpopGeFkT-2FQ3dtXT2mAWrf46TODUETQcyWH-2BjkL4g-2Bt7n7NTKFoI33GCWCtaOhT-2Bx46oZDBXZRadiksy6dMuI-2FBK-2BtvsiBN5qQe3jJGpz-2Bs8bmdKTZOyyldXx-2BBIMWW5-2FdQqhvcPzNeJbYUw-2B1Sw-3D-3Dphcx_wa9ACTksaJeKNh9vZgJneHRDblgcBAOPSy2xMV5aWaSLGw18nlFj2P7GIXf1G-2BTjf7xVZ2a5Ysgh5j7A07Okovn2k47N3PmbFzUmMh8oOOL-2FK07kB7Ufqvc0ycF4L4ZOyxtEDd0G702zfzJZZdDsPR63R5zuE0fREjiORKRrei4IkZyydAYkhOiQnAm7isKgMhwsjFpGcKkPEM00Adentw-3D-3D&data=05%7C02%7Ccollections%40modon.com%7Ca1a6b83e7c474710f96408dda818318f%7Ca47fc36ddc5d4617b46714a51d2dca8e%7C0%7C0%7C638851544062857524%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=mhHOfXMz83x1f8iNv75xRx%2Bn5O24abR4QmoJkMQxEI8%3D&reserved=0" target="_blank">Click here for location</a>.
                                    </p>

                                    <p>Warm Regards,<br/>
                                   <b> Modon Customer Management</b><br/>
                                   <b> 800-MODON (66366)</b></p>
                                </td>
                            </tr>

                            <!-- Fixed Footer -->
                            <tr>
                                <td style=" padding:20px;">
                               <p style="font-size:10px">
                               مدن العقارية، برج الماريه، الطابق 21، ساحة سوق أبوظبي العالمي، جزيرة الماريه، ص.ب.: 3190، أبوظبي، الإمارات العربية المتحدة
                               <br/>
                               Modon Real Estate, Al Maryah Tower, Floor 21, Abu Dhabi Global Market Square, Al Maryah Island, P.O. Box: 3190, Abu Dhabi, UAE.
                               </p>
                                </td>
                            </tr>
                            <tr>
                                <td style=" padding:20px;">
                               <table width="100%" style="font-size:10px;margin-top:-30px">
                               <tr>
                               <td width="50%">T +971 2 698 4421 | E info@modon.com</td>
                               <td width="50%" style="text-align:right">
                               modon.com
                               </td>
                               </tr>
                               </table>
                                </td>
                            </tr>

                        </table>

                    </td>
                </tr>
            </table>

       </body>
           </html>
</messaging:htmlEmailBody>
