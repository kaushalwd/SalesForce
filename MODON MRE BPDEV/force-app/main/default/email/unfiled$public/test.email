<messaging:emailTemplate subject="Stay Connected with Modon Real Estate – Our Official Communication Channels" recipientType="Contact" relatedToType="SalesOrder__c">

    <messaging:htmlEmailBody >

        <html lang="en">
        <head>
            <style type="text/css">
                @media only screen and (max-width:600px) {
                    p {
                        font-size:10px !important;
                    }
                }
            </style>
        </head>

        <body style="margin:0; padding:0; background:#ffffff;">

            <!-- OUTER WRAPPER -->
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" 
                   style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
                <tr>
                    <td align="center" style="margin:0; padding:0;">

                        <!-- INNER CONTAINER -->
                        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
                               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

                            <!-- HEADER -->
                            <tr>
                                <td style="padding:0; margin:0; line-height:0; font-size:0;">
                                <!-- https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/479ad1f5-b682-4f3b-bb73-3ec7820c8380/1200x400.jpg -->
                                    <img
                                        src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/6d233211-8647-4b00-8ca7-7cdd4dbc231c/1200x712.jpg"
                                        alt="Modon Header"
                                        width="600"
                                        style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none;"
                                    />
                                </td>
                            </tr>

                            <!-- BODY -->
                            <tr>
                                <td style="padding: 24px 32px;">
                                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                                        <p style="margin: 0 0 16px 0;">Dear {{ownerName}},</p>
                                        <p style="margin: 0 0 16px 0;">At Modon Real Estate, your satisfaction is our top priority. We want to ensure the best way to reach us for any enquiries, support, or feedback.</p>
                                        <p style="margin: 0 0 16px 0;">
                                            To receive fast and accurate responses, please use our official communication channels exclusively:
                                        </p>
                                    </div>
                                </td>
                            </tr>

                            <!-- CONTACT ICONS SECTION -->
                           <tr>
  <td align="center" style="padding: 0 8px 24px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" 
           align="center" bgcolor="#ffffff" 
           style="background-color:#ffffff; text-align:center; border-collapse:collapse;">
      <tr>
        <!-- Voice -->
        <td align="center" width="33%" style="padding:20px 10px; vertical-align:middle;">
          <a href="tel:+97180066366" target="_blank" style="text-decoration:none; color:#000000;">
            <span style="display:inline-block; width:56px; height:56px; padding:6px; box-sizing:border-box;">
              <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/49a39878-e3ee-4df9-a069-f9012fa359a8/174x170.png" 
                   alt="Voice" 
                   width="44" height="44"
                   style="display:block; margin:0 auto; width:44px; height:44px; object-fit:contain;"/>
            </span>
            <p style="font-family: Arial, sans-serif; font-size:14px; color:#000000; margin:8px 0 0;font-weight:bold; line-height:1.2;">Voice</p>
          </a>
        </td>

        <!-- Email -->
        <td align="center" width="33%" style="padding:20px 10px; vertical-align:middle;">
          <a href="mailto:customercare@modon.com" target="_blank" style="text-decoration:none; color:#000000;">
            <span style="display:inline-block; width:56px; height:56px; padding:6px; box-sizing:border-box;">
              <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/74d2f5d4-f773-4218-94ba-bc27cf94c8cb/136x132.png" 
                   alt="Email" 
                   width="44" height="44"
                   style="display:block; margin:0 auto; width:44px; height:44px; object-fit:contain;"/>
            </span>
            <p style="font-family: Arial, sans-serif; font-size:14px; color:#000000; margin:8px 0 0;font-weight:bold; line-height:1.2;">Email</p>
          </a>
        </td>

        <!-- Location -->
        <td align="center" width="33%" style="padding:20px 10px; vertical-align:middle;">
          <a href="https://maps.app.goo.gl/e6kmc1TMUc3woAJG9" target="_blank" style="text-decoration:none; color:#000000;">
            <span style="display:inline-block; width:56px; height:56px; padding:6px; box-sizing:border-box;">
              <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/183833ef-a503-401e-9331-30b960e99b20/136x132.png" 
                   alt="Location" 
                   width="44" height="44"
                   style="display:block; margin:0 auto; width:44px; height:44px; object-fit:contain;"/>
            </span>
            <p style="font-family: Arial, sans-serif; font-size:14px; color:#000000; margin:8px 0 0; font-weight:bold;line-height:1.2;">Customer Center</p>
          </a>
        </td>
      </tr>
    </table>
  </td>
</tr>


                            <!-- CLOSING TEXT -->
                            <tr>
                                <td style="padding: 16px 32px;">
                                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                                        <p style="margin: 0 0 16px 0;">
                                            By using these official channels, we can respond quickly and efficiently while ensuring the confidentiality and security of your information.
                                        </p>
                                        <p style="margin: 0 0 16px 0;">
                                            If you have any enquiries or require assistance, please don’t hesitate to contact us through any of the below methods. We are always happy to assist you.
                                        </p>
                                        <p style="margin: 0 0 16px 0;">
                                            Thank you for choosing Modon Real Estate.
                                        </p>
                                        <p style="margin: 0;">Best regards,</p>
                                        <p style="margin: 0;">Modon Real Estate</p>
                                    </div>
                                </td>
                            </tr>

                            <!-- FOOTER -->
                            <tr>
                            <!-- https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png -->
                                <td style="padding:0; margin:0; line-height:0; font-size:0;">
                                    <img
                                        src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/8268f916-1fa1-4af6-bd73-e9a83ba58318/3750x300.jpeg"
                                        alt="Modon Footer"
                                        width="600"
                                        style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none;"
                                    />
                                </td>
                            </tr>

                        </table>
                    </td>
                </tr>
            </table>

        </body>
        </html>

    </messaging:htmlEmailBody>
</messaging:emailTemplate>