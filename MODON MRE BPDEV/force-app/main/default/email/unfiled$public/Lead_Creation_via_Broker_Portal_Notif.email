<messaging:emailTemplate subject="Modon Sales Lead Submitted" recipientType="User" RelatedToType="Lead">

  <messaging:htmlEmailBody >
    <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Modon Sales Lead Submitted</title>
      <style type="text/css">
        body {
          margin: 0 !important;
          padding: 0 !important;
          background-color: #f4f4f4 !important;
        }
      </style>
      <!--[if mso]>
      <style type="text/css">
        table, td {
          border-collapse: collapse !important;
          mso-table-lspace: 0pt !important;
          mso-table-rspace: 0pt !important;
          border: 0 !important;
        }
      </style>
      <![endif]-->
    </head>
    <body>

      <!-- OUTER WRAPPER -->
      <table bgcolor="#f4f4f4" border="0" cellpadding="0" cellspacing="0" role="presentation"
        style="margin:0; padding:0; border-collapse:collapse; background-color:#f4f4f4; mso-table-lspace:0pt; mso-table-rspace:0pt;"
        width="100%">
        <tr>
          <td align="center" bgcolor="#f4f4f4" style="padding:0; margin:0; font-size:0px; line-height:0px;">

            <!-- INNER CONTAINER -->
            <table bgcolor="#ffffff" border="0" cellpadding="0" cellspacing="0" role="presentation"
              style="width:100%; max-width:600px; border-collapse:collapse; background-color:#ffffff; mso-table-lspace:0pt; mso-table-rspace:0pt;"
              width="600">

              <!-- BODY CONTENT -->
              <tr>
                <td style="padding:32px 32px 8px 32px;">
                  <div style="font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">

             <p style="margin:0 0 16px;">
  Dear&nbsp;<apex:outputText value="{!recipient.FirstName}" />&nbsp;<apex:outputText value="{!recipient.LastName}" />,
</p>
                    <p style="margin:0 0 16px;">
                      Thank you for submitting your prospective client to Modon for consideration. The lead
                      <strong><apex:outputText value="{!relatedTo.Name}" /></strong>
                      provided will be handled by our professional Sales Team member, who will notify you once the verification process is complete.
                    </p>

                    <p style="margin:0 0 16px;">
                      We will be in touch soon.
                    </p>

                    <p style="margin:0 0 16px;">
                      Should you have any questions or require further assistance, please contact us on
                      <a href="tel:+97180066366"
                        style="color:#000000; text-decoration:underline; white-space:nowrap;">800 MODON (800 66366)</a>
                      or email
                      <a href="mailto:customercare@modon.com"
                        style="color:#000000; text-decoration:underline;">customercare@modon.com</a>.
                    </p>

                    <p style="margin:0;">Best regards,</p>
                    <p style="margin:0;"><strong>Modon</strong></p>

                  </div>
                </td>
              </tr>

            </table>
            <!-- INNER CONTAINER END -->

          </td>
        </tr>

        <!-- OUTLOOK BOTTOM LINE BUG BUFFER -->
        <tr>
          <td bgcolor="#f4f4f4" height="1" style="font-size:0px; line-height:0px; padding:0; margin:0;">&nbsp;</td>
        </tr>

      </table>
      <!-- OUTER WRAPPER END -->

    </body>
    </html>
  </messaging:htmlEmailBody>

  <messaging:plainTextEmailBody >
Dear {!recipient.FirstName} {!recipient.LastName},

Thank you for submitting your prospective client to Modon for consideration. The lead {!relatedTo.Name} provided will be handled by our professional Sales Team member, who will notify you once the verification process is complete.

We will be in touch soon.

Should you have any questions or require further assistance, please contact us on 800 MODON (800 66366) or email customercare@modon.com.

Best regards,
Modon
  </messaging:plainTextEmailBody>

</messaging:emailTemplate>