<messaging:emailTemplate subject="{!relatedTo.Unit__r.Name} - Requesting for your kind action to replace the milestone cheques." recipientType="Contact" relatedToType="SalesOrder__c" >
<messaging:htmlEmailBody >
    <html>
        <head>
            <style>
                p {
                font-size:10pt;
                }
                li {
                padding:20px;
                font-size:10pt;
                }
                td {
                font-size:10pt;
                }
            </style>
        </head>
        <body>
       
         
          <table style="text-align:justify;width: 100%;">
            <tr>
               <td colspan="2">
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
