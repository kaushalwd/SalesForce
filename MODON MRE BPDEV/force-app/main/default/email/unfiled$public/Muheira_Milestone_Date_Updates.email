                    <!-- e8b0a57e5c62d448/d296bd38-482c-4c4d-a513-b0c0044e7e5d-->                              
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef West')}">
                    <img src="cid:7ead4cf7-b471-41c2-bdbc-d378eeb34af3" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Nawayef Park View'}">
                     <img src="cid:596f0002-b6cc-4e39-8e78-ede60514ca33" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Bashayer'}">
                    <!-- <img src="https://modonproperties.my.salesforce.com/servlet/servlet.ImageServer?id=015VH00000KTrtR&oid=00DHp0000025zhx&lastMod=1717859807000" style="width: 100%; height: auto; display: block;"/> -->
                    
                    <img src="cid:c9e75d42-6d2b-41c0-90fc-19b28088aeb4" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar Townhouse'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Thoraya'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Wadeem')}">
                    <img src="cid:96fb3508-795c-4706-b22b-78f2e52d5976" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Muheira')}">
                    <img src="cid:e1efcb85-c683-419a-b4a7-3316b0e316ee" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Reem Hills')}">
                    <img src="cid:e1efcb85-c683-419a-b4a7-3316b0e316ee" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                                
                
                
               </td>
           </tr>
           </table>
         


            <!--/resource/1724752057000/emailtemplateimage -->
            <p>
                Dear {!relatedTo.Primary_Contact_Title__c} {!relatedTo.PrimaryContact__r.Name} ,
            </p>
            
            <p>
            Greetings from Modon Real Estate.
            </p>
            
            <p>
            
                Thank you for your investment in Mayar, one of our flagship developments. We sincerely value your continued trust and support.
            </p>
            <p>
            We hope this email finds you well.
            </p>
            <p>
                Please be advised that we are writing in connection with the future milestone cheques previously submitted to us. As per the revised milestone schedule communicated earlier, these cheques will need to be replaced in line with the updated dates, as outlined below.
            </p>
            <p>
                We kindly request your cooperation in arranging the replacement at the earliest convenience to ensure smooth processing and to avoid any inconvenience.
            </p>
            <table border="1" cellpadding="6" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr style="background-color:#f2f2f2; font-weight:bold; text-align:center;">
        <td>Installment Number</td>
        <td>Milestone Description</td>
        <td>Milestone (%)</td>
        <td>Revised Date</td>
    </tr>

    <tr>
        <td align="center">3</td>
        <td>50% of Foundation works</td>
        <td align="center">5%</td>
        <td align="center">30-Jun-26</td>
    </tr>

    <tr>
        <td align="center">4</td>
        <td>50% of Super Structure works</td>
        <td align="center">5%</td>
        <td align="center">30-Dec-26</td>
    </tr>

    <tr>
        <td align="center">5</td>
        <td>100% of Super Structure works</td>
        <td align="center">5%</td>
        <td align="center">30-Apr-27</td>
    </tr>

    <tr>
        <td align="center">6</td>
        <td>
            Completion of Super Structure works and achieve
            weathertight environment
        </td>
        <td align="center">5%</td>
        <td align="center">30-Aug-27</td>
    </tr>

    <tr>
        <td align="center">7</td>
        <td>At Completion – Building Completion Certificate</td>
        <td align="center">60%</td>
        <td align="center">30-Dec-27</td>
    </tr>
</table>

