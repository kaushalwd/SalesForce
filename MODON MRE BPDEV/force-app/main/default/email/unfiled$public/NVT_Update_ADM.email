<messaging:emailTemplate subject=" Important Update: Change in Developer Number for Your Unit {!relatedTo.Unit__r.Name} - {!relatedTo.ProjectName__c}" recipientType="Contact" relatedToType="SalesOrder__c">
<messaging:htmlEmailBody >
<html lang="en">
<head></head>
<body style="margin:0; padding:0; background:#ffffff;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0;padding:0;border-collapse:collapse;background:#f4f4f4;">
<tr><td align="center">
<table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-collapse:collapse;">
<!-- HEADER -->
<tr>
<td>
<img src="https://modonproperties.my.salesforce.com/servlet/servlet.ImageServer?id=015VH00000HpTEI&oid=00DVG000007z5zd&lastMod=1759223978000" width="600" 
                         style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
</td>
</tr>
<!-- BODY -->
<tr>
<td style="padding:12px 32px;">
<div style="font-family: Arial, sans-serif; font-size:16px; color:#000;">
<p style="margin:0 0 16px 0; line-height:1.6;">Dear {{ownerName}},</p>
<p style="margin:0 0 16px 0; line-height:1.6;">Thank you for being a valued member of the Nawayef Village community.</p>
<p style="margin:0 0 16px 0; line-height:1.6;"><strong>We would like to inform you that the developer reference number assigned to your unit has been updated from ([old number]) to ([new number]).</strong></p>
<p style="margin:0 0 8px 0; line-height:1.6;">Please note that this change does not affect your ownership, unit location, rights, or any associated details. Your ADM (Abu Dhabi Municipality) number will remain unchanged.</p>
<p style="margin:0 0 8px 0; line-height:1.6;">You will soon receive your SPA (Sale and Purchase Agreement) for review and signature. No action is required from you at this time.</p>
<p style="margin:0 0 8px 0; line-height:1.6;">If you have any questions, please contact us at <strong><a href="tel:+97180066366" style="color:black">800 MODON</a></strong> or <strong><a href="mailto:customercare@modon.com" style="color:black">customercare@modon.com</a>.</strong> We are always here to assist you.</p>
<p style="margin:0 0 0 0; line-height:1.6;">Best regards,</p>
<p style="margin:0 0 0 0; line-height:1.6;">Modon Real Estate</p>
</div>
</td>
</tr>
<!-- FOOTER -->
<tr>
<td>
<img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png" 
                         alt="Modon Footer" width="600" 
                         style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
</td>
</tr>
</table>
</td></tr>
</table>
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>