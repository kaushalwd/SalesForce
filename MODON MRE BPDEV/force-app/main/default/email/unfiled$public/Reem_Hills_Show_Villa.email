<messaging:emailTemplate subject="Your Appointment is Confirmed – Reem Hills Show Villa" recipientType="User" relatedToType="AppoinmentBooking__c">
<messaging:htmlEmailBody >
        <html lang="en">
        <head></head>
        <body style="margin:0; padding:0; background:#ffffff;">

          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0;padding:0;border-collapse:collapse;background:#f4f4f4;">
            <tr><td align="center">
              <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-collapse:collapse;">

                <!-- HEADER -->
                <tr>
                  <td>
                    <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png" 
                         alt="Modon Header" width="600" 
                         style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
                  </td>
                </tr>

                <!-- BODY -->
                <tr>
                  <td style="padding:12px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size:16px; color:#000;">
                      <h3 style="margin:0 0 16px 0; line-height:1.4;">Your Appointment is Confirmed</h3>
                      
                      <p style="margin:0 0 16px 0; line-height:1.6;">Dear {!relatedTo.First_Name__c},</p>
                      <p style="margin:0 0 16px 0; line-height:1.6;">Thank you for booking your visit to the <strong>Reem Hills Show Villa</strong>. We’re excited to welcome you and to showcase the lifestyle that Reem Hills has to offer.</p>
                      <p style="margin:0 0 16px 0; line-height:1.6;">Please bring your Emirates ID or passport to present for access.</p>

                      <p style="margin:0 0 8px 0; line-height:1.6;"><strong>Appointment Details:</strong></p>
                      <p style="margin:0 0 8px 0; line-height:1.6;"><strong>Date &amp; Time:</strong> 
                          <apex:outputText value="{0,date,EEE, dd MMM yyyy, hh:mm a}">
                               <apex:param value="{!relatedTo.Appointment_Time_4__c}" />
                            </apex:outputText>
                      </p>
                      <!--<p style="margin:0 0 8px 0; line-height:1.6;"><strong>Time:</strong> 04:00pm</p>-->
                      <p style="margin:0 0 8px 0; line-height:1.6;"><strong>Location:</strong> Reem Hills Show Villa, Abu Dhabi</p>
                      <p style="margin:0 0 8px 0; line-height:1.6;"><strong>Emirates ID / Passport No:</strong> {!relatedTo.Emirates_ID__c}</p>

                      <p style="margin:0 0 16px 0; line-height:1.6;">Our team will be ready to guide you through the villa and answer any questions.</p>

                      <p style="margin:0 0 0 0; line-height:1.6;">Best regards,</p>
                      <p style="margin:0 0 0 0; line-height:1.6;">Modon Real Estate</p>
                    </div>
                  </td>
                </tr>

                <!-- FOOTER -->
                <tr>
                  <td>
                    <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png" 
                         alt="Modon Footer" width="600" 
                         style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
                  </td>
                </tr>

              </table>
            </td></tr>
          </table>

        </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>