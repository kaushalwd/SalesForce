<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; color:#222; font-size:14px; margin:0; padding:18px; }
    .container { max-width:700px; margin:0 auto; }
    h2 { margin:0 0 8px 0; font-size:16px; color:#111; }
    p { margin:8px 0; color:#333; line-height:1.4; }
    table { width:100%; border-collapse:collapse; margin-top:12px; }
    th, td { text-align:left; padding:8px 10px; border:1px solid #e8e8e8; font-size:13px; }
    th { background:#f7f7f7; font-weight:600; }
    a.link { color:#0b6cff; text-decoration:none; }
    .small { font-size:12px; color:#666; }
    .warning{ color:red;font-weight:600; }

  </style>
</head>
<body>
  <div class="container">
    <h2 class="warning">Action Required: Update Missing Booking & Unit Launch Dates</h2>

    <p>Hi <strong>{OWNER_NAME}</strong>,</p>

    <p class="small">
      The following Sales Order(s) do not have a <strong>Booking Date</strong> / <strong>Unit Launch Date</strong> recorded.
      <strong>Booking Date</strong> and <strong>Unit Launch Date</strong> are required for accurate commission calculation and timely payouts.
      Please update these fields as soon as possible.
    </p>

    <!-- Dynamic table fragment inserted here by Apex -->
    <!--BODY_PLACEHOLDER-->

    <p class="small">
      Kindly make sure to update those missing "Booking Date" and "Unit Launch Date".
    </p>

    <p class="small">Regards,<br/>Automated Reminder System — <strong>MODON</strong></p>
  </div>
</body>
</html>