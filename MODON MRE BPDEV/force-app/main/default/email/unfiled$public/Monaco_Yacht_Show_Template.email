<messaging:emailTemplate subject="Thank You for Registering – Modon at Monaco Yacht Show" recipientType="Lead" >
<messaging:htmlEmailBody >
<html lang="en">
<head></head>
<body style="margin:0; padding:0; background:#ffffff;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0;padding:0;border-collapse:collapse;background:#f4f4f4;">
    <tr><td align="center">
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-collapse:collapse;">

        <!-- HEADER -->
        <tr>
          <td>
            <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png" 
                 alt="Modon Header" width="600" 
                 style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:12px 32px;">
            <div style="font-family: Arial, sans-serif; font-size:16px; color:#000;">
              <h3 style="margin:0 0 16px 0; line-height:1.4;">Thank You for Registering Your Interest</h3>
              
              <p style="margin:0 0 16px 0; line-height:1.6;">Dear {!IF(ISBLANK(recipient.FirstName), "Valued Customer", recipient.FirstName)},</p>
              <p style="margin:0 0 16px 0; line-height:1.6;">Thank you for registering your interest to receive the latest news and updates from Modon Real Estate.</p>
              <p style="margin:0 0 16px 0; line-height:1.6;">We would like to welcome you to our community of engaged customers. By subscribing to our updates, you’ll be among the first to know about our newest projects, exclusive offers, and upcoming events across our vibrant destinations.</p>
              <p style="margin:0 0 16px 0; line-height:1.6;">We are committed to creating exceptional living experiences and keeping you informed about the opportunities to be part of our thriving communities.</p>
              <p style="margin:0 0 16px 0; line-height:1.6;">If you have any questions or would like more information, please feel free to reach out to us on (email).</p>
              <p style="margin:0 0 0 0; line-height:1.6;">Best regards,<br/>Modon Real Estate</p>
            </div>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td>
            <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png" 
                 alt="Modon Footer" width="600" 
                 style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>