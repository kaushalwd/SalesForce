<messaging:emailTemplate subject="Your Receipt {!relatedTo.Name}, by Modon" recipientType="Contact" relatedToType="Receipt__c">
<messaging:htmlEmailBody >
<style type="text/css">
.tg  {border-collapse:collapse;border-spacing:0;}
.tg td{border-color:black;border-style:solid;border-width:1px;
  overflow:hidden;padding:10px 5px;word-break:normal;}
.tg th{border-color:black;border-style:solid;border-width:1px;
  overflow:hidden;padding:10px 5px;word-break:normal;}
.tg .tg-0lax{text-align:left;vertical-align:top}
</style>
<p>Dear {!recipient.Name},</p>

<p>Thank you for the payment to Modon in respect to your recent {!relatedTo.PaymentConfirmationMergeField__c}. Please find enclosed a receipt with the confirmation of the transfer of funds.</p>

<div>
    <table class="tg">
        <thead>
          <tr>
            <!-- <th class="tg-0lax">Due Date</th> -->
            <th class="tg-0lax">Payment Method</th>
            <th class="tg-0lax">Bank</th>
            <th class="tg-0lax">Payment Reference</th>
            <th class="tg-0lax">Amount</th>
            <th class="tg-0lax">Remarks</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <!-- <td class="tg-0lax">{!relatedTo.ReceiptDate__c}</td> -->
            <td class="tg-0lax">{!relatedTo.Modeofpayment__c}</td>
            <td class="tg-0lax">{!relatedTo.Bank__c}</td>
            <td class="tg-0lax">{!relatedTo.TransactionNumber__c}</td>
            <td class="tg-0lax">{!relatedTo.TotalAmount__c}</td>
            <td class="tg-0lax">{!relatedTo.Status__c}</td>
          </tr>
        </tbody>
    </table>
</div>

<p>Thank you for choosing Modon, if you have any further queries, please do not hesitate to call us on 800 MODON.</p>

<p>Regards,</p>

<p>Modon Sales</p>
 </messaging:htmlEmailBody>
</messaging:emailTemplate>