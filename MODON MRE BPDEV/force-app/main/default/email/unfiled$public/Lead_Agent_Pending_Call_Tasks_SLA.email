<messaging:emailTemplate subject="{!relatedTo.Subject} - SLA Breach" recipientType="User" relatedToType="Task">
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
        <table style="text-align:justify;width: 100%;">
        <tr>
            <td colspan="2">
                <apex:outputPanel >
                  <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/724783e9-c2b7-4695-aa14-b1e328552e10/1000x250.jpg" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
            </td>
           </tr>
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Dear {!recipient.Name}, 
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Please be informed that the SLA for {!relatedTo.Subject} has been exceeded. Kindly prioritise this matter and take the necessary action to resolve it at the earliest.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Task Details:
               </td>
           </tr> 
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>      
            <tr>
               <td colspan="2">
                      Task ID: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                      {!relatedTo.subject}<br/>
               </td>
            </tr>  
            <tr>
               <td colspan="2">
                      Customer Name:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!relatedTo.who.name}<br/>
               </td>
            </tr>    
            <tr>
               <td colspan="2">      
                      Issue Type:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SLA Expired<br/>
               </td>
            </tr> 
            <tr>
               <td colspan="2">         
                      Original Due Date: &nbsp;&nbsp;{!relatedTo.CurrentTaskSLA__c}
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr> 
           <tr>
               <td>
                   <br/>Best Regards,<br/>Modon Customer Management 
               </td>
           </tr>
       </table>
     </body> 
   </html>  
</messaging:htmlEmailBody>       
</messaging:emailTemplate>