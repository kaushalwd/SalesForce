<html lang="en">
<head>
<meta HTTP-EQUIV="PRAGMA" CONTENT="NO-CACHE" />
<meta HTTP-EQUIV="Expires" content="Mon, 01 Jan 1990 12:00:00 GMT" />
</head>
<body style="margin:0; padding:0; background:#ffffff;">
  <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;" width="100%">
    <tr>
      <td align="center" style="margin:0; padding:0;">
        <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;" width="600">
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img alt="Modon Header" src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png" style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;" width="600" />
            </td>
          </tr>
          <tr>
            <td style="padding: 12px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!Contact.FirstName},</p>
                <p style="margin: 0 0 16px 0;">Thank you for your interest in Modon.</p>
                <p style="margin: 0 0 16px 0;">Please find your personalised sales offer attached. It sets out the unit details, pricing and the full payment schedule for your review.</p>
                <p style="margin: 0 0 16px 0;">If you would like to proceed, or have any questions, please speak to your sales representative or contact us on <strong>800 MODON (80066366)</strong> or <a href="mailto:customercare@modon.com" style="color:#000000;">customercare@modon.com</a>.</p>
                <p style="margin: 0 0 16px 0;">We look forward to welcoming you home.</p>
                <p style="margin: 0;">Best regards,</p>
                <p style="margin: 0;">Modon Real Estate</p>
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img alt="Modon Footer" src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png" style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;" width="600" />
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>