<messaging:emailTemplate subject="UAEPass Login Notification" recipientType="User" relatedToType="UAEPassAutoLinkRule__c">
<messaging:htmlEmailBody >
<html lang="en">
<head></head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr><td align="center">

      <!-- INNER CONTAINER -->
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background:#ffffff; border-collapse:collapse;">

        
        <!-- BODY -->
        <tr><td style="padding: 12px 32px;">
          <div style="font-family: Arial, sans-serif; font-size:16px; line-height:1.5; color:#000;">
            <p>Dear Team,</p>
            <p>A customer has signed in with UAE Pass using an email address that does not match the one held on their Salesforce record. They were identified by their Emirates ID and signed in successfully. No action is required unless the details below look wrong.</p>
            <p>Contact: {!relatedTo.Contact__r.Name}</p>
            <p>Record Id: <a href='https://modonproperties--staguat.sandbox.lightning.force.com/lightning/r/Account/{!relatedTo.Contact__c}/view'>{!relatedTo.Contact__c}</a></p>
            <p>Email on the Salesforce record: {!relatedTo.CustomerEmail__c}</p>
            <p>Email used at sign-in: {!relatedTo.Email__c}</p>
            <p>First seen: {!relatedTo.LastModifiedDate}</p>
            <p>The Salesforce email address has not been changed and remains the address used by all connected systems. The sign-in address has been recorded on the Contact for reference only.</p>
            <p>If this record should be updated to the sign-in address, please make that change directly in Salesforce following the usual process.</p>
            <p>This is an automated notification from the Modon Connect identity service.</p>
            <p>Best regards,<br/>Modon</p>
          </div>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>