<messaging:emailTemplate subject="See you at the Maysan launch | {!relatedTo.LeadNumber__c}" recipientType="User" relatedToType="Lead">
<messaging:htmlEmailBody >
<html>
  <body>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">
           <tr>
            <td colspan="2">
                <apex:outputPanel >
                  <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/724783e9-c2b7-4695-aa14-b1e328552e10/1000x250.jpg" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
            </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear {!relatedTo.FirstName},
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
                This is a friendly reminder that the exclusive launch of the second phase of Maysan starts tomorrow from 9am. <br/><br/>
                <b>Date:</b> 21 and 22 December<br/>
                <b>Time:</b> 9:00am – 9:00pm<br/>
                <b>Location:</b> Modon Sales Centre, Hudayriyat Island <br/><br/>
                Don’t miss this opportunity - this release offers <b>a very limited number of units</b> on a first-come, first-served basis.<br/><br/>
                To complete your property reservation and to ensure a smooth and efficient process, please bring the following mandatory documents:
                <ul>
                    <li>Copy of a valid passport</li>
                    <li>Copy of your Emirates ID</li>
                    <li>Cheque book</li>
                </ul>
                Please note:
                <ul>
                    <li>Only <b>one unit per invitee</b> can be reserved</li>
                    <li>A <b>company ID</b> is required for verification at the venue</li>
                </ul>
                We look forward to seeing you at the Sales Centre.
            </td>
           </tr>
           <tr>
             <td colspan="2" style="">
               <br/>Kind regards,<br/><br/><b>Modon Sales Team</b>
             </td>
           </tr>        
         </table>
             
     <!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>