<messaging:emailTemplate subject="Broker Registration Service Request Submitted" recipientType="User" relatedToType="ServiceRequest__c">
<messaging:htmlEmailBody >
<html>

<div style="text-align: center;height: 20%;width: 100%;">
            
<img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: 75%; display: block;"/>
<!--https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/724783e9-c2b7-4695-aa14-b1e328552e10/1000x250.jpg-->
        </div>
<div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Service Request Submitted Successfully</div>
</div>
     <table style="text-align:justify;width: 100%; font:Arial">
       
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
          <td colspan="2" style="">
              Dear Customer,
          </td>
       </tr>
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
        <td colspan="2" style="">
           Your Broker Registration SR Created Successfully. <br/><br/>
           

            

           This is Your Reference ID: {!relatedTo.name} <br/><br/>

            

            Modon Admin will contact you if any further information needed.<br/>
        </td>
       </tr>
  

     </table>
     
      <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
  <a><b> modon.com</b></a>
  <!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>


</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>