<messaging:emailTemplate subject="Modon Real Estate - Digital KYC Form"
    recipientType="User"
    relatedToType="UserAccess__c">
<messaging:htmlEmailBody>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
</head>

<body style="margin:0; padding:0; background:#f4f4f4;">

<!-- OUTER WRAPPER -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
  style="background:#f4f4f4; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">
  <tr>
    <td align="center">

      <!-- INNER CONTAINER -->
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
        style="width:600px; background:#ffffff; border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">

        <!-- HEADER -->
        <tr>
          <td style="padding:0; line-height:0; font-size:0;">
             <img
              src="https://github.com/Nibraz999/sendgridemo/blob/main/Modon_EDM_Header-150.jpg?raw=true"
              alt="Modon Header"
              width="600"
              height="18"
              style="display:block; width:600px; height:auto; border:0; outline:none; text-decoration:none;"
            />
          </td>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:14px 32px; font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">
            <p style="margin:0 0 16px;">Dear {!Contact.Name},</p>

            <p style="margin:0 0 16px;">
              Thank you for your interest in purchasing <b>{!Contact.KYCUnitName__c}</b> in <b>{!Contact.KYCProjectName__c}</b> at <b>{!Contact.KYCMasterPlanName__c}</b>. <br/><br/> To proceed with your property purchase, please complete the mandatory Know Your Customer (KYC) form as required by UAE Regulations.
            </p>

            <p style="margin:0 0 16px;">
              This digital KYC form is fully encrypted, secure and typically takes no more than <b>5 Minutes</b> to complete.
            </p>

            <p style="margin:0 0 8px;"><strong>Please have the following documents available:</strong></p>
            <p style="margin:0 0 8px;">• Trade License</p>
            <p style="margin:0 0 8px;">• Emirates ID or passport copy of authorised signatory</p>
            <p style="margin:0 0 16px;">• Power of Attorney (if applicable)</p>
            <p style="margin:0 0 8px;"><strong>Please click the button below to begin the KYC process:</strong></p>
          </td>
        </tr>

        <!-- BUTTON -->
        <tr>
          <td align="center" style="padding:8px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td bgcolor="#000000" style="border-radius:4px; padding:12px 16px;">
                  <a href={!Contact.KYCSiteLink__c}
                    style="font-family:Arial, sans-serif; font-size:14px; font-weight:bold; color:#ffffff; text-decoration:none; display:inline-block;">
                    Complete KYC
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- SIGNATURE -->
        <tr>
          <td style="padding:14px 32px; font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">
            <p style="margin:0 0 16px;">
              If you have any questions or need further assistance, please feel free to contact us on or call us on
              <a href="tel:+97180066366" style="color:#000000; font-weight:bold; text-decoration:none;">
                800 MODON (800 66366)
              </a>
              or email
              <a href="mailto:customercare@modon.com" style="color:#000000; font-weight:bold; text-decoration:none;">
                customercare@modon.com
              </a>
            </p>

            <p style="margin:0;">Best regards,</p>
            <p style="margin:0;"><strong>Modon</strong></p>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td bgcolor="#000000" style="padding:8px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
              style="border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">
              <tr>
                <td align="left" valign="top"
                  style="font-family:Arial, sans-serif; font-size:11px; color:#ffffff; line-height:16px; width:70%;">
                  FOLLOW US ON SOCIAL MEDIA
                  <table cellpadding="0" cellspacing="0" border="0" style="margin-top:4px;">
                    <tr>
                      <td style="padding-right:6px;"><a href="#"><img width="20" height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/linkedin.png?raw=true" style="display:block; border:0;"></a></td>
                      <td style="padding-right:6px;"><a href="#"><img width="20" height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/insta.png?raw=true" style="display:block; border:0;"></a></td>
                      <td style="padding-right:6px;"><a href="#"><img width="20" height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/twitter.png?raw=true" style="display:block; border:0;"></a></td>
                      <td style="padding-right:6px;"><a href="#"><img width="20" height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/fb_icon.png?raw=true" style="display:block; border:0;"></a></td>
                      <td><a href="#"><img width="20" height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/youtube.png?raw=true" style="display:block; border:0;"></a></td>
                    </tr>
                  </table>
                </td>

                <td align="right" valign="middle" style="width:30%;">
                  <img width="100" height="18"
                    src="https://github.com/Nibraz999/sendgridemo/blob/main/MODON%20LOGO_White%201.png?raw=true"
                    style="display:block; border:0;">
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
      <!-- /INNER CONTAINER -->

    </td>
  </tr>
</table>
<!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>