<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Business Process Escalation</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f4f4f4; margin:0; padding:20px 0;">

        <tr>
            <td align="center">

                <!-- Main Container -->
                <table width="650" cellpadding="0" cellspacing="0" border="0"
                       style="width:650px; max-width:650px; background-color:#ffffff;">

                    <!-- MODON Header -->
                    <tr>
                        <td align="center"
                            style="padding:20px 20px 15px 20px; background-color:#ffffff;">

                            <img
                                src="https://www.modon.com/images/modoncorporatelibraries/about-us/modon-logo-black5ea80736-1364-498f-afbd-9d3d1d086356.png?sfvrsn=ff9d88d7_3"
                                width="160"
                                alt="MODON"
                                style="display:block; width:160px; max-width:160px; height:auto; border:0;"
                            />

                        </td>
                    </tr>


                    <!-- Title / Introduction -->
                    <tr>
                        <td style="padding:25px 30px 10px 30px;
                                   color:#333333;
                                   font-size:14px;
                                   line-height:22px;">

                            <p style="margin:0 0 15px 0;">
                                Dear Team,
                            </p>

                            <p style="margin:0;">
                                This is an escalation notification for the following
                                Business Process step that has exceeded the defined
                                response time.
                            </p>

                        </td>
                    </tr>


                    <!-- Details -->
                    <tr>
                        <td style="padding:15px 30px 30px 30px;">

                            <table width="100%"
                                   cellpadding="0"
                                   cellspacing="0"
                                   border="0"
                                   style="width:100%;
                                          border-collapse:collapse;
                                          font-family:Arial, Helvetica, sans-serif;
                                          font-size:14px;
                                          color:#333333;">

                                <!-- Business Process -->
                                <tr>

                                    <td width="180"
                                        style="padding:10px;
                                               border-bottom:1px solid #dddddd;
                                               font-weight:bold;
                                               width:180px;">

                                        Business Process

                                    </td>

                                    <td style="padding:10px;
                                               border-bottom:1px solid #dddddd;">

                                        %%BUSINESS_PROCESS%%

                                    </td>

                                </tr>


                                <!--
                                    BOOKING ROW

                                    Apex replaces this entire placeholder
                                    with the Booking <tr> when Sales Order
                                    and Unit are available.

                                    If not required, Apex replaces it with
                                    an empty string.
                                -->
                                %%BOOKING_ROW%%


                                <!--
                                    UNIT ROW

                                    Apex replaces this entire placeholder
                                    with the Unit <tr> when Sales Order
                                    and Unit are available.

                                    If not required, Apex replaces it with
                                    an empty string.
                                -->
                                %%UNIT_ROW%%


                                <!--
                                    MILESTONE ROW

                                    Apex replaces this entire placeholder
                                    with the Milestone <tr> when Booking
                                    and Unit are not available.

                                    Otherwise it is replaced with an
                                    empty string.
                                -->
                                %%MILESTONE_ROW%%


                                <!-- Type -->
                                <tr>

                                    <td width="180"
                                        style="padding:10px;
                                               border-bottom:1px solid #dddddd;
                                               font-weight:bold;
                                               width:180px;">

                                        Type

                                    </td>

                                    <td style="padding:10px;
                                               border-bottom:1px solid #dddddd;">

                                        %%TYPE%%

                                    </td>

                                </tr>


                                <!-- Step Name -->
                                <tr>

                                    <td width="180"
                                        style="padding:10px;
                                               border-bottom:1px solid #dddddd;
                                               font-weight:bold;
                                               width:180px;">

                                        Name

                                    </td>

                                    <td style="padding:10px;
                                               border-bottom:1px solid #dddddd;">

                                        %%STEP_NAME%%

                                    </td>

                                </tr>


                                <!-- Assigned To -->
                                <tr>

                                    <td width="180"
                                        style="padding:10px;
                                               border-bottom:1px solid #dddddd;
                                               font-weight:bold;
                                               width:180px;">

                                        Assigned To

                                    </td>

                                    <td style="padding:10px;
                                               border-bottom:1px solid #dddddd;">

                                        %%ASSIGNED_TO%%

                                    </td>

                                </tr>


                                <!-- Status -->
                                <tr>

                                    <td width="180"
                                        style="padding:10px;
                                               font-weight:bold;
                                               width:180px;">

                                        Status

                                    </td>

                                    <td style="padding:10px;">

                                        %%STATUS%%

                                    </td>

                                </tr>

                            </table>

                        </td>
                    </tr>


                    <!-- Action Button -->
                    <tr>
                        <td align="center"
                            style="padding:0 30px 30px 30px;">

                            <table cellpadding="0"
                                   cellspacing="0"
                                   border="0">

                                <tr>

                                    <td align="center"
                                        style="background-color:#000000;
                                               padding:12px 25px;">

                                        <a
                                            href="%%INSTANCE_URL%%"
                                            style="color:#ffffff;
                                                   text-decoration:none;
                                                   font-size:14px;
                                                   font-weight:bold;
                                                   display:inline-block;">

                                            View Business Process Step

                                        </a>

                                    </td>

                                </tr>

                            </table>

                        </td>
                    </tr>


                    <!-- Footer -->
                    <tr>
                        <td style="padding:20px 30px;
                                   background-color:#f7f7f7;
                                   color:#666666;
                                   font-size:12px;
                                   line-height:18px;
                                   text-align:center;">

                            <p style="margin:0 0 5px 0;">
                                This is an automated notification.
                            </p>

                            <p style="margin:0;">
                                Please do not reply to this email.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>
</html>