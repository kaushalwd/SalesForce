<messaging:emailTemplate subject="Thank You" recipientType="User" relatedToType="Lead">
<messaging:htmlEmailBody >
    <html>
       <body>
       <table style="text-align:justify;width: 100%;">
           <tr>
               <td colspan="2">
                    <img src="cid:d296bd38-482c-4c4d-a513-b0c0044e7e5d" style="width: 100%; height: auto; display: block;"/>                                
               </td>
           </tr>
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>  
           <tr>
               <td colspan="2">
                   Dear {!relatedTo.Title} {!relatedTo.FirstName},
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Thank you for sharing your property preferences with us. We’re excited to help you find your perfect home, tailored to your specific needs.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                    Our team is already hard at work identifying properties that match your criteria and one of our sales representatives will be in touch with you shortly to guide you through the next steps.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                    We look forward to building a long and successful partnership together and helping you find a home that truly suits your needs.
               </td>
           </tr>
           <tr>
               <td>
                   <br/>Warm Regards,
                   <b>
                   <br/>Modon Sales 
                   </b>
               </td>
            </tr>
            <tr>
               <td colspan="2">
                    <img src="cid:d296bd38-482c-4c4d-a513-b0c0044e7e5d" style="width: 100%; height: auto; display: block;"/>                                
               </td>
           </tr>
       </table>
       </body>
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>