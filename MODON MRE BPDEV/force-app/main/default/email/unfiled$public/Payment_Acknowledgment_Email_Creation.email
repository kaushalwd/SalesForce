<messaging:emailTemplate subject="Your Receipt {!relatedTo.Name}, by Modon" recipientType="Contact" relatedToType="Receipt__c">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Name},</p>

<p>Thank you for the payment to Modon in respect to your recent {!relatedTo.PaymentConfirmationMergeField__c}. Once we have confirmation from our bank, we will provide a receipt of the payment for your records.</p>

<p>Thank you for choosing Modon, if you have any further queries, please do not hesitate to call us on 800 MODON.</p>

<p>Warm regards,</p>

<p>Modon Sale Team</p>
 </messaging:htmlEmailBody>
</messaging:emailTemplate>