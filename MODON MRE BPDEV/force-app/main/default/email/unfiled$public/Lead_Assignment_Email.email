<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            color: #333333;
        }
        .container {
            max-width: 600px;
        }
        .header {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 12px;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .details-table td {
            padding: 6px 0;
        }
        .label {
            font-weight: bold;
            width: 160px;
        }
        .cta {
            margin-top: 20px;
        }
        .cta a {
            background-color: #0176d3;
            color: #ffffff;
            padding: 10px 16px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            A new lead has been assigned to you
        </div>

        <p>Hello {!Lead.OwnerFirstName},</p>

        <p>
            A new lead has been assigned to you in Salesforce. Please review the details below
            and take the necessary follow-up action.
        </p>

        <table class="details-table">
            <tr>
                <td class="label">Lead Name:</td>
                <td>{!Lead.FirstName} {!Lead.LastName}</td>
            </tr>
            <tr>
                <td class="label">Company:</td>
                <td>{!Lead.Company}</td>
            </tr>
            <tr>
                <td class="label">Lead Source:</td>
                <td>{!Lead.LeadSource}</td>
            </tr>
            <tr>
                <td class="label">Sub Source:</td>
                <td>{!Lead.SubSource__c}</td>
            </tr>
        </table>

        <div class="cta">
            <a href="https://modonproperties.lightning.force.com/lightning/r/Lead/{!Lead.Id}/view">
                View Lead in Salesforce
            </a>

        </div>

        <p style="margin-top: 20px;">
            Thanks
        </p>
    </div>
</body>
</html>