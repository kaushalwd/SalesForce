<messaging:emailTemplate subject="Your invoice email, by Modon" recipientType="Contact" relatedToType="Invoice__c">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Name},</p>

<p>Thank you for your interest in Modon, we are delighted that you have chosen us for your nextproperty investment. Please find enclosed an invoice outlining the payment details and options to pay via bank transfer or online payment.</p>

<p>Thank you for choosing Modon, if you have any further queries, please do not hesitate to call us on 800 MODON.</p>

<p>Regards,</p>

<p>Modon Sales</p>
 </messaging:htmlEmailBody>
</messaging:emailTemplate>