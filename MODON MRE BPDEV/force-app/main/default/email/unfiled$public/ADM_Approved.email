<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>ADM Waiver — Approved</title>
  <style>
    @media only screen and (max-width: 600px) {
      .container { width: 95% !important; }
      .header-title { font-size: 20px !important; }
      .section-title { font-size: 15px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background:#f2f4f7; font-family:Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f7; padding:30px 0;">
    <tr><td align="center">
      <table class="container" width="700" cellpadding="0" cellspacing="0"
             style="background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,0.10);">

        <!-- HEADER -->
        <tr>
          <td style="background:#16a34a; padding:26px 28px;">
            <h1 class="header-title" style="color:#ffffff; margin:0; font-size:23px; font-weight:650; letter-spacing:0.4px;">
              ADM Waiver — Approved
            </h1>
            <p style="color:#dcfce7; margin:8px 0 0; font-size:13px;">
             Waiver: <strong>{!Offers_Collections__c.Name} for Sales order {!Offers_Collections__c.Sales_Order__c}</strong>
            </p>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:32px; color:#2f3a47; font-size:15px; line-height:1.65;">
            <p>The ADM Waiver request has been approved.</p>

            <!-- META TABLE -->
            <table width="100%" style="margin:20px 0 26px; font-size:14px; border-collapse:collapse;">
              <tr>
                <td style="padding:6px 0; width:30%; font-weight:bold; color:#334155;">ADM Discounted Amount/Value</td>
                <td style="padding:6px 0;">{!Offers_Collections__c.ADM_Discounted_Amount__c}</td>
              </tr>
              <tr>
                <td style="padding:6px 0; font-weight:bold; color:#334155;">Requested By</td>
                <td style="padding:6px 0;">{!Offers_Collections__c.CreatedBy}</td>
              </tr>
             <tr>
                <td style="padding:6px 0; font-weight:bold; color:#334155;">On unit</td>
                <td style="padding:6px 0;">{!Offers_Collections__c.Unit__c}</td>
              </tr>
 <tr>
                <td style="padding:6px 0; font-weight:bold; color:#334155;">Approved / Rejected By</td>
                <td style="padding:6px 0;">{!Offers_Collections__c.ApproveRejectByFRM__c}</td>
              </tr>
            </table>


            <p style="margin-top:22px;">
              <a href="{!Offers_Collections__c.Link}"
   style="display:inline-block; padding:10px 16px; border-radius:6px; text-decoration:none; background:#0b5fad; color:#ffffff;">
  Open ADM Waiver
</a>
            </p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>