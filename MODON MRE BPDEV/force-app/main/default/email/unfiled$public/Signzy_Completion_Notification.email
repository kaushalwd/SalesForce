<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Signzy KYC Completion Notification</title>
  <style>
    @media only screen and (max-width:600px){
      .container{width:95%!important}
      .h1{font-size:20px!important}
      .meta{font-size:14px!important}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:green;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:28px 0;background:#f5f7fa;">
    <tr><td align="center">

      <!-- Card -->
      <table class="container" width="680" cellpadding="0" cellspacing="0"
             style="background:#ffffff;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.08);overflow:hidden;">

        <!-- Header (Blue) -->
        <tr>
          <td style="background:green;padding:22px 26px;">
            <h1 class="h1" style="margin:0;color:white;font-size:22px;font-weight:650;letter-spacing:.3px;">
              Signzy KYC Completion Notification
            </h1>
            <p style="margin:8px 0 0;color:#cfe3f6;font-size:13px;">
              Customer: <strong>{!AccountName}</strong>
            </p>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:28px;color:#2f3a47;font-size:15px;line-height:1.6;">
            <p>Hi {!Owner},</p>

            <p>
               KYC Process for the customer <strong>{!AccountName}</strong> has been completed. Kindly take a look on it.
            </p>

            <!-- Details Table -->
            <table width="100%" class="meta" style="margin:16px 0 22px;border-collapse:collapse;font-size:15px;">
              <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">KYC Ref No</td>
                <td style="padding:6px 0;">{!kycrefno}</td>
              </tr>
			  <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Status</td>
                <td style="padding:6px 0;">{!errorstatus}</td>
              </tr>
              <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Message</td>
                <td style="padding:6px 0;">{!errormessage}</td>
              </tr>

              <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">KYC Send Date</td>
                <td style="padding:6px 0;">{!kycSendDate}</td>
              </tr>
			  <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Document Type 1</td>
                <td style="padding:6px 0;">{!docType1}</td>
              </tr>
			  <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Document Type 2</td>
                <td style="padding:6px 0;">{!docType2}</td>
              </tr>
              
            </table>

            <!-- CTA -->
            <p style="margin-top:6px;">
              <a href={detaillink}
                 style="display:inline-block;padding:10px 16px;border-radius:6px;text-decoration:none;background:green;color:white;">
                Open Account
              </a>
            </p>

            <p style="margin-top:26px;font-size:12px;color:#6b7280;">
              Thanks!<br/>Modon Team
            </p>
          </td>
        </tr>

      </table>
      <!-- /Card -->

    </td></tr>
  </table>
</body>
</html>