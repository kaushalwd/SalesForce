<messaging:emailTemplate subject="Acknowledgement of Cheques Received"
    recipientType="Contact"
    relatedToType="SalesOrder__c">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#ffffff;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER (no padding on the image cell) -->
          
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          
         <tr>
  <td style="padding: 16px 32px;">
    <div dir="rtl" style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000; text-align: right;">
      <p style="margin: 0 0 16px 0;">عميلنا العزيز،</p>
      <p style="margin: 0 0 16px 0;">
        نود بدايةً أن نعرب عن شكرنا وتقديرنا لثقتكم الكبيرة، وقيامكم مؤخراً بشراء عقار 
        <span style="white-space: nowrap; font-weight: bold;">{!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}</span> 
        من شركة مدن العقارية.
      </p>
      <p style="margin: 0 0 16px 0;">
        نؤكد من خلال هذه الرسالة استلامنا شيكات عملية الشراء الخاصة بكم. قمنا بارفاق تقريراً يتضمن كافة تفاصيل الشيكات المقدمة، بما في ذلك تواريخها وقيمها.
      </p>
      <p style="margin: 0 0 16px 0;">
        شكراً لاختياركم شركة مدن العقارية. نحن ملتزمون دائماً بخدمتكم وتحقيق تطلعاتكم.
      </p>
      <p style="margin: 0; text-align: right;">
        مع خالص التقدير،<br>
        شركة مدن العقارية ش.م.ع
      </p>
    </div>
  </td>
</tr>



            <tr>
                <td style="padding: 16px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 16px 0;">Dear Valued Customer,</p>
                        <p style="margin: 0 0 16px 0;">Thank you for your recent property purchase with Modon.</p>
                      <p style="margin: 0 0 16px 0;">
                        We hereby acknowledge the receipt of your cheque(s) related to your purchase <span style="white-space: nowrap; font-weight: bold;">{!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}</span> For your reference, please find attached an acknowledgement report outlining all the cheques submitted, including their respective dates and amounts.
                      </p>
                       <p style="margin: 0;">
                            Kind regards,<br/>
                            Modon Properties PJSC
                        </p>
                    </div>
                </td>
            </tr>
          <!-- FOOTER (also inside the same 600px container; no padding on image cell) -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>