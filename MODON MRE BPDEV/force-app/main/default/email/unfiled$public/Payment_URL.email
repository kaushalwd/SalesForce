<messaging:emailTemplate subject="Your Payment Link for {!relatedTo.Name}, by Modon" recipientType="Contact" relatedToType="Receipt__c">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Name},</p>
<p>Thank you for your interest in Modon, we are delighted that you have chosen us for your next property investment. Please find a link below to enable you to settle your statement online for {!relatedTo.PaymentConfirmationMergeField__c}.</p>

<a href="{!relatedTo.PaymentGatewayURL__c}">Payment Link</a>

<p>Thank you for choosing Modon, if you have any further queries, please do not hesitate to call us on 800 MODON.</p>

<p>Regards,</p>

<p>Modon Sales</p>
 </messaging:htmlEmailBody>
</messaging:emailTemplate>