<messaging:emailTemplate subject="LPC Waiver Request for {!relatedTo.Name}" recipientType="User" relatedToType="ServiceRequest__c">
    <messaging:htmlEmailBody >
        <html>
            <body style="font-family: Arial, sans-serif; font-size: 14px;">
                <div style="max-width: 800px; margin: 0 auto;">
                    <h2>Memorandum</h2>
                    <p><b>Date:</b>
                        <apex:outputText value="{0,date,dd MMM yyyy}">
                            <apex:param value="{!TODAY()}" />
                        </apex:outputText>
                    </p>
                    <p><b>Ref No.:</b> {!relatedTo.Name}</p>
                    <p><b>Subject:</b> LPC Waiver Request</p>

                    <h3>CASE DESCRIPTION</h3>
                    <p>
                        Dear {!recipient.Name},<br /><br />
                        {!relatedTo.SalesOrder__r.CustomerAccount__r.Name} is requesting LPC Waiver for the following installment. 
                        .According to the company policy, customers are allowed to Request for Waiver. 
                        <br /><br />
                    </p>

                  
                    <h3>LPC INSTALLMENTS</h3>
                    <table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #000000; color: #ffffff;">
                            <th>Unit No</th>
                            <th>Sales Order</th>
                            <th>Sales Order Installment</th>
                            <th>LPC Amount</th>
                            <th>Requested Percentage</th>
                            <th>Final Amount(Post Approval)</th>
                        </tr>
                            <tr>
                                 <td>
                                  {!relatedTo.Unit_Name__c}
                                </td>
                                <td>
                                   {!relatedTo.SalesOrder__r.Name}
                                </td>
                                 <td>
                                    {!relatedTo.Sales_Order_Installment__r.Name}
                                </td>
                                <td>
                                    {!relatedTo.LPC_Amount__c}
                                </td>
                                <td>
                                   {!relatedTo.Waiver_Percentage__c}
                                </td>
                                <td>
                                     {!relatedTo.LPC_Waived_Amount__c}
                                </td>
                            </tr>
                    </table>

                    <h3>RECOMMENDATION</h3>
                    <p>{!relatedTo.Description__c}</p>

                    <p>Best Regards,</p>
                    <table border="1" cellpadding="3" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #000000; color: #ffffff;">
                            <th>Approver Name</th>
                            <th>Title</th>
                            <th>Status</th>
                        </tr>
                        <apex:repeat var="pi" value="{!relatedTo.ProcessInstances}">
                            <apex:repeat var="step" value="{!pi.Steps}">
                                <apex:outputPanel rendered="{!step.StepStatus != 'Started'}">
                                    <tr>
                                        <td>{!step.Actor.Name}</td>
                                        <td>{!step.Actor.Title}</td>
                                        <td>{!step.StepStatus}</td>
                                    </tr>
                                </apex:outputPanel>
                            </apex:repeat>
                        </apex:repeat>
                        <tr>
                            <td>{!recipient.Name}</td>
                            <td>{!recipient.Title}</td>
                            <td>Pending</td>
                        </tr>
                    </table>
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>