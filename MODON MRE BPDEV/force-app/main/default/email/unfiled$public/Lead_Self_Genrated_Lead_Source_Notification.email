<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>ALERT ! Self Genrated Lead</title>
</head>

<body style="margin:0; padding:0; background:#f2f4f7; font-family:Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f7; padding:30px 0;">
    <tr>
      <td align="center">
        <table width="700" cellpadding="0" cellspacing="0"
               style="background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,0.10);">

          <!-- HEADER -->
          <tr>
            <td style="background:#000000; padding:25px; text-align:center;">
              
              <img src="https://mir-s3-cdn-cf.behance.net/projects/404/d5dfb9104316105.Y3JvcCw4MDgsNjMyLDAsMA.jpg"
                   alt="MODON Logo"
                   style="max-width:150px; display:block; margin:0 auto 10px;">

              <h1 style="color:#ffffff; margin:0; font-size:22px; font-weight:600;">
               Lead Number - {!Lead.LeadNumber__c}              </h1>

              <p style="color:#d1d5db; margin:8px 0 0; font-size:13px;">
                Requested By: 
                <strong>{!Lead.CreatedBy}</strong>
              </p>
            </td>
          </tr>

          <!-- ALERT BANNER -->
          <tr>
            <td style="background:#fdecea; color:#b71c1c; padding:14px 25px; text-align:center; font-size:14px; font-weight:600; border-bottom:1px solid #f5c6cb;">
              🔴ALERT ! Self Genrated Lead
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding:32px; color:#2f3a47; font-size:15px; line-height:1.65;">
              
              <p><strong>Self Genrated Lead Alert</strong></p>

              <table width="100%" style="margin:20px 0 26px; font-size:14px; border-collapse:collapse;">
                <tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">New Lead Owner Name</td>
                  <td style="padding:6px 0;">{!Lead.OwnerFullName}</td>
                </tr>
   <tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">New Lead Creation Date</td>
                  <td style="padding:6px 0;">{!Lead.CreatedDate}</td>
                </tr>
 <tr>
                  <td style="padding:6px 0; font-weight:bold;">Existing Lead Number</td>
                  <td style="padding:6px 0;">{!Lead.Existing_Lead_Number__c}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0; font-weight:bold;">Existing Lead Source</td>
                  <td style="padding:6px 0;">{!Lead.Existing_Lead_Source__c}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0; font-weight:bold;">Existing Lead Owner Name</td>
                  <td style="padding:6px 0;">{!Lead.ExistingLeadOwnerName__c}</td>
                </tr>
           
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:22px; table-layout:fixed;">
                <tr>
                  <td width="50%" align="left">
                    <a href="{!Lead.Link}"
                       style="display:inline-block; padding:10px 18px; border-radius:6px; 
                              text-decoration:none; background:#000000; color:#ffffff;
                              font-size:14px;">
                      Open Lead Record
                    </a>
                  </td>

                
                </tr>
              </table>

            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>