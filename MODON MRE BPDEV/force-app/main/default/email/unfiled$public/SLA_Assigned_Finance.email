<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>New Assignment — Finance Associate</title>
  <style>
    @media only screen and (max-width:600px){
      .container{width:95%!important}
      .h1{font-size:20px!important}
      .meta{font-size:14px!important}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:28px 0;background:#f5f7fa;">
    <tr><td align="center">

      <!-- Card -->
      <table class="container" width="680" cellpadding="0" cellspacing="0"
             style="background:#ffffff;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.08);overflow:hidden;">

        <!-- Header (Blue) -->
        <tr>
          <td style="background:#0b5fad;padding:22px 26px;">
            <h1 class="h1" style="margin:0;color:#fff;font-size:22px;font-weight:650;letter-spacing:.3px;">
              New Assignment — Finance Associate
            </h1>
            <p style="margin:8px 0 0;color:#cfe3f6;font-size:13px;">
              Sales Order: <strong>{!SalesOrder__c.Name}</strong>
            </p>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:28px;color:#2f3a47;font-size:15px;line-height:1.6;">
            <p>Hi {!SalesOrder__c.Finance_Associate__c},</p>

            <p>
              You’ve been assigned as the <strong>Finance </strong> Associate for
              <strong>Sales Order {!SalesOrder__c.Name}</strong>.
            </p>

            <!-- Details Table -->
            <table width="100%" class="meta" style="margin:16px 0 22px;border-collapse:collapse;font-size:15px;">
              <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Project</td>
                <td style="padding:6px 0;">{!SalesOrder__c.ProjectName__c}</td>
              </tr>
<tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Unit</td>
                <td style="padding:6px 0;">{!SalesOrder__c.Unit__c}</td>
              </tr>
              <tr>
                <td style="padding:6px 0;font-weight:bold;color:#334155;">Customer</td>
                <td style="padding:6px 0;">{!SalesOrder__c.CustomerAccount__c}</td>
              </tr>
            </table>

            <h3 style="margin:8px 0 10px;font-size:16px;color:#0b5fad;">SLA Details</h3>
            <table width="100%" class="meta" style="margin:6px 0 22px;border-collapse:collapse;font-size:15px;">
              <tr>
                <td style="padding:6px 0;width:32%;font-weight:bold;color:#334155;">Duration</td>
                <td style="padding:6px 0;">{!SalesOrder__c.SLA_Hours__c}</td>
              </tr>
              <tr>
                <td style="padding:6px 0;font-weight:bold;color:#334155;">Start Time</td>
                <td style="padding:6px 0;">{!SalesOrder__c.SLA_Start_Date_Time__c}</td>
              </tr>
              <tr>
                <td style="padding:6px 0;font-weight:bold;color:#334155;">Due Time</td>
                <td style="padding:6px 0;">{!SalesOrder__c.SLA_End_Date_Time__c}</td>
              </tr>
            </table>

            <!-- CTA -->
            <p style="margin-top:6px;">
              <a href="https://modonproperties.lightning.force.com/lightning/r/SalesOrder__c/{!SalesOrder__c.Id}/view"
                 style="display:inline-block;padding:10px 16px;border-radius:6px;text-decoration:none;background:#0b5fad;color:#ffffff;">
                Open Sales Order
              </a>
            </p>

            <p style="margin-top:26px;font-size:12px;color:#6b7280;">
              Thanks!<br/>Modon Team
            </p>
          </td>
        </tr>

      </table>
      <!-- /Card -->

    </td></tr>
  </table>
</body>
</html>