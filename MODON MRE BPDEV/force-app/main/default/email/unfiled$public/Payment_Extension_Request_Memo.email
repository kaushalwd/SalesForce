<messaging:emailTemplate subject="Payment Postponement Request for {!relatedTo.Name}" recipientType="User" relatedToType="ServiceRequest__c">
    <messaging:htmlEmailBody >
        <html>
            <body style="font-family: Arial, sans-serif; font-size: 14px;">
                <div style="max-width: 800px; margin: 0 auto;">
                    <h2>Memorandum</h2>
                    <p><b>Date:</b>
                        <apex:outputText value="{0,date,dd MMM yyyy}">
                            <apex:param value="{!TODAY()}" />
                        </apex:outputText>
                    </p>
                    <p><b>Ref No.:</b> {!relatedTo.Name}</p>
                    <p><b>Subject:</b> PE Request</p>

                    <h3>CASE DESCRIPTION</h3>
                    <p>
                        Dear {!recipient.Name},<br /><br />
                        {!relatedTo.Description__c}
                    </p>
                     <h3>RECOMMENDATION</h3>
                    <p>{!relatedTo.Recommendation__c}</p><br />
                    
                    <h3>FINANCIAL SUMMARY</h3>
                    <table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #000000; color: #ffffff;">
                            <th>Unit Code</th>
                            <th>Sales Order</th>
                            <th>Sales Value</th>
                            <th>Collected Amount</th>
                            <th>Outstanding</th>
                            <th>Collection %</th>
                        </tr>
                        <tr>
                            <td>{!relatedTo.SalesOrder__r.Unit__r.Name}</td>
                            <td>{!relatedTo.SalesOrder__r.Name}</td>
                            <td>
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.SalesOrder__r.TotalAmount__c}" />
                                </apex:outputText>
                            </td>
                            <td>
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.SalesOrder__r.Totalpaidamount__c}" />
                                </apex:outputText>
                            </td>
                            <td>
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.SalesOrder__r.TotalAmount__c - relatedTo.SalesOrder__r.Totalpaidamount__c}" />
                                </apex:outputText>
                            </td>
                            <td>
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!relatedTo.SalesOrder__r.Collect_Amount__c}" />
                                </apex:outputText>
                            </td>
                        </tr>
                    </table>

                    <h3>INSTALLMENTS PLAN</h3>
                    <table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #000000; color: #ffffff;">
                            <th>Installment No</th>
                            <th>Reservation Date</th>
                            <th>Extension Date</th>
                            <th>AED</th>
                        </tr>
                        <apex:repeat var="inst" value="{!relatedTo.Sales_Order_Installment__r}">
                            <tr>
                                <td>{!inst.Name}</td>
                                <td>
                                    <apex:outputText value="{0,date,dd MMM yyyy}">
                                        <apex:param value="{!inst.MilestoneDate__c}" />
                                    </apex:outputText>
                                </td>
                                <td>
                                    <apex:outputText value="{0,date,dd MMM yyyy}">
                                        <apex:param value="{!relatedTo.Payment_Extension_Date__c}" />
                                    </apex:outputText>
                                </td>
                                <td>
                                    <apex:outputText value="{0,number,#,##0.00}">
                                        <apex:param value="{!inst.InstallmentAmount__c}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:repeat>
                    </table>

                   

                    <p>Best Regards,</p>
                    <table border="1" cellpadding="3" cellspacing="0" style="border-collapse: collapse; width: 100%;">
                        <tr style="background-color: #000000; color: #ffffff;">
                            <th>Approver Name</th>
                            <th>Title</th>
                            <th>Status</th>
                        </tr>
                        <apex:repeat var="pi" value="{!relatedTo.ProcessInstances}">
                            <apex:repeat var="step" value="{!pi.Steps}">
                                <apex:outputPanel rendered="{!step.StepStatus != 'Started'}">
                                    <tr>
                                        <td>{!step.Actor.Name}</td>
                                        <td>{!step.Actor.Title}</td>
                                        <td>{!step.StepStatus}</td>
                                    </tr>
                                </apex:outputPanel>
                            </apex:repeat>
                        </apex:repeat>
                        <tr>
                            <td>{!recipient.Name}</td>
                            <td>{!recipient.Title}</td>
                            <td>Pending</td>
                        </tr>
                    </table>
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>