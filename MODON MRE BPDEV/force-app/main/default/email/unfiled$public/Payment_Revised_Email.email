<messaging:emailTemplate subject="Revised Payment Schedule for Your Property in {!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}" recipientType="Contact" relatedToType="SalesOrder__c" >
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
       <table style="text-align:justify;width: 100%;">
      
                
           <tr>
               <td colspan="2">
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Reem Hills')}">
                    <img src="cid:e1efcb85-c683-419a-b4a7-3316b0e316ee" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                    <!--<img src="cid:cd29873a-204d-46c8-b9b0-34024d35add8" style="width: 100%; height: auto; display: block;"/>                                -->
               </td>
           </tr>
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>  
           <tr>
               <td colspan="2">
                   Dear {{ownerName}},
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Greetings from Modon Real Estate.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Thank you for your investment in Reem Hills, one of the leading projects by Modon.
               </td>
           </tr>
           
            <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           
           <tr>
               <td colspan="2">
                   We would like to inform you that, in line with the current progress of the project development, a <b>revised payment schedule</b> has been prepared for <b>Phase 2D.3 - {!relatedTo.unit__r.Building_Name__c}</b>. This updated schedule has been designed to better reflect the construction milestones and ensure transparency and alignment throughout the remaining phases of the project.
               </td>
           </tr>
           
           <tr>
               <td colspan="2">
                   <br/>Please find revised payment schedule for the upcoming milestone and all future subsequent Milestones will remain same.
               </td>
           </tr>
           
           
           
           <tr>
    <td colspan="2">
        <table width="100%" border="1" cellpadding="6" cellspacing="0" 
               style="border-collapse:collapse; font-family:Arial, sans-serif; font-size:12px;">

            <!-- Header Row -->
            <tr style="background-color:#f2d2b6; font-weight:bold; text-align:left;">
                <th width="5%">SN</th>
                <th width="45%">Installment Milestone</th>
                <th width="15%">Payment %</th>
                <th width="17%">Current Date</th>
                <th width="18%">Revised Date</th>
            </tr>

            <!-- Data Row -->
            <tr>
                <td>4</td>
                <td>On 50% Completion of MEP Works</td>
                <td>5%</td>
                <td>31 Jan 2026</td>
                <td>31 Mar 2026</td>
            </tr>

        </table>
    </td>
</tr>

           <apex:outputPanel rendered="{!relatedTo.PrimaryContact__r.UAE_Resident_Status__c== 'Non-Resident'}">
           
           
             <tr>
               <td colspan="2">
                   <br/><b>For International and Non-Resident Investors</b>, please make payment by bank transfer. Be sure to include your unit number in the description and share the proof of transfer on email to collections@modon.com, so that we can accurately track and record your payment. 
               </td>
           </tr>
           
            <tr>
                   <td colspan="2">
                   <br/><br/>
                         <b>Bank Details:</b>
                   </td>
               </tr>
               
                <tr>
                   <td colspan="2">
                          &nbsp;
                   </td>
               </tr>
                <tr>
                   <td colspan="2">
                           <b>Account Name:</b> {!relatedTo.VirtualAccount__r.Name}<br/>
                           <b>Account Number:</b> {!relatedTo.VirtualAccount__r.VirtualAccountNumber__c}<br/>
                           <b>IBAN Number:</b> {!relatedTo.VirtualAccount__r.VirtualIBANNumber__c}<br/>
                           <b>Curency:</b> AED<br/>
                           <b>Bank Name:</b> {!relatedTo.VirtualAccount__r.EscrowAccount__r.BankName__c} <!--<c:getInstalmentValue salesOrder="{!relatedTo.Id}" emailReminder="{!relatedTo.Email_Reminder__c}"/>--><br/>
                           <b>Swift Code:</b> {!relatedTo.VirtualAccount__r.EscrowAccount__r.SwiftCode__c}<br/>
                   </td>
               </tr>
               
               </apex:outputPanel>
               
               <tr>
               <td colspan="2">
                   <br/>We are dedicated to keeping you informed of our progress and will provide regular reports and updates on any significant milestones as we move forward. 
               </td>
           </tr>
                            
            <tr>
                <td colspan="2">
                    <br/>Please do not hesitate to contact us on 800-MODON (66366) or visit our Customer Management on the 20th floor of Al Maryah Tower. <a href="https://www.google.com/maps/place/Maryah+Tower/@24.49841,54.3906064,17z/data=!3m1!4b1!4m6!3m5!1s0x3e5e67acdf150f29:0x5f4ca7797b069048!8m2!3d24.49841!4d54.3906064!16s%2Fg%2F11f03pn0pd?entry=ttu&g_ep=EgoyMDI1MDQxNC4xIKXMDSoJLDEwMjExNDUzSAFQAw%3D%3D">Click here for location</a>.
                 </td>
            </tr>  
            <tr>
               <td>
                   <br/>Warm Regards,<b> <br/>Customer Management<br/>800-MODON (66366) </b>
               </td>
            </tr>
           
            <br/>
            
           <!--
            <tr>
               <td>
                   <br/>Warm Regards,<br/>Customer Management
               </td>
            </tr>
            -->
           
       </table>
       </body>

   
        
            
        
        
    
        
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>