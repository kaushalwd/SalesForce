<messaging:emailTemplate subject="Upcoming Payment Reminder for Your Property in {!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}" recipientType="Contact" relatedToType="SalesOrder__c"   >
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
       <table style="text-align:justify;width: 100%;">
           <tr>
               <td colspan="2">
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                    <img src="cid:d296bd38-482c-4c4d-a513-b0c0044e7e5d" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Nawayef East'}">
                    <img src="cid:08abcdf2-abe6-4a04-b663-c8652626026d" style="width: 100%; height: auto; display: block;"/>
                    <!-- e8b0a57e5c62d448/d296bd38-482c-4c4d-a513-b0c0044e7e5d-->                              
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef West')}">
                    <img src="cid:7ead4cf7-b471-41c2-bdbc-d378eeb34af3" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Nawayef Park View'}">
                     <img src="cid:596f0002-b6cc-4e39-8e78-ede60514ca33" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar Townhouse'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
               </td>
           </tr>
           
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>  
           <tr>
               <td colspan="2">
                   Dear {!relatedTo.Primary_Contact_Title__c} {!relatedTo.PrimaryContact__r.Name}, <!--{!relatedTo.Primary_Contact_Title__c} {!relatedTo.PrimaryContact__r.Name},--> <!--{{ownerName}}-->
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Thank you for your investment in {!relatedTo.ProjectName__c}, one of the leading projects by Modon.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
           

               <td colspan="2">
                  <!-- Your next instalment of <c:getEquity salesOrder="{!relatedTo.Id}"/>% (<c:getInstalmentValue salesOrder="{!relatedTo.Id}"/>) for {!relatedTo.Unit__r.Name}, originally due on <c:getInstalmentDueDate salesOrder="{!relatedTo.Id}"  emailReminder="{!relatedTo.Email_Reminder__c}" /> - test - {!relatedTo.ADM_Fees_Dari_charges__c}, will be collected on 15-Nov-2024. Please ensure that sufficient funds are available in your account for the post-dated cheque. -->
                 Your ADM and Dari Fee ( <apex:outputText value="AED {0, number, ###,##0.00}"> <apex:param value="{!relatedTo.AmounttToBeCollected__c}" />  </apex:outputText>          ) for the investment in {!relatedTo.Unit__r.Name} will be collected on 20 November 2025, please ensure that sufficient funds are available in your account for the cheque to clear.

               </td>
           </tr>    
           
            <tr>
                <td colspan="2">
                    <br/>For more information and immediate assistance, please do not hesitate to contact us via customercare@modon.com or visit our Sales Centre on Hudayriyat Island. <a href="https://www.google.com/maps/place/Modon+Sales+Centre+Hudayriyat+Island/@24.4128464,54.3520636,809m/data=!3m2!1e3!4b1!4m6!3m5!1s0x3e5e69ff6385db2f:0x8e4de1cd773fe49f!8m2!3d24.4128464!4d54.3520636!16s%2Fg%2F11y3b8fhvg?entry=ttu&g_ep=EgoyMDI1MDIwNC4wIKXMDSoASAFQAw%3D%3D"> Click here for location.</a><!-- <img style="width: 15px" src="https://modonproperties--uat.sandbox.my.salesforce.com/servlet/servlet.ImageServer?id=015TI000000XUtl&oid=00DDw000005FD09&lastMod=1726841263000"/> -->
                 </td>
            </tr>                     
           
            <tr>
               <td>
                   <br/>Warm Regards,
                   <b>
                   <br/>Modon Customer Management
                   <br/>800-MODON (66366)
                   </b>
               </td>
            </tr>
           <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Reem Hills'}">
                     <tr>
                   <td colspan="2" align="left">
                   <img src="cid:88bb9c75-4a8d-4819-b7a0-12eaa6670860" style="width: 100%; height: auto; display: block;"/>
                   <!--
                       <a href="modon.com" target="_blank"><img align="center" src="https://modonproperties.my.salesforce.com/servlet/servlet.FileDownload?file=015VH00000DUKJx" /></a>
                       -->
                   </td>
               </tr>
           </apex:outputPanel>
       </table>
       </body>    
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>