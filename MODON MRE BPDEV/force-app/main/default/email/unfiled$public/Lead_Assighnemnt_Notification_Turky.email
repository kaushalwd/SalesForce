<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>New Account Exception Approval</title>
  <style>
    @media only screen and (max-width: 600px) {
      .container { width: 95% !important; }
      .header-title { font-size: 20px !important; }
    }
  </style>
</head>

<body style="margin:0; padding:0; background:#f2f4f7; font-family:Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f7; padding:30px 0;">
    <tr>
      <td align="center">
        <table class="container" width="700" cellpadding="0" cellspacing="0"
               style="background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,0.10);">

          <!-- HEADER -->
          <tr>
            <td style="background:#000000; padding:25px; text-align:center;">
              
              <!-- MODON LOGO -->
              <img src="https://mir-s3-cdn-cf.behance.net/projects/404/d5dfb9104316105.Y3JvcCw4MDgsNjMyLDAsMA.jpg"
                   alt="MODON Logo"
                   style="max-width:150px; display:block; margin:0 auto 10px;">

              <h1 class="header-title" 
                  style="color:#ffffff; margin:0; font-size:22px; font-weight:600;">
               Lead Number -{!Lead.LeadNumber__c}
              </h1>

              <p style="color:#d1d5db; margin:8px 0 0; font-size:13px;">
          
                <strong>{!Lead.OwnerFullName}</strong>
              </p>
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding:32px; color:#2f3a47; font-size:15px; line-height:1.65;">
              
              <p><strong>Lead has been assigned to you </strong></p>

              <!-- DETAILS TABLE -->
              <table width="100%" style="margin:20px 0 26px; font-size:14px; border-collapse:collapse;">
                <tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Customer Name</td>
                  <td style="padding:6px 0;">{!Lead.Name}</td>
                </tr>
<tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Lead Origin</td>
                  <td style="padding:6px 0;">{!Lead.LeadOrigin__c}</td>
                </tr>

<tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Customer Email</td>
                  <td style="padding:6px 0;">{!Lead.Email}</td>
                </tr>


<tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Customer Mobile</td>
                  <td style="padding:6px 0;">{!Lead.MobilePhone}</td>
                </tr>
<tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Project</td>
                  <td style="padding:6px 0;">{!Lead.ProjectInterest__c}</td>
                </tr>
<tr>
                  <td style="padding:6px 0; width:30%; font-weight:bold;">Source</td>
                  <td style="padding:6px 0;">{!Lead.UTMSource__c}</td>
                </tr>

                <tr>
                  <td style="padding:6px 0; font-weight:bold;">Owner Full name</td>
                  <td style="padding:6px 0;">{!Lead.OwnerFullName}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0; font-weight:bold;">Created Date</td>
                  <td style="padding:6px 0;">{!Lead.CreatedDate}</td>
                </tr>
              
             <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:22px; table-layout:fixed;">
  <tr>

    <!-- LEFT BUTTON -->
    <td width="50%" align="left" valign="top">
      <a href="{!Lead.Link}"
         style="display:inline-block; padding:10px 18px; border-radius:6px; 
                text-decoration:none; background:#000000; color:#ffffff;
                font-size:14px; white-space:nowrap;">
        Open Lead Record
      </a>
    </td>



  </tr>
</table>
      </td>
    </tr>
  </table>
</body>
</html>