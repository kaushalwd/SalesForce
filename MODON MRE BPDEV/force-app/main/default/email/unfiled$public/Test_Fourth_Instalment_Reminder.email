<messaging:emailTemplate subject="Test Upcoming Payment Reminder for Your Property in {!relatedTo.ProjectName__c} - {!relatedTo.Unit__r.Name}" recipientType="Contact" relatedToType="SalesOrder__c"   >
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
       <table style="text-align:justify;width: 100%;">
            <tr>
               <td colspan="2">
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                    <img src="cid:d296bd38-482c-4c4d-a513-b0c0044e7e5d" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Nawayef East'}">
                    <img src="cid:08abcdf2-abe6-4a04-b663-c8652626026d" style="width: 100%; height: auto; display: block;"/>
                    <!-- e8b0a57e5c62d448/d296bd38-482c-4c4d-a513-b0c0044e7e5d-->                              
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef West')}">
                    <img src="cid:7ead4cf7-b471-41c2-bdbc-d378eeb34af3" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Nawayef Park View'}">
                     <img src="cid:596f0002-b6cc-4e39-8e78-ede60514ca33" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Mayar Townhouse'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!relatedTo.Phase_Name__c == 'Thoraya'}">
                     <img src="cid:11e071c4-95af-4f4c-9042-0e3233a17e5d" style="width: 100%; height: auto; display: block;"/>
                </apex:outputPanel>
                
               </td>
           </tr>
           
        
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>  
           <tr>
               <td colspan="2">
                   Dear {{ownerName}},
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
               Thank you for your investment in {!relatedTo.ProjectName__c}, one of the Modon leading projects.
                   
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
               Your next instalment of <c:getEquity salesOrder="{!relatedTo.Id}" emailReminder="{!relatedTo.Email_Reminder__c}" />% (<c:getInstalmentValue salesOrder="{!relatedTo.Id}" emailReminder="Fourth Instalment Reminder"/>) for your unit {!relatedTo.Unit__r.Name} will be collected on 31 Oct, 2025. Please ensure that sufficient funds are available in your account for the post-dated cheque.
              
               </td>
           </tr>
           
           <tr>
               <td colspan="2">
                   <br/>If you would like to discuss any details regarding your payment, please reach out to us at  <a href="mailto:customercare@modon.com">customercare@modon.com</a> or call us at the number below.<br/>
               </td>
           </tr>
           
           <apex:outputPanel rendered="{!relatedTo.PrimaryContact__r.UAE_Resident_Status__c== 'Non-Resident'}">
           
           
           
           
           <tr>
               <td colspan="2">
<!--                   <br/>For International and Non-Resident Investors, please make payment by bank transfer. Be sure to include your unit number in the description and share the proof of transfer on email to <a href="mailto:collections@modon.com">collections@modon.com</a>, so that we can accurately track and record your payment. 
-->
                   <br/> <b>For International and Non-Resident Investors</b>, please make payment by bank transfer. Be sure to include your unit number in the description and share the proof of transfer on email to <a href="mailto:collections@modon.com">collections@modon.com</a>, so that we can accurately track and record your payment.
               </td>
           </tr>
           
            <tr>
               <td colspan="2">
                   <h3>Bank Details:</h3>
               </td>
           </tr>
           
           <tr>
              <td colspan="2">
                  <table>
                      <tbody>
                          <tr>
                            <td><b>Account number:</b></td> 
                            <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                                <td>{!relatedTo.VirtualAccount__r.VirtualAccountNumber__c}<!--{!relatedTo.VirtualAccount__r.VirtualAccountNumber__c}--></td>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef')}">
                                <td>{!relatedTo.VirtualAccount__r.VirtualAccountNumber__c}<!--{!relatedTo.VirtualAccount__r.VirtualAccountNumber__c}--></td>
                            </apex:outputPanel> 
                            
                        </tr>
                        <tr>
                            <td><b>IBAN Number:</b></td> 
                
                            <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                                <td>{!relatedTo.VirtualAccount__r.VirtualIBANNumber__c}</td>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef')}">
                                <td>{!relatedTo.VirtualAccount__r.VirtualIBANNumber__c}</td>
                            </apex:outputPanel>
                        </tr>
                        <tr>
                            <td  ><b>Currency:</b></td> 
                            
                            <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                                <td>AED</td>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef')}">
                                <td>AED</td>
                            </apex:outputPanel>
                            
                        </tr>
                      
                        <tr>
                            <td  ><b>Bank name: </b></td> 
                            
                            
                            <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                                <td>First Abu Dhabi Bank PJSC<!--{!relatedTo.VirtualAccount__r.EscrowAccount__r.BankName__c}--> </td>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef')}">
                                <td>First Abu Dhabi Bank PJSC<!--{!relatedTo.VirtualAccount__r.EscrowAccount__r.BankName__c}--></td>
                            </apex:outputPanel>
                            
                            
                        </tr>
                        <tr>
                            <td  ><b>Swift Code:</b></td> 
                            
                            <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Al Naseem'}">
                                <td>{!relatedTo.VirtualAccount__r.EscrowAccount__r.SwiftCode__c}<!--{!relatedTo.VirtualAccount__r.EscrowAccount__r.SwiftCode__c}--></td>
                            </apex:outputPanel>
                            
                            <apex:outputPanel rendered="{!CONTAINS(relatedTo.ProjectName__c, 'Nawayef')}">
                                <td>{!relatedTo.VirtualAccount__r.EscrowAccount__r.SwiftCode__c}<!--{!relatedTo.VirtualAccount__r.EscrowAccount__r.SwiftCode__c}--></td>
                            </apex:outputPanel>
                            
                        </tr>
                      </tbody>
                  </table>
              </td>         
           </tr>
           
           </apex:outputPanel>

            <tr>
                <td colspan="2">
                    <br/>For more information and immediate assistance, please do not hesitate to contact us on 800-MODON (66366) or visit our Customer Management on the 20th floor of Al Maryah Tower. <a href="https://www.google.com/maps/place/Maryah+Tower/@24.49841,54.3906064,17z/data=!3m1!4b1!4m6!3m5!1s0x3e5e67acdf150f29:0x5f4ca7797b069048!8m2!3d24.49841!4d54.3906064!16s%2Fg%2F11f03pn0pd?entry=ttu&g_ep=EgoyMDI1MDQxNC4xIKXMDSoJLDEwMjExNDUzSAFQAw%3D%3D">Click here for location</a>.
                 </td>
            </tr>                    
           
            <tr>
             <tr>
                <td colspan="2">
                    <br/>
                    <b>Please ignore this email if you have already completed the payment for this instalment. </b>
                 </td>
            </tr>  
               <td>
                   <br/>Warm Regards,
                   <b>
                   <br/>Modon Customer Management
                   </b>
               </td>
            </tr>
           
           <td colspan="2" align="left">
              <apex:outputPanel rendered="{!relatedTo.ProjectName__c == 'Reem Hills'}">
                   
                   <img src="cid:88bb9c75-4a8d-4819-b7a0-12eaa6670860" style="width: 100%; height: auto; display: block;"/>
                   <!--
                       <a href="modon.com" target="_blank"><img align="center" src="https://alqudra.my.salesforce.com/servlet/servlet.FileDownload?file=015J7000000xAms" width="100%" /></a>
                       -->
                </apex:outputPanel>
                   </td>
                   
       </table>
       </body>
 
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>