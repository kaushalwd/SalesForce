<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #333333;
      background-color: #ffffff;
      margin: 0;
      padding: 0;
    }
    .container {
      padding: 20px;
    }
    .content {
      background-color: #f5f5f5;
      padding: 20px;
      border-radius: 6px;
    }
    p {
      font-size: 16px;
      line-height: 1.6;
      margin: 10px 0;
    }
    a {
      color: #0070d2;
      text-decoration: none;
    }
    .footer {
      margin-top: 30px;
      font-size: 16px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="content">
      <p>Hello {!Registration_Agent__c.Agent_First_Name__c} {!Registration_Agent__c.Agent_Last_Name__c},</p>

      <p><strong>Comments:</strong> {!Registration_Agent__c.Task_Comments_c__c}</p>

      <p>
        Please <a href="https://modonproperties--srdev.sandbox.my.site.com/Brokers">click here</a> to provide the required information.
      </p>

      <p class="footer">
        Regards,<br>
        Modon Support Team
      </p>
    </div>
  </div>
</body>
</html>