<messaging:emailTemplate subject="Interest in Modon Properties-Call Attempt" recipientType="Lead" relatedToType="Lead">
<messaging:htmlEmailBody >
    <html>
   
   
       <body>
        <table style="text-align:justify;width: 100%;">
        <tr>
            <td colspan="2">
                <apex:outputPanel >
                  <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/724783e9-c2b7-4695-aa14-b1e328552e10/1000x250.jpg" style="width: 100%; height: auto; display: block;"/>                                
                </apex:outputPanel>
            </td>
           </tr>
           <tr>
               <td colspan="2">
                      &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Dear {!relatedTo.Salutation} {!relatedTo.Name}, 
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   Thank you for registering your interest with Modon. We attempted to contact you on {!relatedTo.MobilePhone} to follow up on your inquiry regarding {!relatedTo.ProjectInterest__c}.
               </td>
           </tr>
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           <tr>
               <td colspan="2">
                   For any further assistance, please do not hesitate to reach out to us at 800-MODON (66366).
               </td>
           </tr> 
           <tr>
               <td colspan="2">
                  &nbsp;
               </td>
           </tr>
           
           <tr>
               <td>
                   <br/>Best Regards,<br/>Modon Customer Management
               </td>
           </tr>
       </table>
     </body> 
   </html>  
</messaging:htmlEmailBody>       
</messaging:emailTemplate>