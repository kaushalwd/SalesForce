<messaging:emailTemplate subject="{!relatedTo.UnitNumber__c} - Modon Connect, Collection Update" recipientType="User" relatedToType="Receipt__c">
<messaging:htmlEmailBody >
<html lang="en">
<head></head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr><td align="center">

      <!-- INNER CONTAINER -->
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background:#ffffff; border-collapse:collapse;">

        
        <!-- BODY -->
        <tr><td style="padding: 12px 32px;">
          <div style="font-family: Arial, sans-serif; font-size:16px; line-height:1.5; color:#000;">
            <p>Dear Team,</p>
            <p>The subject unit customer has completed a payment on Modon connect.</p>
            <p>Unit: {!relatedTo.UnitNumber__c}</p>
            <p>Project: {!relatedTo.ProjectName__c}</p>
            <p>SalesOrder: {!relatedTo.SalesOrder__r.Name}</p>
            <p>Milestone Description: {!relatedTo.Milestone_Description__c}</p>
            <p>Transaction Number: {!relatedTo.TransactionNumber__c}</p>
            <p>Receipt Amount: {!relatedTo.Receipt_Amount__c}</p>
            <p>This is an automated notification from the Modon Connect.</p>
            <p>Best regards,<br/>Modon</p>
          </div>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>