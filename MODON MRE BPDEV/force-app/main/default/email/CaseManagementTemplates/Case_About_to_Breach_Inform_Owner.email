<messaging:emailTemplate subject="Urgent! case {!relatedTo.CaseId__r.CaseNumber} is about to breach notification." recipientType="User" relatedToType="CaseSLA__c">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Name},</p>

<p>This is to bring to your notice that the {!relatedTo.CaseId__r.CaseType__c} {!relatedTo.CaseId__r.CaseNumber} is about to breach.</p>

<p>Case Category: {!relatedTo.CaseId__r.CaseCategory__c}</p>

<p>Case Sub Category: {!relatedTo.CaseId__r.CaseSubCategory__c}</p>

<p>Case Status: {!relatedTo.CaseId__r.Status}</p>

<p>Case SLA Status: {!relatedTo.Status__c}</p>

<p>Actual Start Date: {!relatedTo.StartTime__c}</p>

<p>Actual Due Date: {!relatedTo.DueTime__c}</p>

<p>Please review the case details and take immediate action to resolve the issue.</p>

<p>Best Regards,</p>
<p>Modon Service Team</p>
</messaging:htmlEmailBody>
</messaging:emailTemplate>