<messaging:emailTemplate subject="Case {!relatedTo.CaseNumber} is requested for team reassignment" recipientType="User" relatedToType="Case">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Name},</p>

<p>I am writing to request a Department transfer for {!relatedTo.CaseType__c} <a href="https://modonproperties.lightning.force.com//{!relatedTo.Id}">{!relatedTo.CaseNumber}</a>.</p>

<p>Please review the case details and approve the transfer request at your earliest convenience to facilitate the case closure within the SLA.</p>

<p>Best Regards,</p>
<p>Modon Service Team</p>
</messaging:htmlEmailBody>
</messaging:emailTemplate>