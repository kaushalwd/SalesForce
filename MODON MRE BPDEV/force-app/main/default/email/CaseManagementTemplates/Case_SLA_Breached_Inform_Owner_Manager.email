<messaging:emailTemplate subject="Urgent! case {!relatedTo.CaseId__r.CaseNumber} is breached" recipientType="User" relatedToType="CaseSLA__c">
<messaging:htmlEmailBody >
<p>Dear {!recipient.Manager.Name},</p>

<p>We regret to inform you that Case SLA for case  {!relatedTo.CaseId__r.CaseNumber} has breached.Below are the details.</p>

<p>Case Number: <a href="https://modonproperties.lightning.force.com//{!relatedTo.Id}"> {!relatedTo.CaseId__r.CaseNumber}</a></p>

<p>Please review the Case SLA details and take immediate action to resolve the issue.</p>

<p>Best Regards,</p>
<p>Modon Service Team</p>
</messaging:htmlEmailBody>
</messaging:emailTemplate>