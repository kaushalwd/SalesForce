<messaging:emailTemplate subject="Open Case Reminder – Case ID:{!relatedTo.CaseID__r.CaseNumber}" recipientType="User" relatedToType="CaseSLA__c">
<messaging:htmlEmailBody >
<html>

    <body align="center" style="font-family: Arial, sans-serif;">
<div align="center" style="margin:0; padding:0;">
    
    
        <!--<div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">-->
   <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Open Case Reminder</div>
  <div style="font-size: 14px;">Case ID: {!relatedTo.CaseID__r.CaseNumber}</div>
</div>
 <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
     <table style="text-align:justify;width: 100%; font:Arial">
       
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
          <td colspan="2" style="">
              Dear {!relatedTo.Owner.Name},
          </td>
       </tr>
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
        <td colspan="2" style="">
            This is a reminder email on an open case owned by you. <br/><br/>
           
            <b>Case Details:</b> <br/><br/>

            Case ID: {!relatedTo.CaseID__r.CaseNumber} <br/><br/>
            
            Case Category: {!relatedTo.CaseID__r.CaseCategory__c} <br/><br/>
                        
            Case Sub-Category: {!relatedTo.CaseID__r.CaseSubCategory__c} <br/><br/>

            Issue Reported: {!relatedTo.CaseID__r.Subject} <br/><br/>

            Received: {!relatedTo.CaseID__r.CreatedDate} <br/><br/>

            Due Date: {!relatedTo.DueTime__c} <br/><br/>

            Reqeust you to please take necessary action on the case and close it at the earliest. <br/><br/> 

        </td>
       </tr>
       
       <tr>
  <td colspan="2">
    <br/>Best regards,<br/><br/>
    <div style="color: #6e6e6e; font-size: 18px; font-weight: bold;">
       Modon Service Team
    </div>
  </td>
</tr>

     </table>
     
         
 <!--</div>-->
 </div>
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>