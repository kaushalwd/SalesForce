<messaging:emailTemplate subject="We're Still Here to Help – Next Contact Attempt Tomorrow" recipientType="Lead" relatedToType="Lead">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!recipient.FirstName},</p>

                <p style="margin: 0 0 16px 0;">We recently tried to reach you regarding your inquiry but were unable to connect.</p>

                <p style="margin: 0 0 16px 0;">To ensure you receive the support you need, our team will make another attempt to contact you tomorrow. If you prefer, you’re welcome to reach us at your convenience by calling<strong> 800 MODON</strong> or emailing <strong>customercare@modon.com</strong></p>

                <p style="margin: 0 0 16px 0;">Thank you for your patience, and we’re looking forward to speaking to you soon!</p>
                <p style="margin: 0;">Best regards,</p>
                <p style="margin: 0;"><span style="color: #666666;">Modon Real Estate</span></p>
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>