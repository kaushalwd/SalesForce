<messaging:emailTemplate subject="Let’s Stay Connected – We’re Here for You" recipientType="Lead" relatedToType="Lead">
<messaging:htmlEmailBody >
<html lang="en">
<head></head>
<body style="margin:0; padding:0; background:#ffffff;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0;padding:0;border-collapse:collapse;background:#f4f4f4;">
    <tr><td align="center">
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-collapse:collapse;">

        <!-- HEADER -->
        <tr>
          <td>
            <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png" 
                 alt="Modon Header" width="600" 
                 style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:12px 32px;">
            <div style="font-family: Arial, sans-serif; font-size:16px; line-height:1.5; color:#000;">
              <p>Dear {!recipient.FirstName},</p>
              <p>We’ve made several attempts to reach you regarding your recent inquiry but haven’t been successful in connecting yet.</p>
              <p>If you’d like to continue the conversation or have any questions, <strong>our team is always here to assist you</strong>. Feel free to contact us at 
                <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a> 
                or email <a href="mailto:customercare@modon.com" style="color:#0000EE; text-decoration:underline;">customercare@modon.com</a> at your convenience.</p>
              <p>For updates and exciting news about our latest projects, <strong>follow our official social media channels</strong> and 
                <a href="https://www.modon.com" style="color:#0000EE; text-decoration:underline;">visit our website</a>.
              </p>
              <p>We value your interest in Modon and hope to be of service whenever you need us.</p>
              <p>Best regards,<br/>Modon Real Estate</p>
            </div>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td>
            <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png" 
                 alt="Modon Footer" width="600" 
                 style="display:block;width:100%;max-width:600px;height:auto;border:0;"/>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>