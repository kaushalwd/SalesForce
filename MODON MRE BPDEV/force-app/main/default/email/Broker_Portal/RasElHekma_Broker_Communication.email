<messaging:emailTemplate subject="Invitation: Ras El Hekma Sales Event"
    recipientType="User"
    relatedToType="Contact">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  <style>
    @media only screen and (max-width: 600px) {
      .button-stack {
        display: block !important;
        width: 100% !important;
        margin-bottom: 10px !important;
      }
      .button-stack a {
        display: block !important;
        text-align: center !important;
      }
      .button-spacer {
        display: none !important;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/479ad1f5-b682-4f3b-bb73-3ec7820c8380/1200x400.jpg"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 24px 32px 8px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear Valued Partner,</p>
                <p style="margin: 0 0 16px 0;">We are now accepting client interest registrations for the Ras El Hekma sales event.</p>
 
                <p style="margin: 0 0 16px 0;"><strong>Date:</strong> 22 October 2025</p>
                <p style="margin: 0 0 16px 0;"><strong>Time:</strong> 4:00pm UAE Time</p>
                <p style="margin: 0 0 16px 0;"><strong>Venue:</strong> 
                <a href="https://maps.app.goo.gl/2csXkWeG7qrs74xYA" style="color:black"><strong>Modon Sales Centre</strong></a> </p>

                <p style="margin: 0 0 16px 0;">
                  Against a backdrop of Mediterranean turquoise, and infused with the cultural richness of Egypt, Ras El Hekma is a new city that redefines contemporary coastal life.
                </p>
                <p style="margin: 0 0 16px 0;">
                  The available typologies include 1-3 bedroom apartments, starting from AED 1.05 million, as well as 3 and 4-bedroom Lagoon Townhouses, starting from AED 2 million.
                </p>
                
                <p style="margin: 0 0 8px 0;"><strong>Downpayment:</strong> 10%</p>
                <p style="margin: 0;"><strong>Payment plan:</strong> 8 years</p>
              </div>
            </td>
          </tr>
             
          <!-- BUTTONS -->
          <tr>
            <td align="center" style="padding: 12px 32px 20px 32px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>

                  <!-- BUTTON 1 -->
                  <td align="center" class="button-stack" style="border-radius:4px; background-color:#000000; padding:12px 16px;">
                    <a href="https://modonproperties.my.site.com/Brokers" style="
                      display:inline-block;
                      font-family:Arial,sans-serif;
                      font-size:14px;
                      font-weight:bold;
                      color:#ffffff;
                      text-decoration:none;
                      line-height:20px;">
                      Registered Brokers 
                    </a>
                  </td>

                  <!-- Spacer -->
                  <td class="button-spacer" style="width:16px;"></td>

                  <!-- BUTTON 2 -->
                  <td align="center" class="button-stack" style="border-radius:4px; background-color:#ffffff; border:1px solid #000000; padding:12px 16px;">
                    <a href="https://modonproperties.my.site.com/Brokers/SelfRegister" style="
                      display:inline-block;
                      font-family:Arial,sans-serif;
                      font-size:14px;
                      font-weight:bold;
                      color:#000000;
                      text-decoration:none;
                      line-height:20px;">
                      Non Registered Brokers 
                    </a>
                  </td>

                </tr>
              </table>
            </td>
          </tr>

          <!-- FOOTER MESSAGE -->
          <tr>
            <td style="padding: 12px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Please confirm your client’s attendance to receive their QR code pass for the sales event.</p>
                <p style="margin: 0;">Best regards,</p>
                <p style="margin: 0;">Modon Real Estate</p>
              </div>
            </td>
          </tr>
          
          <!-- FOOTER IMAGE -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>