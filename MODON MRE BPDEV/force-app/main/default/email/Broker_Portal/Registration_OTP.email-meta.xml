<?xml version="1.0" encoding="UTF-8"?>
<EmailTemplate xmlns="http://soap.sforce.com/2006/04/metadata">
    <available>true</available>
    <encodingKey>UTF-8</encodingKey>
    <name>Registration OTP</name>
    <style>none</style>
    <subject>Your OTP for Registration Access</subject>
    <textOnly>&lt;html&gt;
  &lt;head&gt;
    &lt;style&gt;
      body {
        font-family: Arial, sans-serif;
        color: #333333;
        font-size: 14px;
        line-height: 1.6;
      }

      a {
        color: #0070d2;
        text-decoration: none;
      }

      p {
        margin: 0 0 10px 0;
      }

      strong {
        font-weight: bold;
      }
    &lt;/style&gt;
  &lt;/head&gt;
  &lt;body&gt;
    &lt;div style=&quot;text-align: center; background-color: #000000; padding: 25px;&quot;&gt;
      &lt;a href=&quot;https://www.modon.com/&quot; target=&quot;_blank&quot;&gt;
        &lt;img src=&quot;https://e.hypermatic.com/31d87508f022824eeb47d1ed9848648a.png&quot; alt=&quot;Modon Logo&quot; width=&quot;74&quot; /&gt;
      &lt;/a&gt;
    &lt;/div&gt;

    &lt;div style=&quot;text-align: center; width: 100%;&quot;&gt;
      &lt;img src=&quot;https://modonproperties--srdev.sandbox.my.salesforce.com/servlet/servlet.ImageServer?id=015cZ000002jNov&amp;oid=00DcZ000002Prfu&quot; alt=&quot;Email Banner&quot; width=&quot;100%&quot; /&gt;
    &lt;/div&gt;

    &lt;p&gt;Dear {!User.FirstName},&lt;/p&gt;

    &lt;p&gt;We are delighted to inform you, the broker portal is now open for registering your clients.&lt;/p&gt;

    &lt;p&gt;Your username is: &lt;strong&gt;{!User.Username}&lt;/strong&gt;&lt;/p&gt;

    &lt;p&gt;You can set your password and login to Modon portal &lt;a href=&quot;{!$Network.NetworkURLForUserEmails}&quot;&gt;here&lt;/a&gt;.&lt;/p&gt;

    &lt;p&gt;Regards,&lt;/p&gt;
    &lt;p&gt;Modon Sales&lt;/p&gt;
  &lt;/body&gt;
&lt;/html&gt;</textOnly>
    <type>custom</type>
    <uiType>Aloha</uiType>
</EmailTemplate>
