<messaging:emailTemplate subject="Your Inquiry Has Been Received : {!relatedTo.CaseNumber}"
recipientType="User"
relatedToType="Case">
<messaging:htmlEmailBody >
<html lang="en">
<head>
<meta charset="UTF-8"></meta>
<style type="text/css">
  /* RESET STYLES */
  body, table, td, a {
    -webkit-text-size-adjust:100%;
    -ms-text-size-adjust:100%;
  }
  table, td {
    mso-table-lspace:0pt;
    mso-table-rspace:0pt;
  }
  img {
    -ms-interpolation-mode:bicubic;
  }
  body {
    margin:0;
    padding:0;
    width:100% !important;
    height:100% !important;
  }
  /* MOBILE RESPONSIVE */
  @media only screen and (max-width:600px) {
    .container { width:100% !important; }
    .stack-column { display:block !important; width:100% !important; max-width:100% !important; }
    .footer-left td img { width:16px !important; height:16px !important; }
    .footer-left td { font-size:10px !important; line-height:14px !important; }
    .footer-right img { width:80px !important; height:14px !important; }
    .footer-container { padding:8px 8px !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background:#f4f4f4;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://github.com/Nibraz999/sendgridemo/blob/main/Modon_ADNOC_Koysk_EDM%20Header%20-%20Footer_SH_V01(High)-01.jpg?raw=true"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          <tr>
            <td style="padding:14px 32px;">
              <div style="font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">

                <p style="margin:0 0 16px;">Dear {!relatedTo.Requestor_Name__c},</p>

                <p style="margin:0 0 16px;">
                  Thank you for contacting Modon. Your inquiry has been received and a service request has been created for priority handling.</p>

                <p style="margin:0 0 8px;"><strong>Service Request ID:</strong> {!relatedTo.CaseNumber}</p>
                <p style="margin:0 0 8px;"><strong>Service Category:</strong> {!relatedTo.CaseCategory__c}</p>
                <p style="margin:0 0 8px;"><strong>Service Description:</strong> {!relatedTo.Subject}</p>
                <p style="margin:0 0 16px;"><strong>Date Received:</strong> 
                <apex:outputText value="{0,date,dd MMM yyyy hh:mm:ss a}">
                        <apex:param value="{!relatedTo.EmailCaseCreateDate__c}"/>
                </apex:outputText></p>
           
                <p style="margin:0 0 16px;">Our customer care team is reviewing your request and will get back to you with an update shortly.</p>
                <p style="margin:0 0 8px;">Should you have any urgent questions or need immediate assistance, please contact us at <a href="mailto:customercare@modon.com" style="color:#000000; text-decoration:underline;">
                  <b>customercare@modon.com</b>
                  </a> or via our toll-free number <a href="tel:80066366" style="color:#000000; text-decoration:underline;">
                  <b>800 MODON (800-66366)</b>
                  </a></p>

              </div>
            </td>
          </tr>

          <!-- ICONS SECTION -->
          <tr>
            <td bgcolor="#ffffff" style="padding:24px 16px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>

                  <!-- LOCATION -->
                  <td class="stack-column" width="33.33%" valign="top" align="center" style="padding:16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-bottom:12px;">
                          <img src="https://github.com/Nibraz999/sendgridemo/blob/main/Location.png?raw=true" width="42" alt="Location" 
                          style="display:block; border:0;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family:Arial, Helvetica, sans-serif;">
                          <p style="margin:0 0 6px; font-size:13px; font-weight:bold; color:#000000;">Location</p>
                          <p style="margin:0; font-size:12px; line-height:1.5; color:#555555;">
                            20th floor, Al Maryah Tower, Maryah Island. 
                            For directions,<a href="https://maps.app.goo.gl/XCGzac4XWnShkx3H7" style="color:#000000; text-decoration:underline;"><b> please click here</b></a>
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>

                  <!-- WORKING HOURS -->
                  <td class="stack-column" width="33.33%" valign="top" align="center" style="padding:16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-bottom:12px;">
                          <img src="https://github.com/Nibraz999/sendgridemo/blob/main/Working%20hours.png?raw=true" width="42" 
                          alt="Working Hours" style="display:block; border:0;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family:Arial, Helvetica, sans-serif;">
                          <p style="margin:0 0 6px; font-size:13px; font-weight:bold; color:#000000;">Working Hours</p>
                          <p style="margin:0; font-size:12px; line-height:1.5; color:#555555;">Monday to Friday</p>
                          <p style="margin:0; font-size:12px; line-height:1.5; color:#555555;">8:00am – 5:00pm</p>
                        </td>
                      </tr>
                    </table>
                  </td>

                  <!-- PARKING -->
                  <td class="stack-column" width="33.33%" valign="top" align="center" style="padding:16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-bottom:12px;">
                          <img src="https://github.com/Nibraz999/sendgridemo/blob/main/Car%20parking.png?raw=true" width="42" 
                          alt="Parking" style="display:block; border:0;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family:Arial, Helvetica, sans-serif;">
                          <p style="margin:0 0 6px; font-size:13px; font-weight:bold; color:#000000;">Parking</p>
                          <p style="margin:0; font-size:12px; line-height:1.5; color:#555555;">
                            Customer parking is available at The Galleria Mall. Closest parking zone is Zone A. Please use the skywalk bridge near Jysk Store.
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>

                </tr>
              </table>
            </td>
          </tr>

          <!-- SIGNATURE -->
          <tr>
            <td style="padding:14px 32px;">
              <div style="font-family:Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">
                <p style="margin:0 0 8px;">Thank you for your trust and for choosing Modon.</p>
                <p style="margin:0;">Best regards,</p>
                <p style="margin:0;"><strong>Modon</strong></p>
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <table bgcolor="#000" border="0" cellpadding="0" cellspacing="0" style="background-color:#000; width:100%; margin:0; padding:0;" width="100%">
                <tr>
                  <td align="center">
                    <table border="0" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; padding:8px 16px;" width="100%">
                      <tr>
                        <!-- LEFT COLUMN: Text + Social Icons -->
                        <td class="footer-left" align="left" style="font-family:Arial, sans-serif; font-size:11px; color:#fff; line-height:16px; padding-bottom:8px; width:70%;" valign="top">
                          <p style="margin:0 0 4px;;">FOLLOW US ON SOCIAL MEDIA</p>
                          <table align="left" border="0" cellpadding="0" cellspacing="0" style="margin-top:4px;">
                            <tr>
                              <td style="padding-right:6px;">
                                <a href="https://www.linkedin.com/company/modon" target="_blank">
                                  <img height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/linkedin.png?raw=true" style="display:block; border:0;" width="20"/>
                                </a>
                              </td>
                              <td style="padding-right:6px;">
                                <a href="h https://www.instagram.com/modonproperties" target="_blank">
                                  <img height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/insta.png?raw=true" style="display:block; border:0;" width="20"/>
                                </a>
                              </td>
                              <td style="padding-right:6px;">
                                <a href="hhttps://x.com/ModonProperties" target="_blank">
                                  <img height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/twitter.png?raw=true" style="display:block; border:0;" width="20"/>
                                </a>
                              </td>
                              <td style="padding-right:6px;">
                                <a href="https://www.facebook.com/modonproperties" target="_blank">
                                  <img height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/fb_icon.png?raw=true" style="display:block; border:0;" width="20"/>
                                </a>
                              </td>
                              <td style="padding-right:6px;">
                                <a href="https://www.youtube.com/@ModonRealEstate-n9p" target="_blank">
                                  <img height="20" src="https://github.com/Nibraz999/sendgridemo/blob/main/youtube.png?raw=true" style="display:block; border:0;" width="20"/>
                                </a>
                              </td>
                              
                            </tr>
                          </table>
                        </td>
                        <!-- RIGHT COLUMN: Modon Logo -->
                        <td class="footer-right" align="right" style="padding-left:16px; width:30%;" valign="middle">
                          <img height="18" src="https://github.com/Nibraz999/sendgridemo/blob/main/MODON%20LOGO_White%201.png?raw=true" style="display:block; border:0; line-height:18px;" width="100"/>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->

      </td>
    </tr>
  </table>

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>