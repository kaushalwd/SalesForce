<messaging:emailTemplate subject="Set Up Your Access to the Modon Customer Portal"
    recipientType="User">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#ffffff;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%;  border-collapse:collapse; background:#ffffff;">

          <!-- HEADER (no padding on the image cell) -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%;  height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          <tr>
                <td style="padding: 16px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 16px 0;">Dear {!recipient.FirstName} {!recipient.LastName},</p>
                        <p style="margin: 0 0 16px 0;">As a valued member of our team and customer community, we are excited to extend to you exclusive priority access to the new Modon Customer Portal before its public launch.</p>
                        <p style="margin: 0 0 16px 0;">You can now experience firsthand the next evolution in our customer service and help us refine it to meet the highest standards. Your unique insights are incredibly valuable in ensuring we deliver an exceptional portal for everyone.</p>
                        <p style="margin: 0; font-weight: bold;">Through the Modon Customer Portal, you can now:</p>
                    </div>
                </td>
            </tr>

            <tr>
              <td style="padding: 16px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%">
                  <tr>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/87daf293-e7d2-42f9-a3c9-e14a995cf7c7/512x512.png" 
                                 alt="Virtual Tour" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            Virtual Tour
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            Take a tour of your property
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/3181c5e5-b34d-41f9-bf89-e89298e884a3/512x512.png" 
                                 alt="Property Details" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            Property Details
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            View full property info
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/df16ba08-a25b-43da-8547-4321064289bf/128x128.png" 
                                 alt="Payments" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            Payments
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            Track due dates
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding: 16px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%">
                  <tr>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/6df2697f-e1b1-4d4d-bdac-035ac05c5d43/128x128.png" 
                                 alt="SOA Statements" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            SOA Statements
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            View latest Statement of Account
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0436a2c4-2d18-47b3-8fa8-728343210d63/128x128.png" 
                                 alt="SPA Agreements" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            SPA Agreements
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            Access and download agreements
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="200" align="center" valign="top" style="padding: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr>
                          <td align="center" style="padding-bottom: 8px;">
                            <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/7f2c9673-7c07-4271-b0f1-9ab737841f38/128x128.png" 
                                 alt="Service Requests" 
                                 width="44" 
                                 style="display:block; margin:0 auto;" />
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                            Service Requests
                          </td>
                        </tr>
                        <tr>
                          <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                            Raise and monitor services
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
                <td style="padding: 16px 32px;">
                    <div style="height: 1px; background-color: #cccccc; width: 100%;"></div>
                </td>
            </tr>

            <tr>
                <td style="padding: 16px 32px 32px 32px;">
                    <h2 style="font-family: Inter, Arial, sans-serif; font-weight: bold; font-size: 16px; line-height: 1.14; color: #000000; margin: 0 0 16px 0;">
                        How to Access the Portal
                    </h2>
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 8px 0;">To log in:</p>
                        <ol style="margin: 0; padding-left: 24px;">
                            <li style="margin-bottom: 8px;">
                                Visit <a href="https://www.modon.com" style="color: #000000; text-decoration: underline; font-weight: bold;">www.modon.com</a>
                            </li>
                            <li style="margin-bottom: 8px;">
                                Click the <strong>Login</strong> button at the <strong>top right</strong> of the homepage
                            </li>
                            <li>
                                You will be required to <strong>set up your credentials for the first time</strong>
                            </li>
                        </ol>
                    </div>
                </td>
            </tr>

             <tr>
<td align="center" style="padding: 16px;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
<tbody><tr>
<td bgcolor="#000000" align="center" style="border-radius:4px;background-color: #000000;height: 20px;padding: 12px 22px;">
<a href="https://cportal.modon.com/createpassword/{!recipient.EmailBase64String__c}" style="
                                        display:inline-block;
                                        font-family:Arial,sans-serif;
                                        font-size:14px;
                                        font-weight:bold;
                                        color:#ffffff;
                                        text-decoration:none;
                                        line-height:20px;
                                        ">
                                Click here to set up your credentials →
</a>
</td>
</tr>
</tbody></table>
</td>
</tr>

            <tr>
                <td style="padding: 16px 32px;">
                    <p style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000; margin: 0;">
                        You will be prompted to validate your identity using a <strong>One-Time Password (OTP)</strong> sent to your <strong>registered mobile number</strong>. Once verified, you can set your password and access the portal.
                    </p>
                </td>
            </tr>

            <tr>
                <td style="padding: 16px 32px;">
                    <div style="height: 1px; background-color: #cccccc; width: 100%;"></div>
                </td>
            </tr>

            <tr>
                <td style="padding: 16px 32px;">
                    <h2 style="font-family: Inter, Arial, sans-serif; font-weight: bold; font-size: 16px; line-height: 1.14; color: #000000; margin: 0 0 16px 0;">
                        Need Help Logging In?
                    </h2>
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 16px 0;">
                            If you face any issues during login or credential setup, feel write to contact us at 
                            <a href="mailto:ithelpdesk@modon.com" style="color: #000000; text-decoration: underline;">Ithelpdesk@modon.com</a> / call 800-Modon (800-66366)
                        </p>
                        <p style="margin: 0 0 16px 0;">
                            We please ask you to share your feedback, suggestions, or report any issues directly to us at 
                            <a href="mailto:betatest@modon.com" style="color: #000000; text-decoration: underline;">betatest@modon.com</a>. Your input will be instrumental in enhancing the experience for all our customers.
                        </p>
                        <p style="margin: 0 0 16px 0;">Thank you in advance for your participation and support!</p>
                        <p style="margin: 0;">
                            Best regards,<br/>
                            Modon Real Estate
                        </p>
                    </div>
                </td>
            </tr>

          <!-- FOOTER (also inside the same 600px container; no padding on image cell) -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>