<messaging:emailTemplate subject="Action required – sign your Sales Purchase Agreement for {!relatedTo.ProjectName__c} (Unit[{!relatedTo.UnitName__c}]) " recipientType="User" relatedToType="SPAReminders__c">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER (no padding on the image cell) -->
          
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
            <tr>
                <td style="padding: 12px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 16px 0;">Dear {!relatedTo.CustomerName__c},</p>
                        <p style="margin: 0 0 16px 0;">We noticed that the Sales Purchase Agreement (SPA) for your {!relatedTo.ProjectName__c} (Unit[{!relatedTo.UnitName__c}]) has not yet been signed. Please take a moment to review and sign the document through the link below:</p>
                       
                    </div>
                </td>
            </tr>
            
            <!-- BUTTON -->
          <tr>
            <td align="center" style="padding: 10px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td bgcolor="#000000" align="center" style="border-radius:4px;background-color: #000000;height: 20px;padding: 12px 16px;">
                    <a href="{!relatedTo.WhatsappURL__c}" style="
                        display:inline-block;
                        font-family:Arial,sans-serif;
                        font-size:14px;
                        font-weight:bold;
                        color:#ffffff;
                        text-decoration:none;
                        line-height:20px;
                        ">
                       Click here
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- BODY CONTENT -->
            <tr>
                <td style="padding: 14px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        
                        <p style="margin: 0 0 16px 0;">
                        <span style="white-space: nowrap; font-weight: bold;">*For your security, do not forward the link.* </span> </p>
                        <p style="margin: 0 0 16px 0;">If you have any questions or require assistance, please contact us on <strong>800 MODON (80066366) or <a href="url" style="color:black">customercare@modon.com</a></strong>.</p>
                      <p style="margin: 0 0 16px 0;">Thank you for your prompt attention to this matter.</p>
                       <p style="margin: 0;"> Kind regards,
                            
                           
                        </p>
                        <p style="margin: 0;"> 
                            Modon
                           
                        </p>
                        
                        
                    </div>
                </td>
            </tr>
          
          <!-- FOOTER (also inside the same 600px container; no padding on image cell) -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>