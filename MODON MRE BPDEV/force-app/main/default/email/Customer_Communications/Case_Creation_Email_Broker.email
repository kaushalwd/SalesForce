<messaging:emailTemplate subject="Case Creation Confirmation – Case ID:{!relatedTo.CaseNumber}" recipientType="User" relatedToType="Case">
<messaging:htmlEmailBody >
<html>
<body  style="font-family: Arial, sans-serif;">

    <!--<div style="text-align: center;"> -->
          <!-- <img src="{!URLFOR($Resource.CustomerCommunitcationHeader)}" style="width: 100%; height: auto; display: block;" />-->
          <!--<img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>
        </div>-->
        
     <!-- MODON Header -->
    <div style="background-color: #000000; height: 50px; display: flex; align-items: center; padding-left: 20px;">
      <img src="{!$Label.Customer_Communication_Modon_Logo}"
           alt="MODON Logo"
           style="height: 18px; width: auto;" />
    </div>
           
        <!--<div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">-->
   <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Case Creation Confirmation</div>
  <div style="font-size: 14px;">Case ID: {!relatedTo.CaseNumber}</div>
</div>
 <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
     <table style="text-align:justify;width: 100%; font:Arial">
       
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
          <td colspan="2" style="">
              Dear {!relatedTo.Requestor_Name__c},
          </td>
       </tr>
       <tr>
         <td colspan="2">
            &nbsp;
         </td>
       </tr>
       <tr>
        <td colspan="2" style="">
            Thank you for reaching out to Modon. We have received your request, and a new case has been created for your inquiry. <br/><br/>
           
            <b>Case Details:</b> <br/><br/>

            Case ID: {!relatedTo.CaseNumber} <br/><br/>
            
            Case Status: {!relatedTo.Status} <br/><br/>
            
            Expected response/resolution time: <br/><br/>

            Issue Reported: {!relatedTo.Description} <br/><br/>

            Received:     <apex:outputText value="{0,date,dd MMM yyyy hh:mm a z}">
        <apex:param value="{!relatedTo.CreatedDate}"/>
    </apex:outputText> <br/><br/>



            Assigned representative: {!relatedTo.New_Owner_Name__c} <br/><br/>

            Our team is reviewing your request, and we will provide an update as soon as possible. <br/><br/> 

            For any urgent concerns, please feel free to reach out to us at <a href="mailto:customercare@modon.com">customercare@modon.com</a> or <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a>.<br/><br/>



            Thank you for your patience and for choosing Modon.
        </td>
       </tr>
       <!--<tr>
         <td colspan="2" style="">
           <br/>Best regards,<br/><br/><b>Customer Management Team</b>
         </td>
       </tr>  -->   
       
       <tr>
  <td colspan="2">
    <br/>Best regards,<br/><br/>
    <div style="color: #6e6e6e; font-size: 18px; font-weight: bold;">
       Customer Management Team
    </div>
  </td>
</tr>

     </table>
     
      <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
  <a><b> modon.com</b></a>
  <!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
         
 <!--</div>-->
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>