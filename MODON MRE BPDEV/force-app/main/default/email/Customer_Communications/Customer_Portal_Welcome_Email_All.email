<messaging:emailTemplate subject="Set Up Your Access to the Modon Customer Portal"
    recipientType="User"
    relatedToType="UserAccess__c">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#f4f4f4;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:24px 0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!recipient.FirstName} {!recipient.LastName},</p>
                <p style="margin: 0 0 16px 0;">We are excited to announce the launch of the Modon Customer Portal, a new digital platform designed to give you direct, secure access to all your key information and services – anytime, anywhere.</p>
                
                <p style="margin: 0; font-weight: bold;">Through the Modon Customer Portal, you can now:</p>
              </div>
            </td>
          </tr>

          <!-- ICON ROW 1 -->
          <tr>
            <td style="padding: 16px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/1c295fe1-48c4-487d-95b0-377388861bb5/181x181.png" 
                               alt="Virtual Tour" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Virtual Tour
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Take a tour of your property
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/26a2e23c-6f9e-47f8-9a25-3effea90c4d6/180x181.png" 
                               alt="Property Details" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Property Details
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          View full property info
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/c5e3e62b-268e-4e3d-9082-188238a20763/181x181.png" 
                               alt="Payments" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Payments
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Track due dates
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ICON ROW 2 -->
          <tr>
            <td style="padding: 16px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/e3eaf73c-71a6-47eb-bbed-6362c15ac801/181x181.png" 
                               alt="SOA Statements" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          SOA Statements
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          View latest Statement of Account
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/68344725-0e7e-4f51-9065-fde8e5fee85e/180x181.png" 
                               alt="SPA Agreements" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          SPA Agreements
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Access and download agreements
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/46786fd5-9212-4e3d-9f01-a765e089c0b1/181x181.png" 
                               alt="Service Requests" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Service Requests
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Raise and monitor services
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- DIVIDER -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="height: 1px; background-color: #cccccc; width: 100%;"></div>
            </td>
          </tr>

          <!-- HOW TO ACCESS -->
          <tr>
            <td style="padding: 12px 12px 12px 32px;">
              <h2 style="font-family: Inter, Arial, sans-serif; font-weight: bold; font-size: 16px; line-height: 1.14; color: #000000; margin: 0 0 16px 0;">
                How to Access the Portal
              </h2>
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 8px 0;">To log in:</p>
                <ol style="margin: 0; padding-left: 24px;">
                  <li style="margin-bottom: 8px;">
                    Visit <a href="https://www.modon.com" style="color: #000000; text-decoration: underline; font-weight: bold;">www.modon.com</a>
                  </li>
                  <li style="margin-bottom: 8px;">
                    Click the <strong>Login</strong> button at the <strong>top right</strong> of the homepage
                  </li>
                  <li>
                    You will be required to <strong>set up your credentials for the first time</strong>
                  </li>
                </ol>
              </div>
            </td>
          </tr>

          <!-- CTA BUTTON -->
          <tr>
            <td align="center" style="padding: 16px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td bgcolor="#000000" align="center" style="border-radius:4px;background-color: #000000;height: 20px;padding: 12px 22px;">
                    <a href="https://cportal.modon.com/createpassword/{!relatedTo.EmailBase64String__c}" style="
                          display:inline-block;
                          font-family:Arial,sans-serif;
                          font-size:14px;
                          font-weight:bold;
                          color:#ffffff;
                          text-decoration:none;
                          line-height:20px;">
                      Click here to set up your credentials →
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- OTP INFO -->
          <tr>
            <td style="padding: 16px 32px;">
              <p style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000; margin: 0;">
                You will be prompted to validate your identity using a <strong>One-Time Password (OTP)</strong> sent to your <strong>registered mobile number</strong>. Once verified, you can set your password and access the portal.
              </p>
            </td>
          </tr>

          <!-- DIVIDER -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="height: 1px; background-color: #cccccc; width: 100%;"></div>
            </td>
          </tr>

          <!-- HELP SECTION -->
          <tr>
            <td style="padding: 16px 32px;">
              <h2 style="font-family: Inter, Arial, sans-serif; font-weight: bold; font-size: 16px; line-height: 1.14; color: #000000; margin: 0 0 16px 0;">
                Need Help Logging In?
              </h2>
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">
                  If you face any issues during login or credential setup, feel free to contact us at 
                  <a href="mailto:ithelpdesk@modon.com" style="color: #000000; text-decoration: underline;">ithelpdesk@modon.com</a> / call 800-Modon (800-66366)
                </p>
                <p style="margin: 0 0 16px 0;">
                  We are committed to providing you with a seamless, transparent, and efficient customer experience. The Modon Customer Portal is another step forward in serving you better.
                </p>
                <p style="margin: 0 0 16px 0;">Thank you for being a valued member of the Modon community.</p>
                <p style="margin: 0;">
                  Best regards,<br/>
                  Modon Real Estate
                </p>
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>