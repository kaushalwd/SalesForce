<messaging:emailTemplate subject="Updated Details – Ras El Hekma Sales Launch"
    recipientType="User"
    relatedToType="Contact">
<messaging:htmlEmailBody >
<html lang="en">
<head>
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/479ad1f5-b682-4f3b-bb73-3ec7820c8380/1200x400.jpg"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 24px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear Valued Customer,</p>
                <p style="margin: 0 0 16px 0;">We are pleased to share the updated details for the<i> Ras El Hekma Sales Launch,</i>  taking place this afternoon.</p>
                <p style="margin: 0 0 16px 0;">Ras El Hekma, Egypt is a landmark coastal destination designed to redefine contemporary living along the Mediterranean.</p>
 
                <p style="margin: 0 0 16px 0;"><strong>Date:</strong> 22 October 2025</p>
                <p style="margin: 0 0 16px 0;"><strong>Time:</strong> 4:00pm (UAE Time)</p>
                <p style="margin: 0 0 16px 0;"><strong>Venue:</strong> 
                <a href="https://maps.app.goo.gl/HSC1oCZPX9NgyJVH8" style="color:black"><strong>Modon Sales Centre</strong></a> </p>

                <p style="margin: 0 0 16px 0;">
                  The available typologies include one to three-bedroom apartments, starting from<strong> AED 1.05 million,</strong> as well as three and four-bedroom Lagoon Townhouses, starting from <strong>AED 2.8 million.</strong>
                </p>
                

                <p style="margin: 0 0 16px 0;"><strong>Downpayment:</strong> 10%</p>
                <p style="margin: 0 0 16px 0;"><strong>Payment plan:</strong> 8 years</p>
                <p style="margin: 0 0 6px 0;">If you have not registered your interest yet, please <strong>click below:</strong></p>
              </div>
            </td>
          </tr>
          <!-- BUTTON -->
          <tr>
            <td align="center" style="padding: 10px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td bgcolor="#000000" align="center" style="border-radius:4px;background-color: #000000;height: 20px;padding: 12px 16px;">
                    <a href="https://rehinvite.modon.com" style="
                        display:inline-block;
                        font-family:Arial,sans-serif;
                        font-size:14px;
                        font-weight:bold;
                        color:#ffffff;
                        text-decoration:none;
                        line-height:20px;">
                       Register your interest →
                    </a>
                  </td>
                </tr>
              </table>
              
            </td>
          </tr>
          <tr>
            <td style="padding: 14px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">

                <p style="margin: 0 0 16px 0;">We look forward to welcoming you later today and sharing more about this exceptional new destination.</p>
                  <p style="margin: 0;"> Best regards,
                            
                           
                        </p>
                        <p style="margin: 0;"> 
                          <strong>Modon Real Estate</strong>
                           
                        </p>
             
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>