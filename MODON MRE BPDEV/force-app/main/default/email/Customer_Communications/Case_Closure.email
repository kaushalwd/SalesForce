<messaging:emailTemplate subject="Service Request Closure Confirmation – Service Request ID:{!relatedTo.CaseNumber}"
    recipientType="User"
    relatedToType="Case">
<messaging:htmlEmailBody >
<html lang="en">
<head>
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
         style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://github.com/Nibraz999/sendgridemo/blob/main/Modon_ADNOC_Koysk_EDM%20Header%20-%20Footer_SH_V01(High)-01.jpg?raw=true"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          <tr>
            <td style="padding:14px 32px;">
              <div style="font-family: Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">
                <p style="margin: 0 0 16px 0;">Dear {!relatedTo.Requestor_Name__c},</p>
                
                <p style="margin:0 0 16px 0;">We are reaching out to inform you that the case you raised with us, Case ID: {!relatedTo.CaseNumber}, has been successfully resolved and is now closed.</p>

                <p style="margin:0 0 16px 0;text-decoration:underline;"><strong>Case Details:</strong> </p>
                <p style="margin:0 0 16px 0;"><strong>• Issue Reported:</strong> {!relatedTo.Subject}</p>
                <p style="margin:0 0 16px 0;"><strong>• Resolution Provided:</strong> {!relatedTo.Resolution_Comments__c}</p>
                <p style="margin:0 0 16px 0;"><strong>• Closure Date: </strong>
                <apex:outputText value="{0,date,dd MMM yyyy hh:mm:ss a}">
                        <apex:param value="{!relatedTo.EmailCaseClosedDate__c}"/>
                </apex:outputText> 
                </p>
                <p style="margin:0 0 16px 0;">If you have any further questions or require additional assistance, please feel free to reach out to us at 
                <a href="mailto:customercare@modon.com" style="color: #0000EE; text-decoration: underline; font-weight: bold;">customercare@modon.com</a> or call <a href="tel:80066366" style="color:#0000EE; text-decoration:underline; font-weight: bold;">800-Modon (800-66366)</a></p>
                <p style="margin:0 0 16px 0;">Should you need to reopen this case or raise a new concern, we are here to assist you.</p>
                <p style="margin:0 0 16px 0;">Thank you for your time and for choosing Modon.</p>
                <p style="margin:0 0 16px 0;">Please take a moment to share your feedback through this short survey:</p>

                

              </div>
            </td>
          </tr>
           <!-- BUTTON -->
          <tr>
            <td align="center" style="padding: 8px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td align="center" bgcolor="#000000" style="border-radius:4px;background-color:#000000;padding:12px 16px;">
                      <a href="{!relatedTo.SurveyLink__c}"
                         target="_blank"
                         style="
                           display:block;
                           font-family:Arial,sans-serif;
                           font-size:14px;
                           font-weight:bold;
                           color:#ffffff !important;
                           mso-style-textfill-color:#ffffff;
                           text-decoration:none;
                           line-height:1.5;
                         ">
                       <span style="color:#ffffff !important; mso-style-textfill-color:#ffffff; margin:0 0 16px 0;">
                        <strong>Start Survey</strong>
                      </span>
                      </a>
                    </td>
                </tr>
              </table>
            </td>
          </tr>
                    <!-- BODY CONTENT -->
          <tr>
            <td style="padding:14px 32px;">
              <div style="font-family: Arial, sans-serif; font-size:16px; line-height:1.5; color:#000000;">

                <p style="margin:0;">Best regards,</p>
                <p style="margin:0;"><strong>Modon</strong></p>

              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->

      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>