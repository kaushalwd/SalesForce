<messaging:emailTemplate subject="Your Inquiry Has Been Received : {!relatedTo.CaseNumber}"
    recipientType="User"
    relatedToType="Case">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#ffffff;">
    <tr>
      <td align="center">

        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!relatedTo.Requestor_Name__c},</p>

                <p style="margin: 0 0 16px 0;">Thank you for reaching out to Modon and for bringing your concern to our attention. We sincerely regret any inconvenience you may have experienced and appreciate you giving us the opportunity to address the matter.</p>
                
                <p style="margin: 0 0 16px 0;">We have successfully registered your complaint, and a dedicated Service Request has been created to ensure it is reviewed and resolved with priority and care.</p>

                <ul style="margin: 15px 0; padding-left: 20px;">
                  <li style="margin-bottom: 5px;"><strong>Service Request ID:</strong> {!relatedTo.CaseNumber}</li>
                  <li style="margin-bottom: 5px;"><strong>Issue Reported:</strong> {!relatedTo.Subject}</li>
                  <li style="margin-bottom: 5px;">
    <!--<strong>Date Received:</strong>
    <apex:outputText value="{0,date,dd MMM yyyy hh:mm a z}">
        <apex:param value="{!relatedTo.CreatedDate}"/>
    </apex:outputText>-->
        <p style="margin:0 0 16px;"><strong>Date Received:</strong> 
                <apex:outputText value="{0,date,dd MMM yyyy hh:mm:ss a z}">
                        <apex:param value="{!relatedTo.CreatedDate}"/>
                </apex:outputText></p>
</li>
                </ul>

                <p style="margin: 0 0 16px 0;">Our customer care team is actively reviewing your complaint and will conduct a thorough assessment to understand the issue and determine the appropriate resolution. We are committed to keeping you informed and will share an update with you at the earliest possible time.</p>

                <p style="margin: 0 0 16px 0;">If you require immediate assistance or would like to provide additional information, please contact us at <a href="mailto:customercare@modon.com" style="color: #3651A3; text-decoration: underline; font-weight: bold;">customercare@modon.com</a> or via our toll-free number <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a></p>

                <p style="margin: 0 0 16px 0;">We truly value your feedback, as it helps us improve our services. Thank you for your patience and for allowing us the opportunity to make this right.</p>
                <p style="margin: 0;">Warm regards,</p>
                <p style="margin: 0;"><span style="color: #666666;">Modon Customer Management</span></p>
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>