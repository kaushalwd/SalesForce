<messaging:emailTemplate subject="Property Transfer Completed - Case ID:{!relatedTo.CaseId__r.CaseNumber}" recipientType="User" relatedToType="ServiceRequest__c">
<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif;">
  <div style="text-align: center;">
          <!-- <img src="{!URLFOR($Resource.CustomerCommunitcationHeader)}" style="width: 100%; height: auto; display: block;" />-->
          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>

        </div>
        <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Property Transfer Completed</div>
  <div style="font-size: 14px;">Case ID: {!relatedTo.CaseId__r.CaseNumber}</div>
</div>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">

           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear {!relatedTo.AccountId__r.Name} ,
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
            
                We are pleased to inform you that your <b>Property Transfer</b> request has been successfully completed. <br/><br/>

                <u><b>Case Details:</b></u> <br/><br/>

                <b>Case ID:</b> {!relatedTo.CaseId__r.CaseNumber} <br/><br/>

                <b>Service Completed:</b> Property Transfer <br/><br/>

                <b>Completion Date:</b> {!relatedTo.CloseDate__c}<br/><br/>
                           

                Should you require any further assistance or have any questions, please feel free to reach out to us at <a href="mailto:customercare@modon.com">customercare@modon.com</a> or 800-MODON.   <br/><br/>


                Thank you for choosing Modon. We appreciate your trust in Modon's services.   <br/><br/>
                
                
                Please take a moment to share your feedback through this short survey:  <a href="{SurveyLink__c}">{SurveyLink__c}</a> <br/><br/>             

 
            </td>
           </tr>
           <tr>
             <td colspan="2" style="">
               <br/>Best regards,<br/><br/><b>Modon Customer Management</b>
             </td>
           </tr>        
         </table>
             
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>