<messaging:emailTemplate subject="Important Update: Reem Hills Show Villa – Maintenance Scheduled"
    recipientType="User"
    relatedToType="Contact">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER (no padding on the image cell) -->
          
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
            <tr>
                <td style="padding: 12px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        <p style="margin: 0 0 16px 0;">Dear Valued Customer,</p>
                        <p style="margin: 0 0 16px 0;">We would like to inform you that the Reem Hills show villa will undergo essential maintenance on<strong> Thursday, 29 October.</strong> As a result, visits to the show villa on this date will not be possible.</p>
                      <p style="margin: 0 0 16px 0;">We apologise for any inconvenience and kindly ask that you reschedule your appointment at a time that suits you. Please use the link below to rebook your visit:</p>
                       
                    </div>
                </td>
            </tr>
            
            <!-- BUTTON -->
          <tr>
            <td align="center" style="padding: 10px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td bgcolor="#000000" align="center" style="border-radius:4px;background-color: #000000;height: 16px;padding: 12px 16px;">
                    <a href="https://www.modon.com/real-estate/events/reem-hills-show-villa" style="
                        display:inline-block;
                        font-family:Arial,sans-serif;
                        font-size:14px;
                        font-weight:bold;
                        color:#ffffff;
                        text-decoration:none;
                        line-height:1.5;
                        ">
                       Reem Hills Show Villa →
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- BODY CONTENT -->
            <tr>
                <td style="padding: 14px 32px;">
                    <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                        
                        <p style="margin: 0 0 16px 0;">Thank you for you</p>
                       <p style="margin: 0;"> Best regards,
                            
                           
                        </p>
                        <p style="margin: 0;"> 
                            Modon Real Estate
                           
                        </p>
                        
                        
                    </div>
                </td>
            </tr>
          
          <!-- FOOTER (also inside the same 600px container; no padding on image cell) -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>