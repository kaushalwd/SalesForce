<messaging:emailTemplate subject="Follow-Up on Pending DocuSign Signature – Service Request ID: {!relatedTo.CaseNumber}"
    recipientType="User"
    relatedToType="Case">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:0; border-collapse:collapse; background:#ffffff;">
    <tr>
      <td align="center">                          
        <!-- INNER CONTAINER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">
          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>
          <!-- BODY -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!relatedTo.Requestor_Name__c},</p>
                <p style="margin: 0 0 16px 0;">As part of our ongoing commitment to your experience, we would like to gently remind you that your DocuSign document is still pending signature. We have sent three previous reminders, and our aim is simply to ensure there are no obstacles preventing you from completing this step.</p>

                <p style="margin: 0 0 16px 0;">To make things easier, a dedicated Service Request has already been created. One of our representatives will be in touch soon to offer any assistance you may need.</p>

                <p style="margin: 0 0 16px 0;">If you would like immediate help or have any specific questions, please feel free to contact us directly at <a href="mailto:customercare@modon.com" style="color: #3651A3; text-decoration: underline; font-weight: bold;">customercare@modon.com</a> or call our toll-free number <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a>.</p>

                <p style="margin: 0 0 16px 0;">Thank you for your attention to this matter and for your continued trust in Modon.</p>
                <p style="margin: 0;">Warm regards,</p>
                <p style="margin: 0;"><span style="color: #666666;">Modon Real Estate</span></p>
              </div>                                              
            </td>
          </tr>
          <!-- FOOTER -->
          <tr>                  
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>
        </table>
        <!-- /INNER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER -->
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>