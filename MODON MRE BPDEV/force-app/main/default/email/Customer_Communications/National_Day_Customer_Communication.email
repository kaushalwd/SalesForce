<messaging:emailTemplate subject="Weather Advisory: Your Safety Matters"
    recipientType="User"
    relatedToType="Contact">
<messaging:htmlEmailBody >
<html lang="en">
<head></head>

<body style="margin:0; padding:0; background:#ffffff;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
         style="margin:0; padding:0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center">

        <!-- INNER WRAPPER -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- ENGLISH CONTENT -->
          <tr>
            <td style="padding:16px 32px;">
              <div style="font-family:Arial, sans-serif; font-size:16px; line-height:1.6; color:#000000;">

                <p style="margin:0 0 16px 0;">Dear Valued Customer,</p>

                <p style="margin:0 0 16px 0;">
                  Based on the recent weather forecast, we kindly advise you to take extra care and stay safe, particularly on <strong>Friday, 19 December 2025</strong>.
                </p>

                <p style="margin:0 0 16px 0;">
                  Your safety is our priority. Please note that <strong>Modon Customer Care will be available online only</strong> during this period.
                </p>

                <!-- Contact Section -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0;">
                  <tr>
                    <td style="font-size:16px; color:#000000; padding:0;">
                      Should you require any assistance, we encourage you to reach out to us via  
                      <a href="tel:+97180066366" style="color:#000000; text-decoration:none; font-weight:bold;">800 MODON (800 66366)</a>
                      or email us at
                      <a href="mailto:customercare@modon.com" style="color:#3651A3; text-decoration:none; font-weight:bold;">customercare@modon.com</a>, and our team will be happy to assist you.
                    </td>
                    
                  </tr>
                </table>
                
                <p style="margin:16px 0 0 0;">Thank you for your understanding and continued trust.</p>
                
                <p style="margin:16px 0 0 0;">Best regards,</p>
                <p style="margin:0;"><strong>Modon</strong></p>

              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0;"
              />
            </td>
          </tr>

        </table>
        <!-- END INNER WRAPPER -->

      </td>
    </tr>
  </table>
  <!-- END OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>