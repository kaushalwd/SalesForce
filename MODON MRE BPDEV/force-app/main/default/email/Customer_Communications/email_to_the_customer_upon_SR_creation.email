<messaging:emailTemplate subject="Acknowledgment of Service Request – Property Transfer Case ID:{!relatedTo.CaseId__r.CaseNumber}" recipientType="User" relatedToType="ServiceRequest__c">
<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif;">
  <div style="text-align: center;">
          <!-- <img src="{!URLFOR($Resource.CustomerCommunitcationHeader)}" style="width: 100%; height: auto; display: block;" />-->
          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>

        </div>
        <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Acknowledgment of Service Request – Property Transfer</div>
  <div style="font-size: 14px;">Case ID: {!relatedTo.CaseId__r.CaseNumber}</div>
</div>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">

           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear {!relatedTo.AccountId__r.Name},
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
            
                Thank you for reaching out to Modon Customer Management. We have successfully received your service request for <b>Property Transfer</b>, and a new case has been created in our system for tracking and resolution.  <br/><br/>

                <b>Case Details:</b> <br/><br/>

                Case ID: {!relatedTo.CaseId__r.CaseNumber} <br/><br/>

                Service requested: Property Transfer <br/><br/>

                Received: {!relatedTo.CreatedDate}<br/><br/>
                           

                Our team is reviewing your request and will provide you with further updates shortly. If any additional information is required, we will contact you.  <br/><br/>


                Should you have any questions or require further assistance, please feel free to reach out to us at <a href="mailto:customercare@modon.com">customercare@modon.com</a> or 800-MODON.  <br/><br/>
                
                
                We appreciate your trust in Modon and look forward to assisting you. <br/><br/>             

 
            </td>
           </tr>
           <tr>
             <td colspan="2" style="">
               <br/>Best regards,<br/><br/><b>Customer Management Team</b>
             </td>
           </tr>        
         </table>
             
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>