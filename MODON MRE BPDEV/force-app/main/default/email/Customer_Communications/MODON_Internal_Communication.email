<messaging:emailTemplate subject="Internal Announcement to the business launch of Customer Portal"
    recipientType="User"
    relatedToType="UserAccess__c">
<messaging:htmlEmailBody >
<html lang="en">
<head>
  
</head>
<body style="margin:0; padding:0; background:#f4f4f4;">

  <!-- OUTER WRAPPER (full width, centers inner 600px) -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0; padding:24px 0; border-collapse:collapse; background:#f4f4f4;">
    <tr>
      <td align="center" style="margin:0; padding:0;">

        <!-- INNER CONTAINER (max 600px for ALL content, including header/footer) -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
               style="width:100%; max-width:600px; border-collapse:collapse; background:#ffffff;
                      box-shadow:0px 4px 12px rgba(0,0,0,0.12);">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/0360a3af-59b8-49b4-80bb-35263dd3fa34/3750x1033.png"
                alt="Modon Header"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

          <!-- BODY CONTENT -->
          <tr>
            <td style="padding: 16px 32px;">
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">Dear {!recipient.FirstName} {!recipient.LastName},</p>
                <p style="margin: 0 0 16px 0;">We are excited to announce the official launch of the Modon Customer Portal—a key milestone in enhancing our customer experience and streamlining our service delivery.</p>
                
                <p style="margin: 0; font-weight: bold;">What is the Modon Customer Portal?</p>
                <p style="margin: 0 0 16px 0;">The portal is a secure, user-friendly online platform designed to empower our customers with direct access to essential services and information related to their property journey with Modon.</p>
              </div>
            </td>
          </tr>

          <!-- ICON ROW 1 -->
          <tr>
            <td style="padding: 16px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/1c295fe1-48c4-487d-95b0-377388861bb5/181x181.png" 
                               alt="Virtual Tour" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Virtual Tour
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Take a tour of your property
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/26a2e23c-6f9e-47f8-9a25-3effea90c4d6/180x181.png" 
                               alt="Property Details" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Property Details
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          View full property info
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/c5e3e62b-268e-4e3d-9082-188238a20763/181x181.png" 
                               alt="Payments" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Payments
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Track due dates
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ICON ROW 2 -->
          <tr>
            <td style="padding: 16px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/e3eaf73c-71a6-47eb-bbed-6362c15ac801/181x181.png" 
                               alt="SOA Statements" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          SOA Statements
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          View latest Statement of Account
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/68344725-0e7e-4f51-9065-fde8e5fee85e/180x181.png" 
                               alt="SPA Agreements" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          SPA Agreements
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Access and download agreements
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td width="200" align="center" valign="top" style="padding: 8px;">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                      <tr>
                        <td align="center" style="padding-bottom: 8px;">
                          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/46786fd5-9212-4e3d-9f01-a765e089c0b1/181x181.png" 
                               alt="Service Requests" 
                               width="44" 
                               style="display:block; margin:0 auto;" />
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-weight: bold; font-size: 16px; color:#000000; padding-bottom: 4px;">
                          Service Requests
                        </td>
                      </tr>
                      <tr>
                        <td align="center" style="font-family: Arial, sans-serif; font-size: 13px; color:#777777;">
                          Raise and monitor services
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>          
          <!-- HELP SECTION -->
          <tr>
            <td style="padding: 16px 32px;">
              
              <div style="font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #000000;">
                <p style="margin: 0 0 16px 0;">
                  This launch marks another step towards our commitment to digital transformation and customer satisfaction.
                </p>
                <p style="margin: 0 0 16px 0;">For further details, or any questions, please contact the Customer Management team.</p>
                <p style="margin: 0;">
                  Best regards,<br/>
                  Modon Real Estate
                </p>
              </div>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <img
                src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                alt="Modon Footer"
                width="600"
                style="display:block; width:100%; max-width:600px; height:auto; border:0; outline:0; text-decoration:none; -ms-interpolation-mode:bicubic;"
              />
            </td>
          </tr>

        </table>
        <!-- /INNER CONTAINER -->
      </td>
    </tr>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>