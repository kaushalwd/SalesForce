<messaging:emailTemplate subject="Department Transfer Request Approved – Case ID:{!relatedTo.CaseNumber}" recipientType="User" relatedToType="Case">
<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif;">
  <div style="text-align: center;">
          <!-- <img src="{!URLFOR($Resource.CustomerCommunitcationHeader)}" style="width: 100%; height: auto; display: block;" />-->
          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>

        </div>
        <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">Department Transfer Request Approved</div>
  <div style="font-size: 14px;">Case ID: {!relatedTo.CaseNumber}</div>
</div>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">
           
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear {!relatedTo.Requestor_Name__c},
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
                We would like to inform you that your request for a department transfer has been reviewed and approved. Your case [Case ID:{!relatedTo.CaseNumber}] has now been assigned to the appropriate department to ensure it is handled efficiently.  <br/><br/>
               
                <b>Updated Case Details:</b> <br/><br/>

                Case ID: {!relatedTo.CaseNumber} <br/><br/>

                Previous Department: {!relatedTo.Previous_Department__c } <br/><br/>

                New Department: {!relatedTo.CaseSubCategory__c}  <br/><br/>

                Reason for Transfer: {!relatedTo.TransferComments__c} <br/><br/>

                Our {!relatedTo.CaseSubCategory__c} team will now take over your request and will be in touch with you shortly. If you have any further questions or need additional support, please feel free to reach out to us at <a href="mailto:customercare@modon.com">customercare@modon.com</a> or <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a>.  <br/><br/> 

                
                Thank you for your patience and for choosing Modon. We appreciate the opportunity to assist you. 
            </td>
           </tr>
           <tr>
<td colspan="2">
<br/>Best regards,<br/><br/>
<div style="color: #6e6e6e; font-size: 18px; font-weight: bold;">
   Modon Customer Management
</div>
</td>
</tr>      
 </table>
 
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>