<messaging:emailTemplate subject="Invoice {!relatedTo.Name} from Modon" 
                         recipientType="User" 
                         relatedToType="ServiceRequest__c">

<messaging:htmlEmailBody >
<html>
   <body style="font-family: Arial, sans-serif;">
        
        <!-- MODON Header -->
        <div style="background-color: #000000; height: 50px; display: flex; align-items: center; padding-left: 20px;">
          <img src="{!$Label.Customer_Communication_Modon_Logo}"
               alt="MODON Logo"
               style="height: 18px; width: auto;" />
        </div>

        <!-- Title -->
        <div style="background-color: #f2f2f2; padding: 15px; text-align: left;">
          <div style="font-size: 18px; font-weight: bold;">Invoice Details</div>
        </div>

        <table style="text-align:justify;width: 100%;">
           <tr><td colspan="2">&nbsp;</td></tr>

           <!-- Greeting -->
           <tr>
              <td colspan="2">
                  Dear {!relatedTo.AccountId__r.Name},
              </td>
           </tr>

           <tr><td colspan="2">&nbsp;</td></tr>

           <!-- Body -->
           <tr>
            <td colspan="2">
            
                Please find attached the invoice <b>{!relatedTo.Name}</b> for your reference. <br/><br/>

                Kindly review the details and arrange for payment at your earliest convenience. <br/><br/>

                <b>Invoice Details:</b> <br/><br/>

                Service Name: {!relatedTo.Name} <br/><br/>

                Invoice Number: {!relatedTo.Name} <br/><br/>

                Invoice Date: {!relatedTo.CreatedDate} <br/><br/>

                

                If you have already made the payment, please ignore this email. <br/><br/>

                Should you require any further assistance or have any questions, please do not hesitate to contact us at 
                <a href="mailto:customercare@modon.com">customercare@modon.com</a> or 800-MODON. <br/><br/>

            </td>
           </tr>

           <!-- Signature -->
           <tr>
             <td colspan="2">
               <br/>Best regards,<br/><br/>
               <b>Customer Management Team</b>
             </td>
           </tr>        
        </table>

        <!-- Footer -->
        <div style="text-align: left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
            <b>modon.com</b>
        </div>

   </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>