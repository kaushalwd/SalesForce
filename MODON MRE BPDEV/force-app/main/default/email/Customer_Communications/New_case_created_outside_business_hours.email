<messaging:emailTemplate subject="Case Received Outside Business Hours –  Case ID:{!relatedTo.CaseNumber} (Outside Business Hours)" recipientType="User" relatedToType="Case">
<messaging:htmlEmailBody >
<html>
<body style="font-family: Arial, sans-serif;">
<div style="text-align: center;">
   <!--<img src="{!URLFOR($Resource.CustomerCommunitcationHeader)}" style="width: 100%; height: auto; display: block;" />-->
   <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>

</div>
<div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
<div style="font-size: 18px; font-weight: bold;">Case Received Outside Business Hours</div>
<div style="font-size: 14px;">Case ID: {!relatedTo.CaseNumber}</div>
</div>
<!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
 <table style="text-align:justify;width: 100%;">
   
   <tr>
     <td colspan="2">
        &nbsp;
     </td>
   </tr>
   <tr>
      <td colspan="2" style="">
          Dear {!relatedTo.Requestor_Name__c},
      </td>
   </tr>
   <tr>
     <td colspan="2">
        &nbsp;
     </td>
   </tr>
   <tr>
    <td colspan="2" style="">
    
        Thank you for reaching out to Modon Customer Management Team. We have received your request, and a new case has been created in our system. Please note that your request was submitted outside our business hours, and it will be processed as soon as operations resume. <br/><br/>
       

        <b>Case Details:</b> <br/><br/>

        Case ID: {!relatedTo.CaseNumber} <br/><br/>

        Issue Reported: {!relatedTo.Subject} <br/><br/>

        Received: {!relatedTo.CreatedDate} <br/><br/>
        

        Our team will review your request and get back to you as soon as possible.  <br/><br/>



        Thank you for your patience and for choosing Modon. We will be in touch soon.   
    </td>
   </tr>
    <tr>
<td colspan="2">
<br/>Best regards,<br/><br/>
<div style="color: #6e6e6e; font-size: 18px; font-weight: bold;">
   Modon Customer Management
</div>
</td>
</tr>      
 </table>
 
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>