<messaging:emailTemplate subject="Your Opinion Matters! SalesOrder ID: {!relatedTo.Name}"
                         recipientType="User"
                         relatedToType="SalesOrder__c">
    <messaging:htmlEmailBody >
        <html>
            <body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #ffffff; color: #000000;">

                <!-- Header Image -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td align="center">
                            <img src="{!$Label.SOHeader}"
                                 alt="MODON Survey Banner"
                                 style="width: 100%; max-width: 800px; display: block; border: 0;" />
                        </td>
                    </tr>
                </table>

                <!-- Bilingual Message -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
                    <tr>
                        <!-- English -->
                        <td style="width: 50%; vertical-align: top; font-size: 14px; padding-right: 20px;">
                            <p>Dear {!relatedTo.ClientName__c},</p>
                            <p>Thank you for being an important part of the Modon family!</p>
                            <p>We request you to take a moment to complete the survey. Your valuable feedback will help us to enhance our services and deliver an improved customer experience. Your responses will be anonymous, confidential and will be used to improve our internal processes only.</p>
                            <p>Best regards,<br/>
                            <span style="color: #888888;">Customer Experience and Insights team</span></p>
                        </td>

                        <!-- Arabic -->
                        <td style="width: 50%; vertical-align: top; font-size: 14px; text-align: right; direction: rtl; padding-left: 20px;">
                            <p>عميلنا العزيز {!relatedTo.ClientName__c}،</p>
                            <p>شكراً لكونك جزءاً مهماً من عائلة مدن!</p>
                            <p>نود دعوتك للمشاركة في تعبئة استبيان رضا العملاء لمعرفة المزيد عن تجربتك معنا. مشاركتك تهمنا وسوف تساعدنا على تحسين خدماتنا والارتقاء بتجربتكم في المستقبل.</p>
                            <p>مشاركتك لن تستغرق سوى دقائق معدودة، وسيتم التعامل مع إجاباتك بسرية تامة وتستخدم فقط لأغراض التحسين.</p>
                            <p>مع أطيب التحيات،<br/>
                            <span style="color: #888888;">فريق الابحاث وتجارب العملاء</span></p>
                        </td>
                    </tr>
                </table>

                <!-- Dual-language CTA Button -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 800px; margin: 0 auto;">
                    <tr>
                        <td align="center" style="padding: 30px 0;">
                            <a href="{!relatedTo.InDirect_SurveyLink__c}"
                               style="background-color: #000000;
                                      color: #ffffff;
                                      padding: 14px 40px;
                                      font-size: 16px;
                                      border-radius: 30px;
                                      text-decoration: none;
                                      display: inline-block;
                                      font-weight: bold;">
                                Begin the survey | ابدأ الاستبيان
                            </a>
                        </td>
                    </tr>
                </table>

                <!-- Footer -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 800px; margin: 0 auto;">
                    <tr>
                        <td align="center" style="background-color: #f2f2f2; padding: 12px; font-size: 14px;">
                            <a href="https://modon.com" style="color: #1F4393; text-decoration: none;">
                                <b>modon.com</b>
                            </a>
                        </td>
                    </tr>
                </table>

            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>