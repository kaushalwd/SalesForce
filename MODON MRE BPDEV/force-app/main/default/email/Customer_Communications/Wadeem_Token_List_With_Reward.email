<messaging:emailTemplate subject="Exclusive Purchase Reward for Your Next Property with Modon"
                         recipientType="User"
                         relatedToType="Lead_Event__c">
    <messaging:htmlEmailBody >
        <html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="x-apple-disable-message-reformatting"/>
  <style type="text/css">
    /* Fix iOS / Gmail font scaling */
    body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
    table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; }
    img { -ms-interpolation-mode:bicubic; }
    /* Reset for Outlook dark mode */
    @media (prefers-color-scheme: dark) {
      body, table, td { background-color:#ffffff !important; color:#000000 !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#FBFBFB; font-family:Arial, Helvetica, sans-serif;">

  <!-- OUTER WRAPPER -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#FBFBFB" style="margin:0; padding:0; border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:0; margin:0;">

        <!-- INNER CONTAINER -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:600px; background-color:#ffffff; border-collapse:collapse;">

          <!-- HEADER -->
          <tr>
            <td style="padding:0; margin:0;">
              <img src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/112d6726-8d5a-40ef-907e-ac6db3484aab/2014x1176.jpg"
                   alt="Modon Header"
                   width="600"
                   border="0"
                   style="display:block; width:100% !important; max-width:600px; height:auto; border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic;"/>
            </td>
          </tr>

          <!-- ENGLISH CONTENT -->
          <tr>
            <td style="padding:20px 30px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:1.5; color:#000000;">
              <h3 style="margin:0 0 15px 0; font-size:18px; font-weight:bold;">Exclusive Purchase Reward for Your Next Property with Modon</h3>
              <p style="margin:0 0 15px 0;">Dear {!relatedTo.FirstName__c},</p>
              <p style="margin:0 0 15px 0;">Thank you for your recent engagement and interest in the <strong>Wadeem community</strong> sales launch. We greatly value your confidence in Modon and appreciate your interest.</p>
              <p style="margin:0 0 15px 0;">As a token of our appreciation, Modon is delighted to present you with a value certificate worth <strong>AED 37,000 (Thirty Seven Thousand Dirhams)</strong>. You may redeem this credit against the purchase of any property in our upcoming communities. The credit note is valid until <strong>31st December 2025</strong>.</p>
              <p style="margin:0 0 15px 0;">Your dedicated Sales Manager will contact you to share exclusive information, tailored offers, and answer any questions. Should you wish to connect, please find your Sales Manager's details below:</p>
              <ul style="margin:15px 0; padding-left:20px;">
                <li><strong>Name:</strong> {!relatedTo.SAName__c} </li>
                <li><strong>Phone:</strong> {!relatedTo.SalesAgentMobile__c}</li>
                <li><strong>Email:</strong> {!relatedTo.SAEmail__c}</li>
              </ul>
              <p style="margin:0 0 15px 0;">At Modon, we are dedicated to helping you discover your ideal home. We hope this gesture adds value to your experience with us.</p>
              <p style="margin:0 0 15px 0;">Thank you for being a valued member of the Modon community. Terms and conditions apply, please view them <a href="https://www.modon.com/real-estate/wadeem-token-terms-and-conditions" style="color:#3651A3; text-decoration:underline; font-weight:bold;">here</a>.</p>
              <p style="margin:0;">Warm regards,<br/><span style="color:#666666;">Modon Real Estate</span></p>
            </td>
          </tr>

          <!-- ARABIC CONTENT -->
          <tr>
            <td style="padding:20px 30px; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:1.5; color:#000000; direction:rtl; text-align:right;">
              <h3 style="margin:0 0 15px 0; font-size:18px; font-weight:bold;">فرصتك الآن: هدية حصرية عند شراء عقارك القادم مع مدن</h3>
              <p style="margin:0 0 15px 0;">السيد/ة {!relatedTo.FirstName__c} المحترم/ة،</p>
              <p style="margin:0 0 15px 0;">نتقدم إليكم بخالص الشكر والتقدير على اهتمامكم بإطلاق مبيعات مجتمع "وديم". وتقديراً منا لثقتكم بشركة "مدن"، يسرنا أن نقدم لكم شهادة رصيد بقيمة <strong>37,000 درهم إماراتي</strong>، يمكنكم الاستفادة منها عند شراء عقار في أي من مشاريعنا الجديدة حتى <strong>31 ديسمبر 2025</strong>.</p>
              <p style="margin:0 0 15px 0;">سيتواصل معكم، مدير المبيعات الخاص بكم قريباً، ليطلعكم على تفاصيل المشاريع الجديدة ويجيب على استفساراتك</p>
              <ul style="margin:15px 0; padding-right:20px; list-style:none;">
                <li><strong>الإسم:</strong> {!relatedTo.SAName__c} </li>
                <li><strong>الهاتف:</strong> {!relatedTo.SalesAgentMobile__c}</li>
                <li><strong>البريد الإلكتروني:</strong> {!relatedTo.SAEmail__c}</li>
              </ul>
              <p style="margin:0 0 15px 0;">هدفنا دائماً دعمكم لاختيار الوحدات السكنية التي تلبي تطلعاتكم. ونأمل أن تُسهم هذه الهدية في إثراء تجربتكم معنا.</p>
              <p style="margin:0 0 15px 0;">شكراً لاختياركم "مدن". تطبق الشروط والأحكام ويمكنكم الاطلاع عليها <a href="https://www.modon.com/real-estate/wadeem-token-terms-and-conditions" style="color:#3651A3; text-decoration:underline; font-weight:bold;">هنا</a>.</p>
              <p style="margin:0;">مع أطيب التمنيات،<br/><span style="color:#666666;">مدن العقارية</span></p>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:0; margin:0; line-height:0; font-size:0;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                <tr>
                  <td style="padding:0; margin:0;">
                    <img
                      src="https://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/9467eed0-6aa4-4a43-8c52-12864c891e57/3750x300.png"
                      alt="Modon Footer"
                      width="100%"
                      border="0"
                      style="display:block; width:100% !important; max-width:100%; height:auto; border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic;"
                    />
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- END INNER -->
      </td>
    </tr>
  </table>
  <!-- END OUTER -->

</body>
</html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>