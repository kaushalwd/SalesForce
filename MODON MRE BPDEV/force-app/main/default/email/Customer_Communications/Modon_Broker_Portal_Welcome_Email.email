<messaging:emailTemplate subject="Welcome to Modon Broker Portal" recipientType="User" relatedToType="Network">
<messaging:htmlEmailBody >

<p>Dear {!Recipient.FirstName},</p>


<p>We are delighted to inform you that you are now welcome to the Modon Broker Portal.</p>

<p>Your username is: <strong>{!Recipient.Username}</strong></p>
<p>You can set your password and login to Modon portal <a href="{!$Network.NetworkURLForUserEmails}">here</a></p> 

<p>Regards,</p>

<p>Modon Sales</p>
 </messaging:htmlEmailBody>
</messaging:emailTemplate>