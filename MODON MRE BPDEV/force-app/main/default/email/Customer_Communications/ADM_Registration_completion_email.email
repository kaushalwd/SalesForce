<messaging:emailTemplate subject="ADM Registration Completed" recipientType="User" relatedToType="ServiceRequest__c">
<messaging:htmlEmailBody >
<html>
   <body style="font-family: Arial, sans-serif;">
     <!--<div style="text-align: center;">
          <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg" style="width: 100%; height: auto; display: block;"/>
        </div>-->
        
        <!-- MODON Header -->
    <div style="background-color: #000000; height: 50px; display: flex; align-items: center; padding-left: 20px;">
      <img src="{!$Label.Customer_Communication_Modon_Logo}"
           alt="MODON Logo"
           style="height: 18px; width: auto;" />
    </div>
        <div style="background-color: #f2f2f2; padding: 15px; text-align: Left;">
  <div style="font-size: 18px; font-weight: bold;">ADM Registration Completed</div>
</div>
     <!--<div style="margin: 0px 20% 0 15%;border: 2px solid black;padding: 2px;">-->
         <table style="text-align:justify;width: 100%;">
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
              <td colspan="2" style="">
                  Dear {!relatedTo.AccountId__r.Name},
              </td>
           </tr>
           <tr>
             <td colspan="2">
                &nbsp;
             </td>
           </tr>
           <tr>
            <td colspan="2" style="">
            
                We are pleased to inform you that your <b>ADM Registration</b> has been successfully completed. Please find your <b>Registration Certificate</b> attached to this email for your reference.  <br/><br/>

                <b>Details:</b> <br/><br/>

                Service Name: {!relatedTo.Name} <br/><br/>

                Service Completed: ADM Registration <br/><br/>

                Completion Date: {!relatedTo.CloseDate__c}<br/><br/>
                           

                Should you require any further assistance or have any questions, please do not hesitate to contact us at <a href="mailto:customercare@modon.com">customercare@modon.com</a> or 800-MODON. <br/><br/>
          

            </td>
           </tr>
           <tr>
             <td colspan="2" style="">
               <br/>Best regards,<br/><br/><b>Customer Management Team</b>
             </td>
           </tr>        
         </table>
             
     <!-- Footer -->
<div style="text-align: Left; background-color: #f2f2f2; padding: 10px; font-size: 14px; color: #000000; margin-top: 30px;">
<a><b> modon.com</b></a>
<!--<<a href="https://modon.com" style="color: #1F4393; text-decoration: none;">modon.com</a>-->
</div>
<!--</div>-->
  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>