<messaging:emailTemplate subject="Service Request Closure Confirmation – Service Request ID:{!relatedTo.CaseNumber}" recipientType="User" relatedToType="Case">
<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif;">

    <!-- MODON Header -->
    <div style="background-color: #000000; height: 50px; display: flex; align-items: center; padding-left: 20px;">
      <img src="{!$Label.Customer_Communication_Modon_Logo}"
           alt="MODON Logo"
           style="height: 18px; width: auto;" />
    </div>
    
    <!-- Header Text Section -->
    <div style="background-color: #f2f2f2; padding: 15px; text-align: left;">
      <div style="font-size: 18px; font-weight: bold;">Service Request Closure Confirmation</div>
      <div style="font-size: 14px;">Service Request ID: {!relatedTo.CaseNumber}</div>
    </div>

    <!-- Main Body -->
    <table style="text-align: justify; width: 100%; padding: 20px;">
      <tr><td colspan="2">&nbsp;</td></tr>
      <tr><td colspan="2">Dear {!relatedTo.Requestor_Name__c},</td></tr>
      <tr><td colspan="2">&nbsp;</td></tr>

      <tr>
        <td colspan="2">
          We are reaching out to inform you that the Service Request you raised with us, [Service Request ID: {!relatedTo.CaseNumber}], has been successfully resolved and is now closed. <br/><br/>

          <b>Service Request Details:</b> <br/><br/>
          Issue Reported: {!relatedTo.Subject} <br/><br/>
          Resolution Provided: {!relatedTo.Resolution_Comments__c} <br/><br/>
    Closure Date:
    <apex:outputText value="{0,date,dd MMM yyyy hh:mm a z}">
        <apex:param value="{!relatedTo.ClosedDate}"/>
    </apex:outputText> <br/><br/>

          If you have any further questions or require additional assistance, please feel free to reach out to us at 
          <a href="mailto:customercare@modon.com">customercare@modon.com</a> or <a href="tel:80066366" style="color:#0000EE; text-decoration:underline;">800 MODON</a> <br/><br/>
          <!-- <img src="{!URLFOR($Resource.PhoneIcon)}" alt="Phone Icon" style="height: 16px; vertical-align: middle;" />-->
          

          Should you need to reopen this Service Request or raise a new concern, we are here to assist you. <br/><br/>

          Thank you for your time and for choosing Modon. <br/><br/>

            <br/><br/>
        </td>
      </tr>

      <tr>
        <td colspan="2">
          <br/>Best regards,<br/><br/>
          <div style="color: #6e6e6e; font-size: 18px; font-weight: bold;">
            Modon Customer Management
          </div>
        </td>
      </tr>
    </table>

    <!-- Footer -->
    <div style="text-align: center; background-color: #f2f2f2; padding: 10px; margin-top: 30px;">
      <a href="https://modon.com" target="_blank" style="color: #000000; font-weight: bold;">modon.com</a>
    </div>

  </body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>