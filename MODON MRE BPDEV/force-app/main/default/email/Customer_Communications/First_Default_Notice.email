<messaging:emailTemplate subject="Default Notice 1 – Outstanding Payment"
                         recipientType="User"
                         relatedToType="Account">

<messaging:htmlEmailBody >
<html>
  <body style="font-family: Arial, sans-serif; color:#000000;">

    <!-- Header Image -->
  <!-- Header -->
<div style="background-color:#000000; padding:15px 25px;">
  <img src="http://cdn.mcauto-images-production.sendgrid.net/e8b0a57e5c62d448/faec48e3-ed7c-4bd7-8c65-56e42990cc99/3000x481.jpg"
       style="width:220px; height:auto; display:block;" />
</div>



    <!-- Title -->
    <div style="background-color:#f2f2f2; padding:15px;">
      <div style="font-size:18px; font-weight:bold;">
        Default Notice – 1
      </div>
    </div>

    <!-- Body -->
    <table style="width:100%; text-align:justify; padding:15px;">
      
      <tr>
        <td>
          Dear {!relatedTo.Name},
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          We hope this message finds you well.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          This email serves as <b>Default Notice (Notice 1)</b> to inform you that the scheduled 
          payment related to your property with Modon remains outstanding 
          as of the due date, despite previous reminders.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          We kindly request that the outstanding payment be settled to avoid 
          any further action in accordance with the terms and conditions of your 
          Sale and Purchase Agreement.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          If payment has already been made, please disregard this notice. 
          Otherwise, we urge you to take the necessary steps to regularize 
          your account at the earliest.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          Should you have any questions or require clarification, please contact us on 
          <b>800 MODON (800 66366)</b> or email 
          <b>customercare@modon.com</b>. 
          Our team is available to support you.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          Thank you for your prompt attention to this matter.
        </td>
      </tr>

      <tr><td>&nbsp;</td></tr>

      <tr>
        <td>
          Best Regards,<br/><br/>
          <b>Modon</b>
        </td>
      </tr>

    </table>

    <!-- Footer -->
    <div style="background-color:#f2f2f2; padding:10px; font-size:14px;">
      <b>modon.com</b>
    </div>

  </body>
</html>
</messaging:htmlEmailBody>

</messaging:emailTemplate>