            <td style="width: 33%;"><strong>Maker:</strong> (Name and signature)</td>
            <td style="width: 33%;"><strong>Checker:</strong> (Name and signature)</td>
            <td style="width: 33%;"><strong>Manager:</strong></td>
        </tr>
    </table-->
