<apex:page renderAs="pdf" controller="SPAExecutionChecklistToPDF"  contentType="application/pdf">
    <div style="font-size:16px; font-weight:bold; font-family:Tahoma, sans-serif; text-align:center; margin-bottom:10px; ">
        {!makChkName} - {!projectName}
    </div>

    <!-- Business details -->
    <table style="width:100%; font-family:Tahoma, sans-serif; font-size:14px; margin-bottom:10px;">
        <tr>
            <td><strong>Business Process Number:</strong> {!bpNumber}</td>
        </tr>
        <tr>
            <td><strong>Tower:</strong> {!towerName}</td>
        </tr>
        <tr>
            <td><strong>Project:</strong> {!projectName}</td>
        </tr>
    </table>

    <apex:repeat value="{!checklistItems}" var="item">
        <div style=" font-size:11px; font-weight:bold; font-family:Tahoma, sans-serif; margin-bottom:5px; ">
            <apex:outputText value="{!item.Checklist_Name__c}" escape="false"/>
        </div>

    <table style="width:100%; border-collapse:collapse; table-layout:fixed; font-family:Tahoma, sans-serif; font-size:12px; margin-bottom:15px;">
        <tbody>
            <tr>
                <td style=" width:15%; border:1px solid black; padding:6px; font-weight:normal; ">Remark</td>
                <td style=" width:85%; border:1px solid black; padding:6px;">{!item.Maker_Comments__c} </td>
            </tr>
        </tbody>
    </table>

    </apex:repeat>
