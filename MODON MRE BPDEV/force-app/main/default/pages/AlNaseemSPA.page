    async function loadFont(url) {
        try {
            const response = await fetch(url);
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            const arrayBuffer = await response.arrayBuffer();
            const uint8Array = new Uint8Array(arrayBuffer);
            let binaryString = '';
            for (let i = 0; i < uint8Array.byteLength; i++) {
                binaryString += String.fromCharCode(uint8Array[i]);
            }
            return btoa(binaryString);
        } catch (error) {
            console.error('Error loading font:', error);
        }
    }

    function showSpinner() {
        document.getElementById('spinner').style.display = 'block';
    }

    function hideSpinner() {
        document.getElementById('spinner').style.display = 'none';
    }

    async function saveAsPDF() {
        showSpinner();
        try {
            const font = await loadFont('/resource/NotoNaskhArabicFont');
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');

            // Add the font to jsPDF
            pdf.addFileToVFS('NotoNaskhArabic-VariableFont_wght-normal.ttf', font);
            pdf.addFont('NotoNaskhArabic-VariableFont_wght-normal.ttf', 'NotoNaskhArabic-VariableFont_wght', 'normal');

            // Set the custom Arabic font
            pdf.setFont('NotoNaskhArabic-VariableFont_wght', 'normal');
            pdf.setFontSize(12);

            const content = document.getElementById('mappingContent');
            const userAgent = window.navigator.userAgent;
            
                pdf.html(content, {
                callback: function(doc) {
                    const pdfOutput = doc.output('datauristring').split(',')[1];
                    document.getElementById('pdfData').value = pdfOutput;
                    document.getElementById('recordId').value = '{!SalesOrder__c.Id}';
                    document.getElementById('pdfForm').submit();
                    //  hideSpinner(); // Ensure the spinner is hidden after the form submission
                },
                x: 10,
                y: 10,
                width: 190,
                windowWidth: 1024,
                //autoPaging: true, // Ensure content is auto-paged
                filename:'SPA Document.pdf'
            }).catch(err => {
                console.error('Error generating PDF:', err);
                hideSpinner();
            });
                

        } catch (error) {
            console.error('Error in saveAsPDF:', error);
            hideSpinner();
        }
    }
                    
                    

    function printFunc(){
          
        var printContent = document.getElementById('content').innerHTML;
                                
        var w = window.open();
        w.document.write(printContent);           
        setTimeout(function(){ 
            w.print();
            w.close();
        },1000); 
    }
       
</script>


