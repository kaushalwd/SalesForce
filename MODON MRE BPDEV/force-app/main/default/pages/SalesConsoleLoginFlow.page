<!--
  MODON Sales Console - Visualforce login flow (Aurelix, 1.0, 28 Aug 2026)
  Attached to the Sales Management profile in Setup -> Login Flows. The action
  decides and finishes immediately; this body only shows if a browser blocks the
  redirect for a beat.
-->
<apex:page controller="SalesConsoleLoginFlowController"
           action="{!proceed}"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           title="Signing you in">
    <p style="font-family: -apple-system, 'Segoe UI', Arial, sans-serif;
              margin: 3rem auto; max-width: 30rem; text-align: center;
              color: #444;">
        Signing you in&hellip;
    </p>
</apex:page>