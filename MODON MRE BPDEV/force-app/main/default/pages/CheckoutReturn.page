<apex:page controller="CheckoutReturnController" action="{!process}" showHeader="false" sidebar="false"
           standardStylesheets="false" applyHtmlTag="false" title="Payment Result">
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, Helvetica, sans-serif; color: #16325c;
           background: #f3f4f6; display: flex; min-height: 100vh; align-items: center; justify-content: center; }
    .card { background: #ffffff; width: 100%; max-width: 460px; margin: 24px; border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12); overflow: hidden; }
    .bar { height: 6px; background: #1a1a1a; }
    .body { padding: 36px 32px; text-align: center; }
    .icon { width: 72px; height: 72px; border-radius: 50%; margin: 0 auto 20px; display: flex;
            align-items: center; justify-content: center; font-size: 38px; color: #fff; }
    .icon.ok { background: #2e844a; }
    .icon.pending { background: #1a1a1a; }
    .icon.err { background: #ba0517; }
    h1 { font-size: 22px; margin: 0 0 10px; }
    p { font-size: 15px; line-height: 1.5; color: #444; margin: 0 0 8px; }
    .eoi { margin: 18px 0 24px; font-size: 15px; }
    .eoi strong { font-size: 18px; color: #16325c; }
    .btn { display: block; width: 100%; padding: 12px 16px; margin: 10px 0 0; border-radius: 8px;
           font-size: 15px; font-weight: bold; text-decoration: none; cursor: pointer; }
    .btn.primary { background: #1a1a1a; color: #fff; }
    .btn.secondary { background: #f3f4f6; color: #16325c; border: 1px solid #d8dde6; }
</style>
</head>
<body>
    <div class="card">
        <div class="bar"></div>
        <div class="body">
            <apex:outputPanel rendered="{!isSuccess}" layout="none">
                <div class="icon ok">&#10003;</div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isPending}" layout="none">
                <div class="icon pending">&#8987;</div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!isFailed}" layout="none">
                <div class="icon err">&#10005;</div>
            </apex:outputPanel>

            <h1>{!headline}</h1>
            <p>{!detail}</p>

            <apex:outputPanel rendered="{!isSuccess}" layout="none">
                <p class="eoi">Expression of Interest: <strong>{!eoiName}</strong></p>
                <a class="btn primary" href="{!eoiUrl}" target="_top">View your EOI</a>
            </apex:outputPanel>

            <a class="btn secondary" href="{!homeUrl}" target="_top">Back to Salesforce</a>
        </div>
    </div>
</body>
</html>
</apex:page>