                                                            <apex:outputText rendered="{!NOT(ISBLANK(alloc.Receipt__c)) && alloc.Receipt__r.Status__c = 'Cleared' && (ISBLANK(alloc.Receipt__r.Receipt_Excess_Amount__c) || alloc.Receipt__r.Receipt_Excess_Amount__c == 0)}"
                                                                value="{0,date,dd-MMM-yy}">
                                                                <apex:param value="{!alloc.Receipt__r.EBS_Clearing_Date__c}" />
                                                            </apex:outputText>

                                                            <!-- Else show cheque date, falling back to transaction date -->
                                                            <apex:outputText rendered="{!(ISBLANK(alloc.Receipt__c) || alloc.Receipt__r.Status__c != 'Cleared') && NOT(ISBLANK(alloc.Receipt__r.ChequeDate__c))}"
                                                                value="{0,date,dd-MMM-yy}">
                                                                <apex:param value="{!alloc.Receipt__r.ChequeDate__c}" />
                                                            </apex:outputText>

                                                            <apex:outputText rendered="{!(ISBLANK(alloc.Receipt__c) || alloc.Receipt__r.Status__c != 'Cleared') && ISBLANK(alloc.Receipt__r.ChequeDate__c)}"
                                                                value="{0,date,dd-MMM-yy}">
                                                                <apex:param value="{!alloc.Receipt__r.TransactionDate__c}" />
                                                            </apex:outputText>
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </table>
                                        </td>

                                        <!-- Invoice No -->
