                                                            <apex:outputText rendered="{!NOT(ISBLANK(alloc.Receipt__c)) && alloc.Receipt__r.Status__c = 'Cleared' && (ISBLANK(alloc.Receipt__r.Receipt_Excess_Amount__c) || alloc.Receipt__r.Receipt_Excess_Amount__c == 0)}"
                                                                value="Receipt" />
                                                            <apex:outputText rendered="{!NOT(ISBLANK(alloc.Receipt__c)) && alloc.Receipt__r.Status__c = 'Cleared' && NOT(ISBLANK(alloc.Receipt__r.Receipt_Excess_Amount__c)) && alloc.Receipt__r.Receipt_Excess_Amount__c != 0}"
                                                                value="{!IF(ISBLANK(alloc.Receipt__r.Modeofpayment__c), 'Receipt', 'Receipt - ' + alloc.Receipt__r.Modeofpayment__c)}" />
                                                            <apex:outputText rendered="{!ISBLANK(alloc.Receipt__c) || alloc.Receipt__r.Status__c != 'Cleared'}"
                                                                value="{!IF(ISBLANK(alloc.Receipt__r.Modeofpayment__c), 'PDC', alloc.Receipt__r.Modeofpayment__c)}" />
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </table>
                                        </td>

                                        <!-- Invoice Amount -->
