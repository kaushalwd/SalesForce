                                                            <apex:outputText rendered="{!ISBLANK(alloc.Receipt__c) || alloc.Receipt__r.Status__c = 'Cleared' || alloc.Receipt__r.Status__c = 'In Progress'}"
                                                                value="{!alloc.Receipt__r.Receipt_Amount__c}" />
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </table>
                                        </td>

                                        <!-- Transaction Number -->
                                        <td style="font-family: sans-serif; border:1px solid black; padding:8px; text-align:center;">
                                            <table>
                                                <apex:repeat value="{!futureCharge.Allocations__r}" var="alloc">
