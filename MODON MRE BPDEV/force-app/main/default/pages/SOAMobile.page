                                                        <td style="font-family: sans-serif; padding:8px; text-align:center;">
                                                            {!alloc.Receipt__r.TransactionNumber__c}
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </table>
                                        </td>

                                        <!-- Status -->
