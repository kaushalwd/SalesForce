<!--
  MODON Sales Console - SSO gateway (Aurelix, 1.0, 28 Aug 2026)
  The login flow's finish location. Renders for at most a moment: the action
  redirects permission holders to the console's SSO endpoint and everyone else to
  the Salesforce home page. The body below is only ever seen if a browser blocks
  the redirect, so it says what is happening in plain words.
-->
<apex:page controller="SalesConsoleSsoGatewayController"
           action="{!go}"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           title="Sales Console">
    <p style="font-family: -apple-system, 'Segoe UI', Arial, sans-serif;
              margin: 3rem auto; max-width: 30rem; text-align: center;
              color: #444;">
        Taking you to the Sales Console&hellip;
    </p>
</apex:page>