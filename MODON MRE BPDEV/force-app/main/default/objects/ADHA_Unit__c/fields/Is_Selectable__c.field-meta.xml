<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Selectable__c</fullName>
    <description>A unit is bookable only when publicly exposed and still available.</description>
    <formula>AND( ISPICKVAL(Expose_To__c, &apos;Public&apos;), ISPICKVAL(Status__c, &apos;Available&apos;) )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Selectable</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
