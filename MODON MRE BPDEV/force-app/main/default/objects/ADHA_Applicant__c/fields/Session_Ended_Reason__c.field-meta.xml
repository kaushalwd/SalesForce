<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Session_Ended_Reason__c</fullName>
    <description>How the last session ended: Signed out, Idle timeout or Superseded. Set alongside Session_Ended_On__c. Restricted, because it is written from a client-supplied reason and anything unrecognised is normalised to Signed out before it reaches here.</description>
    <label>Session Ended Reason</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Signed out</fullName>
                <default>false</default>
                <label>Signed out</label>
            </value>
            <value>
                <fullName>Idle timeout</fullName>
                <default>false</default>
                <label>Idle timeout</label>
            </value>
            <value>
                <fullName>Superseded</fullName>
                <default>false</default>
                <label>Superseded</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
