<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ExtensionRequested</fullName>
    <active>false</active>
    <errorConditionFormula>AND(  Request_Extension__c =TRUE, OR(ISBLANK( Extension_In_Hours__c ),ISBLANK( Extension_Comments__c)))</errorConditionFormula>
    <errorMessage>Please fill the Extension In hours and comments</errorMessage>
</ValidationRule>
