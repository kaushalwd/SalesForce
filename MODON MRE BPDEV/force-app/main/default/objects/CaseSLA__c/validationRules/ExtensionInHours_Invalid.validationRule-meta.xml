<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ExtensionInHours_Invalid</fullName>
    <active>true</active>
    <description>Extension should be greater than or equal to 1 hour.</description>
    <errorConditionFormula>AND(NOT(ISNULL(Extension_In_Hours__c)) , Extension_In_Hours__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>Extension_In_Hours__c</errorDisplayField>
    <errorMessage>Extension should be greater than or equal to 1 hour.</errorMessage>
</ValidationRule>
