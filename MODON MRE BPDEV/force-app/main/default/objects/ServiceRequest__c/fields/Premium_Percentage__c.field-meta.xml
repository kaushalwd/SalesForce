<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Premium_Percentage__c</fullName>
    <description>Calculates the percentage premium (or discount) of the selling price over the original price for the related Service Request. Returns 0 if the Selling price is zero.</description>
    <formula>IF(
    Selling_Price__c = 0,
    0,
    (Selling_Price__c - OriginalPrice__c) / OriginalPrice__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Premium Percentage</label>
    <precision>18</precision>
    <required>false</required>
    <scale>1</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
