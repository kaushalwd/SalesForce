<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_SR_cannot_be_Closed_or_cancelled</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), OR(ISPICKVAL( Status__c , &quot;Closed&quot;),ISPICKVAL( Status__c , &quot;Cancelled&quot;)) )</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Cannot Create a SR with Closed or Cancelled Status</errorMessage>
</ValidationRule>
