<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Date_must_be_a_future_date</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Cancellation_Date__c)),
    Cancellation_Date__c &lt;= TODAY()
)</errorConditionFormula>
    <errorDisplayField>Cancellation_Date__c</errorDisplayField>
    <errorMessage>Cancellation Date must be a future date.</errorMessage>
</ValidationRule>
