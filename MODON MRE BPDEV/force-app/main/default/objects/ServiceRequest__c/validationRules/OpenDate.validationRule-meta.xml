<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OpenDate</fullName>
    <active>true</active>
    <description>This rule is used to restrict user to enter past dates</description>
    <errorConditionFormula>AND(
    ISNEW(),
    OpenDate__c &lt; TODAY(),
    RecordType.DeveloperName &lt;&gt; &quot;Service_Request_Management_ADM&quot;
)</errorConditionFormula>
    <errorDisplayField>OpenDate__c</errorDisplayField>
    <errorMessage>Open Date Cannot be in past</errorMessage>
</ValidationRule>
