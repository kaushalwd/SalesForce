<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_SellingPrice_After_Step7</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Step_Order__c &gt; 7,
ISCHANGED(Selling_Price__c)
)</errorConditionFormula>
    <errorDisplayField>Selling_Price__c</errorDisplayField>
    <errorMessage>You cannot edit Selling Price as financial approval is done.</errorMessage>
</ValidationRule>
