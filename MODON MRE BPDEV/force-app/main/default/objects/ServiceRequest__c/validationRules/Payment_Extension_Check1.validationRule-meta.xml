<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Extension_Check1</fullName>
    <active>true</active>
    <errorConditionFormula>AND( RecordTypeName__c =&apos;Request Payment Extension&apos;,	(Payment_Extension_Date__c &gt;  Actual_Requested_Date__c))</errorConditionFormula>
    <errorDisplayField>Payment_Extension_Date__c</errorDisplayField>
    <errorMessage>Payment Extension Date cannot be after Requested Date</errorMessage>
</ValidationRule>
