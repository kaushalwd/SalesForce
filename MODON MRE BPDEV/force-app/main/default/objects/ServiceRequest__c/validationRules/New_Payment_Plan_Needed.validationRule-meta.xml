<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Payment_Plan_Needed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Payment_Plan_Swap&quot;,
    ISBLANK(New_Payment_Plan__c)
)</errorConditionFormula>
    <errorDisplayField>New_Payment_Plan__c</errorDisplayField>
    <errorMessage>New Payment Plan is required for Creating the service request to Swap Payment Plan.</errorMessage>
</ValidationRule>
