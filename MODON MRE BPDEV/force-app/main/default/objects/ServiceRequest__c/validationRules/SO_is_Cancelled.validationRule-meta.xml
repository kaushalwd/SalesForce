<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SO_is_Cancelled</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(),OR(ISPICKVAL(SalesOrder__r.Status__c, &apos;Cancelled&apos;) , ISPICKVAL(SalesOrder__r.Status__c, &apos;System Cancelled&apos;),ISPICKVAL(SalesOrder__r.Status__c, &apos;Cancelled SR&apos;)))</errorConditionFormula>
    <errorDisplayField>SalesOrder__c</errorDisplayField>
    <errorMessage>SR Cannot be Created for a Cancelled SalesOrder</errorMessage>
</ValidationRule>
