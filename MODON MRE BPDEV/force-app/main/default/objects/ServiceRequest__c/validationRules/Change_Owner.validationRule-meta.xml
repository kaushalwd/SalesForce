<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Change_Owner</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(OwnerId),
    NOT(
        OR(
            $Profile.Name = &quot;System Administrator&quot;,
            $Permission.Change_Owner
        )
    )
)</errorConditionFormula>
    <errorMessage>You are not authorized to change the owner of this Service Request. Please contact your System Administrator if you need assistance</errorMessage>
</ValidationRule>
