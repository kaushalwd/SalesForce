<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PE_Same_day_as_payment</fullName>
    <active>true</active>
    <errorConditionFormula>Isnew() &amp;&amp; (Actual_Installment_Date__c == Payment_Extension_Date__c)</errorConditionFormula>
    <errorDisplayField>Payment_Extension_Date__c</errorDisplayField>
    <errorMessage>Cannot Create a Payment Extension for same day as Actual Payment Date</errorMessage>
</ValidationRule>
