<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Task_Status_should_not_be_changed_as_New</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(PRIORVALUE(Status), &quot;SLA Expired&quot;),ISPICKVAL(Status, &quot;Open&quot;)
)</errorConditionFormula>
    <errorMessage>Can not change the status to Open</errorMessage>
</ValidationRule>
