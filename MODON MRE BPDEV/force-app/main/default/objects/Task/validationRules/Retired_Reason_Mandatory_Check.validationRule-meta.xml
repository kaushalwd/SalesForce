<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Retired_Reason_Mandatory_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Customer Not Interested&quot;),
    ISBLANK(TEXT(RetiredReason__c))
)</errorConditionFormula>
    <errorDisplayField>RetiredReason__c</errorDisplayField>
    <errorMessage>Retired Reason is mandatory if Customer is not interested.</errorMessage>
</ValidationRule>
