<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DueDate_Subject_Read_Only</fullName>
    <active>false</active>
    <errorConditionFormula>AND(  NOT(ISNEW())  , OR(ISCHANGED(ActivityDate), ISCHANGED(Subject) ) )</errorConditionFormula>
    <errorMessage>Cannot change Due date or Subject.</errorMessage>
</ValidationRule>
