<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Approval_Status__c) &amp;&amp;
TEXT(Approval_Status__c) = &quot;Rejected&quot; &amp;&amp;
ISBLANK(Rejection_Reason__c)</errorConditionFormula>
    <errorMessage>Rejection Reason is Required if Offer is Rejected!</errorMessage>
</ValidationRule>
