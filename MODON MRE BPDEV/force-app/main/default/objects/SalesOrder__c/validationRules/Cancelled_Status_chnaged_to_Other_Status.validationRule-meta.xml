<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_Status_chnaged_to_Other_Status</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Cancelled&quot;),
    NOT(ISPICKVAL(Status__c, &quot;Cancelled&quot;))
)</errorConditionFormula>
    <errorMessage>Status cannot be changed from Cancelled to any other status.</errorMessage>
</ValidationRule>
