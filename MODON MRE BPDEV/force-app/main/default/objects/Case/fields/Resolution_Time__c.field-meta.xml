<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Time__c</fullName>
    <description>Calculates the number of total hours from when a case was created to when it was closed. If the case is open, it calculates the time from Created Date to now.</description>
    <externalId>false</externalId>
    <formula>IF(
ISBLANK(ClosedDate),
(NOW() - CreatedDate) * 24,
(ClosedDate - CreatedDate) * 24
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Resolution Time</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
