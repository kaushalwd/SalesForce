<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sub_Status_Required_for_Closed_status</fullName>
    <active>true</active>
    <description>Sub Status is required when Status is Closed.</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
    ISPICKVAL(Status, &quot;Closed&quot;),
    ISBLANK(TEXT(Sub_Status__c))
)
)</errorConditionFormula>
    <errorDisplayField>Sub_Status__c</errorDisplayField>
    <errorMessage>Sub Status is required when Status is Closed.</errorMessage>
</ValidationRule>
