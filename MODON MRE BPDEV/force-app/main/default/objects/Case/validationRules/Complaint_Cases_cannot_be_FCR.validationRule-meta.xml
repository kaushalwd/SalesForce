<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Complaint_Cases_cannot_be_FCR</fullName>
    <active>true</active>
    <description>Complaint Cases cannot be FCR</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
    ISPICKVAL(CaseType__c, &quot;Complaint&quot;),
    FCR__c
)
)</errorConditionFormula>
    <errorDisplayField>FCR__c</errorDisplayField>
    <errorMessage>Complaint Cases cannot be FCR</errorMessage>
</ValidationRule>
