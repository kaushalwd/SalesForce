<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VisitorCase_NameRequired</fullName>
    <active>true</active>
    <description>Name required for Visitor cases</description>
    <errorConditionFormula>AND(ISPICKVAL(CaseType__c , &apos;Visitor Case&apos;)
,ISBLANK( Requestor_Name__c )
)</errorConditionFormula>
    <errorDisplayField>Requestor_Name__c</errorDisplayField>
    <errorMessage>Name required for Visitor cases</errorMessage>
</ValidationRule>
