<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VisitorCase_EmailRequired</fullName>
    <active>false</active>
    <description>Email required for Visitor cases</description>
    <errorConditionFormula>AND(ISPICKVAL(CaseType__c , &apos;Visitor Case&apos;)
,ISBLANK( Requestor_Email__c ),
NOT(ISPICKVAL(Origin, &apos;800 Modon&apos;))
)</errorConditionFormula>
    <errorDisplayField>Requestor_Email__c</errorDisplayField>
    <errorMessage>Email required for Visitor cases</errorMessage>
</ValidationRule>
