<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VisitorCase_FirstNameRequired</fullName>
    <active>true</active>
    <description>First Name required for Visitor cases</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(TEXT(Customer_Type__c) = &apos;Visitor&apos;
,ISBLANK( Visitor_First_Name__c )
)
)</errorConditionFormula>
    <errorDisplayField>Visitor_First_Name__c</errorDisplayField>
    <errorMessage>First Name required for Visitor cases</errorMessage>
</ValidationRule>
