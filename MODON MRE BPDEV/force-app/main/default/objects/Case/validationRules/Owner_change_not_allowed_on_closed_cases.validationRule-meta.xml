<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Owner_change_not_allowed_on_closed_cases</fullName>
    <active>true</active>
    <description>Owner change not allowed on closed cases</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
    ISPICKVAL(Status, &quot;Closed&quot;),
    ISCHANGED(New_Owner__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)
)</errorConditionFormula>
    <errorDisplayField>New_Owner__c</errorDisplayField>
    <errorMessage>Owner change not allowed on closed cases</errorMessage>
</ValidationRule>
