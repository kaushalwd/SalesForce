<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Internal_Escalation_Reason_is_needed</fullName>
    <active>true</active>
    <description>Internal Escalation Reason is needed</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
Send_Internal_Escalation__c = TRUE,
ISBLANK(Internal_Escalation_Reason__c)
)
)</errorConditionFormula>
    <errorDisplayField>Internal_Escalation_Reason__c</errorDisplayField>
    <errorMessage>Internal Escalation Reason is needed</errorMessage>
</ValidationRule>
