<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Validation_Restriction</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Requestor_Name__c = &quot;Test&quot;,
ISPICKVAL(Channel__c, &quot;Websites&quot;),
ISPICKVAL(Source__c, &quot;Modon.com&quot;)
)</errorConditionFormula>
    <errorMessage>Case creation is restricted for this Requestor, Channel, and Source combination.</errorMessage>
</ValidationRule>
