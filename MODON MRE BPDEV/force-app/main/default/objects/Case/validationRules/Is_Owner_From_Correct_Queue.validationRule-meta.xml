<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Owner_From_Correct_Queue</fullName>
    <active>true</active>
    <description>Please assign owner from the Owner Queue.</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
    NOT(ISBLANK(New_Owner__c)),
    NOT(Is_Owner_From_Correct_Queue__c)
)
)</errorConditionFormula>
    <errorMessage>Please assign owner from the Owner Queue.</errorMessage>
</ValidationRule>
