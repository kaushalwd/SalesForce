<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Parent_Case_needed_for_Duplicate_Case</fullName>
    <active>true</active>
    <description>Parent Case Id needed for Duplicate Cases</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
ISPICKVAL(CaseCategory__c, &apos;Duplicate Case&apos;),
ISBLANK(ParentId)
)
)</errorConditionFormula>
    <errorDisplayField>ParentId</errorDisplayField>
    <errorMessage>Parent Case Id needed for Duplicate Cases</errorMessage>
</ValidationRule>
