<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unit_Not_Needed_for_Visitor</fullName>
    <active>false</active>
    <description>Visitor cannot have a unit. Please remove Unit.</description>
    <errorConditionFormula>AND(
    NOT($Setup.Case_Validation_Bypass__c.Bypass_Validation__c),
    AND(
TEXT(Customer_Type__c) = &apos;Visitor&apos;,
NOT(ISBLANK(Unit__c))
)
)</errorConditionFormula>
    <errorDisplayField>Unit__c</errorDisplayField>
    <errorMessage>Visitor cannot have a unit. Please remove Unit.</errorMessage>
</ValidationRule>
