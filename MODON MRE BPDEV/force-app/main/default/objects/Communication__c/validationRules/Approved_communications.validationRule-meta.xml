<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_communications</fullName>
    <active>true</active>
    <description>The Communication is already Approved</description>
    <errorConditionFormula>AND( NOT(ISNEW()), ISPICKVAL(Communication_Approval__c, &quot;Approved&quot;), NOT(ISCHANGED(Email_Sent__c)) )</errorConditionFormula>
    <errorMessage>The Communication is already Approved you can&apos;t Update it</errorMessage>
</ValidationRule>
