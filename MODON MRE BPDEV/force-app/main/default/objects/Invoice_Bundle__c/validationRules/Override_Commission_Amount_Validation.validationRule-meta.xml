<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Override_Commission_Amount_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Override_Payout_Amount__c &gt; 0, AND(Override_Payout_Amount__c  &gt;  Actual_Total_Commission_Payout_Now__c ))</errorConditionFormula>
    <errorMessage>You Cannot override more amount than the actual commission amount!</errorMessage>
</ValidationRule>
