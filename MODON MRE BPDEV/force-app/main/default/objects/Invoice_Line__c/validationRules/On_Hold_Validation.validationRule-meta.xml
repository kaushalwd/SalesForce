<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>On_Hold_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Is_Hold__c == true, Invoice_Bundle__r.Override_Payout_Amount__c &gt; 0)</errorConditionFormula>
    <errorMessage>You cannot place a hold on a commission that has already been overridden from the actual commission amount!</errorMessage>
</ValidationRule>
