<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>User_cannot_change_the_receipt_amount</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(ISNEW()) &amp;&amp; ISCHANGED( TotalAmount__c )</errorConditionFormula>
    <errorDisplayField>TotalAmount__c</errorDisplayField>
    <errorMessage>Receipt amount cannot be changed.</errorMessage>
</ValidationRule>
