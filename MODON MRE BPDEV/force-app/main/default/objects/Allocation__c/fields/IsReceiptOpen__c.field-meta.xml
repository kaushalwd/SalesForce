<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsReceiptOpen__c</fullName>
    <description>A field to check whether the related receipt is opened or not</description>
    <formula>ISPICKVAL( Receipt__r.Status__c, &apos;In Progress&apos; )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Receipt Open?</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
