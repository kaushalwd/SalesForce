<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsReceiptCancelled__c</fullName>
    <description>A field to check whether the related Receipt is cancelled or not</description>
    <formula>OR(
  ISPICKVAL(Receipt__r.Status__c, &apos;Rejected&apos;),
  ISPICKVAL(Receipt__r.Status__c, &apos;Cancelled&apos;),
  ISPICKVAL(Receipt__r.Status__c, &apos;Bounced&apos;),
  ISPICKVAL(Receipt__r.Status__c, &apos;Returned&apos;)  
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Receipt Cancelled?</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
