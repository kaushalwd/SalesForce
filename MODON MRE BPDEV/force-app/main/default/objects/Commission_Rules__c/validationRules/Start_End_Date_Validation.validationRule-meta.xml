<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_End_Date_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>OR(StartDate__c &gt; TODAY(), EndDate__c &lt; TODAY())</errorConditionFormula>
    <errorMessage>Start Date Should be in Past or Equal Today &amp; End Date Should be Greater than or equal today date!</errorMessage>
</ValidationRule>
