<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Freeze_Approved_Offers</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISCHANGED( LastModifiedDate ), ISPICKVAL(Approval_Status__c,&apos;Approved&apos;), NOT($Permission.OfferModifyPermission ))</errorConditionFormula>
    <errorMessage>Cannot modify the approved offers in the system!</errorMessage>
</ValidationRule>
