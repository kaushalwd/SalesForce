<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passport_Expir_Date_Should_not_be_Past</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED( PassportExpiryDate__c ), NOT(ISBLANK (PassportExpiryDate__c)), PassportExpiryDate__c &lt; TODAY() )</errorConditionFormula>
    <errorDisplayField>PassportExpiryDate__c</errorDisplayField>
    <errorMessage>Passport Expiry Date cannot be a Past Date</errorMessage>
</ValidationRule>
