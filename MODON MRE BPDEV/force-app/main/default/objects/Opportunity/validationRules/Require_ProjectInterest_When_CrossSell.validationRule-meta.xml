<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_ProjectInterest_When_CrossSell</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Loss_Reason__c, &quot;Lost-Cross Sell&quot;),
    ISPICKVAL(ProjectInterest__c, &quot;&quot;)
)</errorConditionFormula>
    <errorMessage>Please specify Project Interested when Loss Reason is Lost-Cross Sell.</errorMessage>
</ValidationRule>
