<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Freeze_Approved_Offers_Lines</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED( LastModifiedDate ), NOT(ISPICKVAL(Offer_Line_Approval_Status__c,&apos;Not Submitted&apos;)))</errorConditionFormula>
