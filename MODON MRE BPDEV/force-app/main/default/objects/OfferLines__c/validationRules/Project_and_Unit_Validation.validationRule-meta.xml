<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Project_and_Unit_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Unit__c)),Phase__r.Project__c &lt;&gt; Unit__c)</errorConditionFormula>
    <errorDisplayField>Unit__c</errorDisplayField>
    <errorMessage>Project and Unit not matching..!</errorMessage>
</ValidationRule>
