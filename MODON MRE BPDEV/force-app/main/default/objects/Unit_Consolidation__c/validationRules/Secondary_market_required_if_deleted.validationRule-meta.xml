<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Secondary_market_required_if_deleted</fullName>
    <active>true</active>
    <errorConditionFormula>AND( IsConsolidated__c ,  OR(Secondary_Market_Value__c =0, Secondary_Market_Value__c =null))</errorConditionFormula>
    <errorDisplayField>Secondary_Market_Value__c</errorDisplayField>
    <errorMessage>Secondary Market Value is Mandatory for Cancelled Unit</errorMessage>
</ValidationRule>
