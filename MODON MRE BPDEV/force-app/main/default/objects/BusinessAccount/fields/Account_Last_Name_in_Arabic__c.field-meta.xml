<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Last_Name_in_Arabic__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    CONTAINS(TRIM(Account_Name_in_Arabic__c), &quot; &quot;),
    TRIM(
        RIGHT(
            SUBSTITUTE(TRIM(Account_Name_in_Arabic__c), &quot; &quot;, LPAD(&quot; &quot;, 100)),
