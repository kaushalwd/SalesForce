<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Refund_Payment_Has_Zero_Remaining_Amount</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISNEW(),
  Payment__r.RemainingAmount__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Selected payment&apos;s remaining amount is not sufficient. Select another payment.</errorMessage>
</ValidationRule>
