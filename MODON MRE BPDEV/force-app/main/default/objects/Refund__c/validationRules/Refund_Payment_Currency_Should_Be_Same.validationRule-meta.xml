<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Refund_Payment_Currency_Should_Be_Same</fullName>
    <active>true</active>
    <errorConditionFormula>TEXT(CurrencyIsoCode)  &lt;&gt;  TEXT(Payment__r.CurrencyIsoCode)</errorConditionFormula>
    <errorMessage>Refund currency should be same as Payment currency.</errorMessage>
</ValidationRule>
