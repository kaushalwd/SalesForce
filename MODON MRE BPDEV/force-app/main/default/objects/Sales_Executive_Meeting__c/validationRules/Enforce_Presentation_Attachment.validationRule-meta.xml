<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enforce_Presentation_Attachment</fullName>
    <active>true</active>
    <description>Enforces that a presentation file is attached when the Includes Presentation checkbox is checked.</description>
    <errorConditionFormula>AND(Includes_Presentation__c = true, BLANKVALUE(Presentation_Files_Count__c, 0) &lt;= 0)</errorConditionFormula>
    <errorMessage>Please attach the presentation first.</errorMessage>
</ValidationRule>
