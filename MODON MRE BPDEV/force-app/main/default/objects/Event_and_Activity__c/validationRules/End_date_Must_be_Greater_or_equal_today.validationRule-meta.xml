<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_date_Must_be_Greater_or_equal_today</fullName>
    <active>true</active>
    <description>End Date Must be Greater or Equal to today</description>
    <errorConditionFormula>End_Date_and_Time__c &lt; NOW()</errorConditionFormula>
    <errorDisplayField>End_Date_and_Time__c</errorDisplayField>
    <errorMessage>End Date &amp; Time must be today or a future date.</errorMessage>
</ValidationRule>
