<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Validation</fullName>
    <active>false</active>
    <description>The Phone Number should be in +971xxxxxxxxx format.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Mobile__c)),
    NOT(
        REGEX(
            Mobile__c,
            &quot;^(\\+971[0-9]{9}|[0-9]{9})$&quot;
        )
    )
)</errorConditionFormula>
    <errorDisplayField>Mobile__c</errorDisplayField>
    <errorMessage>The Phone Format Should be +971xxxxxxxxx or xxxxxxxxx And No Alphabets Included</errorMessage>
</ValidationRule>
