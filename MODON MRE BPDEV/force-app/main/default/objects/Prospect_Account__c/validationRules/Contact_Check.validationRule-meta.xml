<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name == &apos;Individual Acc / Contact&apos;,  Prospect_Account__c == null,!IsPersonAccount__c )</errorConditionFormula>
    <errorDisplayField>Prospect_Account__c</errorDisplayField>
    <errorMessage>Please Select Parent Prospect if this Contact or check IsPersonAccount field</errorMessage>
</ValidationRule>
