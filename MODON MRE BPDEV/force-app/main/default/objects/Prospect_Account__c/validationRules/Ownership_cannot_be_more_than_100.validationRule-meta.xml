<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ownership_cannot_be_more_than_100</fullName>
    <active>true</active>
    <errorConditionFormula>IF(OwnershipPercentage__c &gt; 100.00, true, false)</errorConditionFormula>
    <errorDisplayField>OwnershipPercentage__c</errorDisplayField>
    <errorMessage>Ownership% cannot exceed 100</errorMessage>
</ValidationRule>
