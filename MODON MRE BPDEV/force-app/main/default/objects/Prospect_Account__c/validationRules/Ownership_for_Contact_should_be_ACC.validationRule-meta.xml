<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ownership_for_Contact_should_be_ACC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name == &quot;Contact&quot;,  OwnershipPercentage__c != null)</errorConditionFormula>
    <errorDisplayField>OwnershipPercentage__c</errorDisplayField>
    <errorMessage>Ownership % for Contact needs to be added on Parent Prospect Account</errorMessage>
</ValidationRule>
