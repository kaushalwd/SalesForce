<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Egyptian_ID_Format_Check</fullName>
    <active>true</active>
    <description>Modon-Egypt  Egyptian ID must be in a valid format (14 digit number).</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Source_Entity__c, &quot;Modon - Egypt&quot;),
    NOT(ISBLANK(Egyptian_ID__c)), 
    NOT(REGEX(Egyptian_ID__c, &quot;^[0-9]{14}$&quot;))
)</errorConditionFormula>
    <errorDisplayField>Egyptian_ID__c</errorDisplayField>
    <errorMessage>Egyptian ID must be in a valid format (14 digit number).</errorMessage>
</ValidationRule>
