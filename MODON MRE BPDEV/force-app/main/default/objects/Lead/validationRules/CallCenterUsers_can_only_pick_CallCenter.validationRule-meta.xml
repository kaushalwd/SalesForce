<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CallCenterUsers_can_only_pick_CallCenter</fullName>
    <active>true</active>
    <description>Call Center Users can only pick Call Center as a Lead Source when creating a new one.</description>
    <errorConditionFormula>CONTAINS($UserRole.DeveloperName, &apos;Call_Center&apos;)  &amp;&amp;  (TEXT(LeadSource)  &lt;&gt; &apos;Call Center&apos; &amp;&amp; TEXT(LeadSource)  &lt;&gt; &apos;800-Modon&apos;) &amp;&amp; ISNEW() &amp;&amp; NOT(CONTAINS($UserRole.DeveloperName, &apos;Egypt&apos;))</errorConditionFormula>
    <errorDisplayField>LeadSource</errorDisplayField>
    <errorMessage>Lead Source must be selected as &apos;800-Modon&apos; for Call Center users</errorMessage>
</ValidationRule>
