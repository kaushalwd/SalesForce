<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Retired_lead_cannot_be_updated</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(PRIORVALUE(Status), &apos;Retired&apos;))</errorConditionFormula>
    <errorMessage>You cannot update a retired lead.</errorMessage>
</ValidationRule>
