<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passport_Number_Format_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK( En_PassportNumber__c )),
  NOT(REGEX(En_PassportNumber__c , &quot;^[a-zA-Z0-9]+$&quot;))
)</errorConditionFormula>
    <errorDisplayField>En_PassportNumber__c</errorDisplayField>
    <errorMessage>Passport number must be in a valid format</errorMessage>
</ValidationRule>
