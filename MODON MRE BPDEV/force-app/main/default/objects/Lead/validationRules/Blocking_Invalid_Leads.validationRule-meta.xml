<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blocking_Invalid_Leads</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(LastName),ISBLANK( En_Email__c ),ISBLANK(  En_MobilePhone__c ), CreatedBy.CommunityNickname =&apos;AdminM&apos; )</errorConditionFormula>
    <errorMessage>Leads without phone number and email can not be created/ updated.</errorMessage>
</ValidationRule>
