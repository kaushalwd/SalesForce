<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Refferal_Type_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(LeadSource,&apos;Management Lead&apos;),OR(ISBLANK( TEXT(Referral_Type__c)),ISBLANK(TEXT(Unit_Allocated_Status__c))))</errorConditionFormula>
    <errorMessage>Referral Type and Unit Allocation Status should not be empty!</errorMessage>
</ValidationRule>
