<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Previous_Status_is_Retired_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>IF(PRIORVALUE(Status) == &quot;Retired&quot; , TRUE, FALSE)</errorConditionFormula>
    <errorMessage>Previous Lead status is &quot;Retired&quot;, Cannot update Lead.</errorMessage>
</ValidationRule>
