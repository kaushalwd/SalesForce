<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Manual_Lead_Conversion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    TEXT(Status) = &quot;Converted&quot;,
    NOT(IsConverted)
)</errorConditionFormula>
    <errorMessage>Leads cannot be manually converted via the status path. Please use the dedicated &apos;Convert Lead&apos; button.</errorMessage>
</ValidationRule>
