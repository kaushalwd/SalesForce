<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Portal_User_Status_Should_be_New</fullName>
    <active>true</active>
    <errorConditionFormula>CONTAINS( $Profile.Name , &apos;Partner Community User&apos;)  &amp;&amp;  TEXT(Status)  &lt;&gt; &apos;New&apos; &amp;&amp;  ISNEW()</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>Lead Status must be selected as &apos;New&apos; for new lead.</errorMessage>
</ValidationRule>
