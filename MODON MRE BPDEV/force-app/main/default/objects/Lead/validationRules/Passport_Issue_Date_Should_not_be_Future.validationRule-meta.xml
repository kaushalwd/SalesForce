<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passport_Issue_Date_Should_not_be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK (PassportIssueDate__c)), PassportIssueDate__c  &gt;  TODAY() )</errorConditionFormula>
    <errorDisplayField>PassportIssueDate__c</errorDisplayField>
    <errorMessage>Passport Issue Date cannot be a Future Date</errorMessage>
</ValidationRule>
