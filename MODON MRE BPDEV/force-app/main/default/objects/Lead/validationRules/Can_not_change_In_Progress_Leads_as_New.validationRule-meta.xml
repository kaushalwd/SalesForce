<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Can_not_change_In_Progress_Leads_as_New</fullName>
    <active>false</active>
    <errorConditionFormula>TEXT(PRIORVALUE(Status))==&quot;In Progress&quot; &amp;&amp; TEXT(Status)==&quot;New&quot;</errorConditionFormula>
    <errorMessage>Can not change the status from In Progress to New</errorMessage>
</ValidationRule>
