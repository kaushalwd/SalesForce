<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Associate_cannot_change_dates</fullName>
    <active>false</active>
    <errorConditionFormula>(CONTAINS($UserRole.DeveloperName, &apos;Sales_Associate&apos;) || CONTAINS($UserRole.DeveloperName, &apos;Sales_Manager&apos;) || CONTAINS($UserRole.DeveloperName, &apos;Sales_Director&apos;)) &amp;&amp;
NOT(ISNEW()) &amp;&amp;

((ISCHANGED(PassportIssueDate__c) &amp;&amp; NOT(ISBLANK(PRIORVALUE(PassportIssueDate__c)))))</errorConditionFormula>
    <errorMessage>Sales associate team is not allowed to change the passport issue date</errorMessage>
</ValidationRule>
