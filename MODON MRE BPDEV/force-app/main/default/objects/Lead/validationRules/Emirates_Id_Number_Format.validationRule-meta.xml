<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Emirates_Id_Number_Format</fullName>
    <active>true</active>
    <description>To check the format validity of Emirates Id.</description>
    <errorConditionFormula>NOT(ISBLANK(En_EIDNumber__c)) 
&amp;&amp;
NOT(REGEX(En_EIDNumber__c, &quot;^(784)-[0-9]{4}-[0-9]{7}-[0-9]{1}$&quot;))</errorConditionFormula>
    <errorDisplayField>En_EIDNumber__c</errorDisplayField>
    <errorMessage>Emirates Id Number should be in the format: 784-xxxx-xxxxxxx-x</errorMessage>
</ValidationRule>
