<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TradeLicenseNumber_Cannot_be_masked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISCHANGED(TradeLicenseNumber__c),
 CONTAINS(TradeLicenseNumber__c, &apos;*&apos;)  
)</errorConditionFormula>
    <errorMessage>Please do not enter masked values in Trade License Number</errorMessage>
</ValidationRule>
