<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UAEVATRegisterNumber_Cannot_be_masked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISCHANGED(UAEVATRegisterNumber__c),
 CONTAINS(UAEVATRegisterNumber__c, &apos;*&apos;)  
)</errorConditionFormula>
    <errorMessage>Please do not enter masked values in UAE VAT Register Number</errorMessage>
</ValidationRule>
