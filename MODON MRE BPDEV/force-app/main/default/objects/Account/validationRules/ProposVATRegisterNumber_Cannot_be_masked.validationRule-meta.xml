<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ProposVATRegisterNumber_Cannot_be_masked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISCHANGED(Proposed_VAT_Registration_Number__c),
 CONTAINS(Proposed_VAT_Registration_Number__c, &apos;*&apos;)  
)</errorConditionFormula>
    <errorMessage>Please do not enter masked values in Proposed VAT Registration Number</errorMessage>
</ValidationRule>
