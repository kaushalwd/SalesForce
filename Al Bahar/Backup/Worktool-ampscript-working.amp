  ELSE
    SET @bannerImage = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/9d38cc4d-f643-4f47-bcd1-8efda2db0327.jpg"
  ENDIF    
ELSEIF @ModelGroup == 10 Then
    SET @WorkToolImage = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/446e81ec-bbf7-4dc9-9daa-32fabb50d4f7.jpeg"
  IF @OppCountry == "OMAN" Then
