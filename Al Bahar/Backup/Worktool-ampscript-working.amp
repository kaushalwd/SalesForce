  ENDIF
ELSEIF @ModelGroup == 12 Then
    SET @WorkToolImage = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/6e937f6e-da6b-41e0-9630-ca1e15516fc9.jpeg"
