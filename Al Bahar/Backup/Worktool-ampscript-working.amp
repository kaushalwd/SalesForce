ELSEIF @ModelGroup == 11 Then
    SET @WorkToolImage = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/cdfab722-3366-4557-8cad-3a1cb0eeb739.jpeg"
  IF @OppCountry == "OMAN" Then
    SET @bannerImage = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/ed1aa75e-10c0-4a6a-ab23-40d629174e23.jpg"
