%%[

   SET @OppId = AttributeValue("Opportunity:Id")
   SET @OppType = AttributeValue("Opportunity:Type")
   SET @OppDate = AttributeValue("OppProduct:SRC_Date__c")
   SET @AccName = Uppercase(AttributeValue("Account:Name"))
   SET @AccAddress = Uppercase(AttributeValue("Account:BillingAddress"))
   SET @OppCountry = AttributeValue("Contact:Country")
   SET @AccFName = AttributeValue("Contact:FirstName")
   SET @AccLName = AttributeValue("Contact:LastName")
   SET @AccCustName = "Customer"
   SET @CustomerStore = AttributeValue("Opportunity:Customer_Store__c")
   SET @OppCountry = UpperCase(Lookup("StoreLocationMapping", "Country", "StoreNumber", @CustomerStore))
   
   SET @regEx = "^[A-Za-z\s]+$"
    SET @regExMatchFName = RegExMatch(@AccFName, @regEx, 0, "IgnoreCase")
    SET @regExMatchLName = RegExMatch(@AccLName, @regEx, 0, "IgnoreCase")

    IF (@AccFName == "" And @AccLName == "") Or (@AccFName == "NA" And @AccLName == "NA") Or (IsEmailAddress(@AccFName) == 'True' And IsEmailAddress(@AccLName) == 'True') Or (@regExMatchFName  == '' And @regExMatchLName  == '') Then
       SET @AccCustName = "Customer"
    ELSEIF (ProperCase(@AccFName) == ProperCase(@AccLName)) Then
       SET @AccCustName = ProperCase(@AccFName)   
    ELSE
         IF @AccFName != "" Or @AccLName != "" Then
           IF (IsEmailAddress(@AccFName) == 'False' And @regExMatchFName != '') And (IsEmailAddress(@AccLName) == 'False' And @regExMatchLName != '') And (Uppercase(@AccFName) != "NA" And Uppercase(@AccLName) != "NA") And @AccFName != "" Then
              SET @AccCustName = Concat(ProperCase(@AccFName), " ", ProperCase(@AccLName))
           ELSEIF @AccFName != "" And (IsEmailAddress(@AccFName) == 'False' And @regExMatchFName != '' And Uppercase(@AccFName) != "NA") Then
              SET @AccCustName = ProperCase(@AccFName)
           ENDIF
        ENDIF  
    ENDIF  
 
   IF @OppCountry == "OMAN" Then
    SET @companyName = "OASIS TRADING & EQUIPMENT CO. L.L.C"
    SET @companyLogo = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/32dbd4ba-24fd-4c97-a9b4-de5d5cbd8303.jpg"
   ELSE
    SET @companyName = "MOHAMED ABDULRAHMAN AL-BAHAR"
    SET @companyLogo = "https://image.mkt.albahar.com/lib/fe2f11737364047b7c1770/m/1/b027d73b-0882-4aef-814b-a2bc4737a3b9.jpg"
   ENDIF   
   
   SET @ItemModels = AttributeValue("OppProduct:Model")
   SET @ItemModelsRows = BuildRowsetFromString(@ItemModels, ",")
   
   SET @ItemQty = AttributeValue("OppProduct:Quantity")
   SET @ItemQtyRows = BuildRowsetFromString(@ItemQty, ",")
   
   SET @ItemRowCount = RowCount(@ItemModelsRows)
   
   /*FOR @i=1 to @ItemRowCount Do
       SET @ItemModelRow = Row(@ItemModelsRows, @i)
       SET @ItemQtyRow = Row(@ItemQtyRows, @i)
       SET @ItemModel = Field(@ItemModelRow, 1)
       SET @ItemQty = Field(@ItemQtyRow, 1)
   Next @i
   */
   
   
   
   SET @OwnerId = AttributeValue("Opportunity:OwnerId")
   SET @OwnerEmail = AttributeValue("Opportunity:Owner_Email__c")
   
   
   SET @SalesEngrName = ProperCase(Lookup("Test_Master_Users", "Name", "Id", @OwnerId, "IsActive", "True"))
   SET @SalesEngrPhone = Lookup("Test_Master_Users", "MobilePhone", "Id", @OwnerId, "IsActive", "True")
   
   IF Length(@SalesEngrPhone) == 0 Then
    SET @SalesEngrPhone = "..."
   ENDIF 
   
   SET @SalesMngrName = ProperCase(AttributeValue("Opportunity:Sales_Manager_Name__c"))
   SET @SalesMngrEmail =  ProperCase(AttributeValue("Opportunity:Sales_Manager_E_mail__c"))
   SET @SalesMngrPhone = Lookup("Test_Master_Users", "MobilePhone", "Email", @SalesMngrEmail, "IsActive", "True")
   
   IF (@SalesMngrPhone == "" OR Length(@SalesMngrPhone) == 0) Then
    SET @SalesMngrPhone = "..."
   ENDIF 
   
   IF (@SalesMngrName == "") Then
     SET @SalesMngrName = ProperCase(Lookup("Test_Master_Users", "Name", "IsActive", "True", "UserType2__c", "Sales Manager", "Opportunity_Type__c", @OppType))
   ENDIF  
   

    SET @ProductMngrName = ""
    SET @ProductMngrPhone = ""
    SET @PartsMngrName = ""
    SET @PartsMngrPhone = ""

    SET @SPMngr = LookupRows("Test_Master_Users", "Sales_Man_Type__c", "9", "IsActive", "True")
    //Output(Concat("  Opp = ", @OppType))
    //Output(Concat("  CustomerStore = ", @CustomerStore))
    //Output(RowCount(@SPMngr))
    IF RowCount(@SPMngr) > 0 THEN
        FOR @ij = 1 TO RowCount(@SPMngr) DO
            SET @row_sp_mngr = Row(@SPMngr, @ij)    
            SET @UserType = Field(@row_sp_mngr, "UserType2__c")
            SET @UserOppType = Field(@row_sp_mngr, "Opportunity_Type__c")
            SET @UserCNumber = Field(@row_sp_mngr, "Customer_Store_Conversion__c")
            IF IndexOf(@UserOppType, @OppType) > 0 And IndexOf(@UserCNumber, @CustomerStore) > 0 Then
                IF IndexOf(@UserType, "Product Support Marketing Manager") > 0 Then
                    SET @ProductMngrName = Field(@row_sp_mngr, "Name")
                    SET @ProductMngrPhone = Field(@row_sp_mngr, "MobilePhone")
                    //Output(Concat("  PSM = ", @ProductMngrName))
                ENDIF   
                IF IndexOf(@UserType, "Parts Manager") > 0 Then
                    SET @PartsMngrName = Field(@row_sp_mngr, "Name")
                    SET @PartsMngrPhone = Field(@row_sp_mngr, "MobilePhone")
                    //Output(Concat("  PM = ", @PartsMngrName))
                ENDIF   
            ENDIF
        NEXT @ij
    ENDIF

   IF Length(@ProductMngrPhone) == 0 Then
    SET @ProductMngrPhone = "..."
   ENDIF
   
   If Length(@PartsMngrPhone) == 0 Then
    SET @PartsMngrPhone = "..."
   ENDIF 
   ]%%